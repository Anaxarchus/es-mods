class Flotilla

// One flotilla or raid, loaded from and saved to its slot's conditions,
// "diplomacy: flotilla <side>.<slot> <field>":
//   strength   points left; 0 = the slot is empty
//   size       1 small, 2 medium, 3 large
//   kind       0 a war flotilla, 1 a relief flotilla hunting a raid, 2 a pirate
//              raid, 3 going home to disband (a relief done, or a cautious retreat)
//   admiral    its commander: their slot in the side's roster (1..), or 0
//   full       its strength when it set out
//   at         the system it is in (index + 1)
//   goal       a war flotilla's objective, or where it is going (index + 1)
//   home       where it set out from, and goes back to (index + 1)
//   target     the flotilla it is chasing (side * 10 + slot), or 0
//   siege      days it has besieged its goal
//   launched   the day it set out
//   stop 1..3  a raid's stops (index + 1; 0 = none)
//   leg        the stop a raid is bound for or at (1..3; past the last, it goes home)
//   dwell      days a raid has stayed at its stop, and plan: days it means to stay
//   alerted    the factions a raid has alerted (bit f), so each answers once

import "imports:sdk/es"

int faction = 0
int slot = 0
int strength = 0
int size = 0
int kind = 0
int admiral = 0
int full = 0
int at = -1
int goal = -1
int home = -1
int target = 0
int siege = 0
int launched = 0
[]int stops = [-1, -1, -1]
int leg = 0
int dwell = 0
int plan = 0
int alerted = 0

void init(int f, int s):
    faction = f
    slot = s

string key(string field):
    return "diplomacy: flotilla " + string(faction) + "." + string(slot) + " " + field

// This flotilla's code, as another flotilla's `target` names it.
int code():
    return faction * 10 + slot

bool alive():
    return strength > 0

bool is_raid():
    return kind == 2

bool is_relief():
    return kind == 1

bool going_home():
    return kind == 3

// The raid's stops, in order (fewer than three when the route is short).
[]int route():
    []int out = []
    for s in stops:
        if s >= 0:
            out.append(s)
    return out

// The tag its ships carry in flight.
string tag():
    return "diplomacy:" + string(faction) + ":f" + string(slot)

void load(es.Game game):
    strength = game.condition(key("strength"))
    size = game.condition(key("size"))
    kind = game.condition(key("kind"))
    admiral = game.condition(key("admiral"))
    full = game.condition(key("full"))
    at = game.condition(key("at")) - 1
    goal = game.condition(key("goal")) - 1
    home = game.condition(key("home")) - 1
    target = game.condition(key("target"))
    siege = game.condition(key("siege"))
    launched = game.condition(key("launched"))
    stops = [game.condition(key("stop 1")) - 1, game.condition(key("stop 2")) - 1, game.condition(key("stop 3")) - 1]
    leg = game.condition(key("leg"))
    dwell = game.condition(key("dwell"))
    plan = game.condition(key("plan"))
    alerted = game.condition(key("alerted"))
    if strength < 0:
        strength = 0
    if full < strength:
        full = strength

void save(es.Game game):
    if strength <= 0:
        clear(game)
        return
    game.set_condition(key("strength"), strength)
    game.set_condition(key("size"), size)
    game.set_condition(key("kind"), kind)
    game.set_condition(key("admiral"), admiral)
    game.set_condition(key("full"), full)
    game.set_condition(key("at"), at + 1)
    game.set_condition(key("goal"), goal + 1)
    game.set_condition(key("home"), home + 1)
    game.set_condition(key("target"), target)
    game.set_condition(key("siege"), siege)
    game.set_condition(key("launched"), launched)
    for k in 0..<3:
        game.set_condition(key("stop " + string(k + 1)), stops[k] + 1)
    game.set_condition(key("leg"), leg)
    game.set_condition(key("dwell"), dwell)
    game.set_condition(key("plan"), plan)
    game.set_condition(key("alerted"), alerted)

// Empty the slot (the flotilla is destroyed, disbanded or home).
void clear(es.Game game):
    strength = 0
    kind = 0
    admiral = 0
    target = 0
    siege = 0
    stops = [-1, -1, -1]
    leg = 0
    dwell = 0
    plan = 0
    alerted = 0
    for field in ["strength", "size", "kind", "admiral", "full", "at", "goal", "home", "target", "siege", "launched", "stop 1", "stop 2", "stop 3", "leg", "dwell", "plan", "alerted"]:
        game.set_condition(key(field), 0)
