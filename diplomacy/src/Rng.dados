class Rng

import "imports:sdk/es"

// A small deterministic random number generator (Park-Miller, the "minimal
// standard" LCG). DadoScript has no random function, and keeping the state in
// the condition "diplomacy: rng" makes a pilot's wars reproducible and lets
// tests replay them.

int modulus = 2147483647
int multiplier = 48271

// Seed the generator from a day, unless it already has a state.
void seed(es.Game game, int day):
    if game.condition("diplomacy: rng") <= 0:
        int s = (day * 7919 + 12345) % modulus
        if s <= 0:
            s = 1
        game.set_condition("diplomacy: rng", s)

int next(es.Game game):
    int s = game.condition("diplomacy: rng")
    if s <= 0 || s >= modulus:
        s = 1
    s = s * multiplier % modulus
    game.set_condition("diplomacy: rng", s)
    return s

// An integer in [lo, hi].
int range(es.Game game, int lo, int hi):
    if hi <= lo:
        return lo
    return lo + next(game) % (hi - lo + 1)

// True with the given chance in percent.
bool chance(es.Game game, int percent):
    return range(game, 0, 99) < percent

// A factor in [lo%, hi%], as a float (75..125 gives 0.75..1.25).
float factor(es.Game game, int lo, int hi):
    return float(range(game, lo, hi)) / 100.0
