class Service

// The player's side of the diplomacy: the planet-screen "Faction" button and
// the faction panel, joining and leaving, merit, rank, salary, and the
// player's reputation with the flotilla governments.

import "imports:sdk/es"

Tuning tune = Tuning()
Factions factions = Factions()
Galaxy galaxy = Galaxy()
State state = State()
Garrisons garrisons = Garrisons()
Simulation sim = Simulation()

// What each button of the open panel does: "join", "leave" or "close".
[]string actions = []
// The faction whose panel is open.
int panel_faction = 0

void wire(Tuning t, Factions f, Galaxy g, State s, Garrisons gs, Simulation sm):
    tune = t
    factions = f
    galaxy = g
    state = s
    garrisons = gs
    sim = sm

// ---- Reputation, rank and salary ----

// A member is an ally of its faction's flotillas and an enemy of its enemies'
// flotillas. Also publishes "diplomacy: enemy", the faction the member's own
// is at war with (0 for none), which the faction jobs are offered by.
void apply_reputations(es.Game game):
    int m = state.member(game)
    update_enemy(game)
    for f in 1..=3:
        float rep = tune.rep_neutral
        if m != 0 && f == m:
            rep = tune.rep_own
        else if m != 0 && state.hostile(game, m, f):
            rep = tune.rep_enemy
        game.set_reputation(factions.flotilla_governments[f], rep)

void update_enemy(es.Game game):
    int m = state.member(game)
    int e = state.enemy_of(game, m) if m != 0 else 0
    if state.get(game, "enemy") != e:
        state.put(game, "enemy", e)

// Issue the licenses the member's rank has earned.
void grant_licenses(es.Game game):
    int m = state.member(game)
    if m == 0:
        return
    int r = rank(game)
    for k in 0..<factions.licenses.len():
        string key = "license: " + factions.licenses[k]
        if factions.license_faction[k] == m && r >= factions.license_rank[k] && game.condition(key) == 0:
            game.set_condition(key, 1)
            state.add(game, "stat licenses", 1)
            game.message(factions.titles[m] + " has issued you a " + factions.licenses[k] + " License, for your service as a " + factions.ranks[r] + ".")

int rank(es.Game game):
    int merit = state.merit(game)
    return factions.rank_of(merit if merit > 0 else 0)

int salary(es.Game game):
    if state.member(game) == 0:
        return 0
    int r = rank(game)
    if r >= tune.salaries.len():
        r = tune.salaries.len() - 1
    return tune.salaries[r]

// Endless Sky pays every "salary: ..." condition daily.
void update_salary(es.Game game):
    int m = state.member(game)
    for f in 1..=3:
        int want = salary(game) if f == m else 0
        string key = factions.salary_key(f)
        if game.condition(key) != want:
            game.set_condition(key, want)

// Record the rank merit earns, congratulating a member on a promotion.
void check_rank(es.Game game):
    int r = rank(game)
    int old = state.get(game, "rank")
    int m = state.member(game)
    if r != old:
        state.put(game, "rank", r)
        if m != 0 && r > old:
            game.message(factions.titles[m] + " has promoted you to " + factions.ranks[r] + ". Your salary is now " + string(salary(game)) + " credits a day.")
            state.add(game, "stat promotions", 1)
    update_salary(game)
    update_enemy(game)
    grant_licenses(game)

// Merit for the player's kills of tagged flotilla, garrison and raider ships.
void poll_kills(es.Game game):
    int m = state.member(game)
    bool changed = false
    int pk = game.player_kills(factions.tag_prefix(factions.pirates()))
    if pk > 0 && m != 0:
        state.add(game, "merit", pk * tune.merit_per_pirate_kill)
        state.add(game, "stat pirate kills", pk)
        changed = true
    for f in 1..=3:
        int k = game.player_kills(factions.tag_prefix(f))
        if k <= 0 || m == 0:
            continue
        if state.hostile(game, m, f):
            state.add(game, "merit", k * tune.merit_per_kill)
            state.add(game, "stat kills", k)
            changed = true
        else if f == m:
            state.add(game, "merit", -k * tune.merit_per_friendly_kill)
            changed = true
    if changed:
        check_rank(game)

// ---- Joining and leaving ----

void join(es.Game game, int f):
    join_at(game, f, 0)

// Join faction f at rank r (a campaign veteran joins the Free Worlds as a Commodore).
void join_at(es.Game game, int f, int r):
    if state.member(game) != 0:
        return
    state.put(game, "member", f)
    state.put(game, "merit", factions.rank_merit[r])
    state.put(game, "rank", r)
    apply_reputations(game)
    update_salary(game)
    game.message("You have joined " + factions.names[f] + " as a " + factions.ranks[r] + ".")
    grant_licenses(game)

void leave(es.Game game):
    int m = state.member(game)
    if m == 0:
        return
    state.put(game, "member", 0)
    state.put(game, "merit", 0)
    state.put(game, "rank", 0)
    apply_reputations(game)
    update_salary(game)
    game.message("You have left " + factions.names[m] + ".")

// ---- The planet button and the panel ----

// The faction that owns the system the player is in, or 0.
int faction_here(es.Game game):
    int i = galaxy.find(game.here())
    if i < 0:
        return 0
    return galaxy.owner(game, i)

void update_button(es.Game game, bool active):
    if active && faction_here(game) != 0:
        game.planet_button("Faction")
    else if offering:
        game.planet_button("Diplomacy")
    else:
        game.planet_button("")

// ---- Turning Diplomacy on ----

// Set by the mod while a pilot who finished the Free Worlds campaign has not
// yet chosen whether to turn Diplomacy on.
bool offering = false

void open_offer(es.Game game):
    actions = []
    game.panel_open("Diplomacy", "The Free Worlds campaign is over, and the Diplomacy plugin can take the story on from here: the Republic, the Free Worlds and the Syndicate will now and then go to war over their borders, pirates will raid the settled worlds, and named admirals will lead the fleets.\nIf you turn it on, you serve the Free Worlds as a " + factions.ranks[tune.veteran_rank] + ", the rank your part in the war earned, with the same salary of " + string(tune.salaries[tune.veteran_rank]) + " credits a day. You can leave them at any time from the Faction button.\nNot now asks again the next time you land; Never turns the plugin off for this pilot.")
    add_button(game, "Turn on Diplomacy", "activate")
    add_button(game, "Not now", "snooze")
    add_button(game, "Never", "never")

void open_panel(es.Game game):
    int f = faction_here(game)
    panel_faction = f
    actions = []
    if f == 0:
        game.panel_open("Diplomacy", "No faction holds this system.")
        add_button(game, "Close", "close")
        return
    game.panel_open(factions.titles[f], status(game, f))
    int m = state.member(game)
    if m == f:
        add_button(game, "Leave", "leave")
    else if m == 0:
        add_button(game, "Join", "join")
    add_button(game, "Close", "close")

void add_button(es.Game game, string label, string action):
    game.panel_button(label)
    actions.append(action)

// Answers the action of an offer button ("activate", "snooze", "never") for
// the mod to carry out, or "" when the panel handled the click itself.
string on_panel(es.Game game, int button):
    if button < 0 || button >= actions.len():
        game.panel_close()
        return ""
    string action = actions[button]
    if action == "activate" || action == "snooze" || action == "never":
        return action
    if action == "join":
        join(game, panel_faction)
        open_panel(game)
    else if action == "leave":
        leave(game)
        open_panel(game)
    else:
        game.panel_close()
    return ""

// The faction's status, for its panel.
string status(es.Game game, int f):
    int held = 0
    int gained = 0
    int lost = 0
    for i in 0..<galaxy.count():
        int o = galaxy.owner(game, i)
        int orig = state.origin(game, i)
        if o == f:
            held += 1
            if orig != 0 && orig != f:
                gained += 1
        else if orig == f:
            lost += 1
    string text = "Capital: " + factions.capitals[f] + ". " + factions.titles[f] + " holds " + string(held) + " systems"
    if gained > 0:
        text = text + ", " + string(gained) + " of them taken from its rivals"
    text = text + "."
    if lost > 0:
        text = text + " It has lost " + string(lost) + " of its own systems."
    // The game's text wrapper spaces paragraphs itself: one newline between each.
    int e = state.enemy_of(game, f)
    if e != 0:
        int days = game.day() - state.get(game, "war since")
        text = text + "\nAt war with " + factions.names[e] + " (day " + string(days + 1) + " of the war)."
    else if state.at_war(game):
        text = text + "\nAt peace, while " + factions.names[state.war_a(game)] + " and " + factions.names[state.war_b(game)] + " are at war."
    else:
        text = text + "\nAt peace."
    int n = 0
    []Flotilla fl = sim.load_all(game)
    for x in fl:
        if x.alive() && x.faction == f:
            n += 1
            text = text + "\n" + describe(game, x, fl)
    if n == 0 && e != 0:
        text = text + "\nNo flotillas are deployed."
    // Pirate raids in or bound for its space.
    for x in fl:
        if !x.alive() || x.faction != factions.pirates():
            continue
        []int route = x.route()
        if x.leg >= 1 && x.leg <= route.len() && galaxy.owner(game, route[x.leg - 1]) == f:
            string where = galaxy.name(route[x.leg - 1])
            string doing = " are raiding " + where if x.at == route[x.leg - 1] else " are bound for " + where
            text = text + "\nPirates under " + sim.led_by(game, x) + " (" + factions.sizes[x.size] + ")" + doing + "."
    text = text + "\n" + standing(game, f)
    return text

// One flotilla, for the panel.
string describe(es.Game game, Flotilla x, []Flotilla fl):
    string text = sim.led_by(game, x) + "'s " + factions.sizes[x.size] + " flotilla (strength " + string(x.strength) + ", " + admirals_line(game, x) + ") at " + galaxy.name(x.at)
    if x.kind == 3:
        return text + ", going home."
    if x.kind == 1:
        Flotilla y = sim.by_code(fl, x.target)
        if y.alive():
            return text + ", hunting the pirates under " + sim.led_by(game, y) + " at " + galaxy.name(y.at) + "."
        return text + ", going home."
    if x.target != 0:
        Flotilla y = sim.by_code(fl, x.target)
        if y.alive():
            return text + ", intercepting a " + factions.adjectives[y.faction] + " flotilla at " + galaxy.name(y.at) + "."
    if sim.besieging(game, x):
        int full = galaxy.full_garrison(game, x.goal)
        int hp = garrisons.hp(game, x.goal, full)
        return text + ", besieging it (" + string(100 - hp * 100 / full) + "% done)."
    if x.at == x.goal:
        return text + ", holding it."
    return text + ", bound for " + galaxy.name(x.goal) + "."

// The licenses faction f issues by rank, for its panel: the next one a member earns.
string licensing(es.Game game, int f, int r):
    for k in 0..<factions.licenses.len():
        if factions.license_faction[k] == f && factions.license_rank[k] > r:
            return " At " + factions.ranks[factions.license_rank[k]] + " you will be issued a " + factions.licenses[k] + " License."
    return ""

// "bold, 3 victories", for the panel.
string admirals_line(es.Game game, Flotilla x):
    if x.admiral == 0:
        return "no commander"
    int w = sim.admirals.wins(game, x.faction, x.admiral)
    return sim.admirals.personality_name(game, x.faction, x.admiral) + ", " + string(w) + (" victory" if w == 1 else " victories")

string standing(es.Game game, int f):
    int m = state.member(game)
    if m == f:
        int r = rank(game)
        string text = "You serve " + factions.names[f] + " as a " + factions.ranks[r] + ". Merit: " + string(state.merit(game))
        int next = factions.next_rank_merit(r)
        if next >= 0:
            text = text + " (" + factions.ranks[r + 1] + " at " + string(next) + ")"
        text = text + ". Salary: " + string(salary(game)) + " credits a day." + licensing(game, f, r)
        return text + " Its flotillas count you as an ally, and its enemies' flotillas as an enemy."
    if m != 0:
        return "You serve " + factions.names[m] + ". To join " + factions.names[f] + ", leave " + factions.names[m] + " first."
    return "You are not a member. Members fight beside " + factions.names[f] + "'s flotillas and are enemies of its enemies' flotillas. They earn merit for every enemy ship they destroy and every faction mission they complete, and a salary that grows with their rank."
