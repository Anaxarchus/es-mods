    string data(string key):
        fail 70
    // (Mod API 6.) Keep `text` with the pilot under `key` ("" removes it). Up to 4 MB.
    void set_data(string key, string text):
        fail 70
    // (Mod API 6.) The true name of the planet the player is landed on, or "".
    string planet():
        fail 70
    // (Mod API 6.) A planet's display name, or "" for an unknown planet.
    string planet_name(string planet):
        fail 70
    // (Mod API 6.) The true name of the system a planet is in.
    string planet_system(string planet):
        fail 70
    // (Mod API 6.) The government a planet belongs to, by name.
    string planet_government(string planet):
        fail 70
    // (Mod API 6.) How many planets a system has.
    int planet_count(string system):
        fail 70
    // (Mod API 6.) The system's k-th planet's true name, 0 ..< planet_count(system).
    string planet_at(string system, int k):
        fail 70
    // (Mod API 6.) Whether the player may use a service on a planet now: "bank",
