class Exchange

// The exchange: a full screen of its own over the planet screen (mod API 7),
// like the outfitter. A table fills the left: the market, the player's
// portfolio, the contracts, or the news. The sidebar shows the chosen
// company, or a summary, with the buttons under it. A click on a heading sorts
// the market; buying and selling go through the game's number dialog.

import "imports:sdk/es"

int MARKET = 0
int PORTFOLIO = 1
int CONTRACTS = 2
int NEWS = 3
int MAP = 4
// (M2) A builder's Orders, only at its home planet (Orders.builder_at).
int ORDERS = 5
// (M3) The player's own company (Charter).
int COMPANY = 6
[]string tab_names = ["market", "portfolio", "contracts", "news", "map layers", "orders", "your company"]
// The news filter (a click on the News heading steps through them): every
// line, lines about companies the player holds, shipyards and hulls, the war
// and the military.
[]string filter_names = ["all", "yours", "shipyards", "war"]
int filter = 0
// A map layer was switched: the mod redraws the map.
bool map_changed = false

int BUY = 1
int SELL = 2
// (M2) Orders: the number of hulls (ask_number), then confirming the order,
// a cancellation, or taking delivery (confirm, on_confirm).
int ORDER_UNITS = 3
int ORDER_OK = 4
int CANCEL_OK = 5
int DELIVER_OK = 6
// (M3) Shorts, board actions and the player's company. (20 is Refits'.)
int SHORT = 7
int COVER = 8
int BLOCK_OK = 9
int DEMAND_OK = 10
int PAYOUT_ASK = 11
int DIRECT_ASK = 12
int SELL_SUITOR_OK = 13
int CHARTER_ASK = 14
int CHARTER_OK = 15
int ASSIGN_OK = 16
int UNASSIGN_OK = 17
int SELLSHIP_OK = 18
int CAPACITY_ASK = 19
int POLICY_ASK = 21
int HIRE_ASK = 22
int IPO_OK = 23
int DISSOLVE_OK = 24
int PAYOUT_OK = 25
int DIRECT_OK = 26
// The board action or charter choice waiting for its confirm.
int pending_level = 0
// The player's ships on the company tab (UUIDs), and the one chosen.
[]string ship_items = []
string ship_choice = ""
// What the chosen Orders row stands for: "m:<model>" (a hull to order) or
// "o:<contract id>" (one of the player's orders); "" for none. And each row's.
string order_choice = ""
[]string order_items = []
// The hulls asked for, waiting for the player to confirm the order.
string pending_model = ""
int pending_units = 0

int tab = 0
// The chosen company's id, or 0.
int selected = 0
// The market's sort: a column, and whether it runs high to low.
int sort_column = 6
bool descending = true
// What each table row stands for (a company id, or 0), and each button.
[]int row_ids = []
[]string actions = []
// A line shown once at the top of the sidebar (a trade's result).
string note = ""

Fmt fmt = Fmt()
Names names = Names()
MapView maps = MapView()

void open(es.Game game, Market market):
    tab = MARKET
    order_choice = ""
    string planet = game.planet()
    Company builder = market.orders.builder_at(market, planet)
    if builder.id != 0:
        // At a builder's home: its Orders first when there is no bank, or an
        // order is ready, which asks at once to pay the rest.
        if !game.planet_service(planet, "bank"):
            tab = ORDERS
        Contract ready = market.orders.ready_at(market, planet)
        if ready.id != 0:
            tab = ORDERS
            order_choice = "o:" + string(ready.id)
            show(game, market)
            ask_delivery(game, market, ready)
            return
    show(game, market)

// Draw the screen again as it now stands: the open tab's table, the sidebar,
// the buttons. The title stays the same per tab, so the table keeps its place.
void show(es.Game game, Market market):
    row_ids = []
    actions = []
    if selected != 0 && !market.by_id.has(selected):
        selected = 0
    game.screen_open("Stock exchange: " + tab_names[tab], sidebar(game, market))
    chart(game, market)
    if tab == PORTFOLIO:
        portfolio_table(game, market)
    else if tab == CONTRACTS:
        contracts_table(game, market)
    else if tab == NEWS:
        news_table(game, market)
    else if tab == MAP:
        map_table(game)
    else if tab == ORDERS:
        orders_table(game, market)
    else if tab == COMPANY:
        company_table(game, market)
    else:
        market_table(game, market)
    int chosen = row_ids.index_of(selected) if selected != 0 && row_ids.contains(selected) else -1
    if tab == ORDERS:
        chosen = order_items.index_of(order_choice) if order_choice != "" && order_items.contains(order_choice) else -1
    if tab == COMPANY:
        chosen = ship_items.index_of(ship_choice) if ship_choice != "" && ship_items.contains(ship_choice) else -1
    game.panel_select(chosen)
    // Always the same buttons, in the same places, so their keys stay put.
    button(game, "Market", "market")
    button(game, "Portfolio", "portfolio")
    button(game, "Contracts", "contracts")
    button(game, "News", "news")
    button(game, "Map", "map")
    Company builder = market.orders.builder_at(market, game.planet())
    if builder.id != 0:
        button(game, "Orders", "orders")
    button(game, "Company", "company")
    if tab == COMPANY:
        company_buttons(game, market)
        button(game, "Leave", "close")
        note = ""
        return
    if tab == ORDERS:
        if order_choice.starts_with("m:"):
            button(game, "Order", "order")
        else if order_choice.starts_with("o:"):
            Contract k = order_by_id(market, order_choice[2..<order_choice.len()].to_int())
            if k.id != 0 && market.by_id.has(k.winner) && market.by_id[k.winner].home == game.planet():
                if k.status == k.DELIVERED:
                    button(game, "Take delivery", "deliver")
                button(game, "Cancel order", "cancel")
        button(game, "Leave", "close")
        note = ""
        return
    bool listed = selected != 0 && market.by_id[selected].listed()
    if listed:
        Company c = market.by_id[selected]
        if !c.private():
            button(game, "Buy", "buy")
        if market.holdings.get(selected, 0) > 0 && !c.private():
            button(game, "Sell", "sell")
        // (M3) Shorts and board power.
        if market.shorts_desk.allowed(market, c) && c.owner == 0:
            button(game, "Short", "short")
        if market.shorts.get(c.id, 0) > 0:
            button(game, "Cover", "cover")
        if !market.frozen(c):
            if market.board.may_vote(market, c):
                button(game, "Block bid", "block")
                button(game, "Demand more", "demand")
            if market.board.has_seat(market, c) && c.owner == 0:
                button(game, "Payout", "payout")
                button(game, "Direct bids", "direct")
            if market.board.may_sell(market, c):
                button(game, "Sell to suitor", "sell suitor")
    button(game, "Leave", "close")
    note = ""

void button(es.Game game, string label, string action):
    game.panel_button(label)
    actions.append(action)

// ---- Tables ----

void market_table(es.Game game, Market market):
    []Company listed = market.companies.filter(bool(Company c): return c.listed())
    listed.sort(bool(Company a, Company b): return before(market, a, b))
    game.panel_columns(heading("Company", 0) + "\t" + heading("Sector", 1) + "\t" + heading("Price", 2) + "\t" + heading("30 days", 3) + "\t" + heading("P/E", 4) + "\t" + heading("Yield", 5) + "\t" + heading("Value", 6) + "\t" + heading("You hold", 7))
    for c in listed:
        string name = c.name + (" (for sale)" if c.status == c.FOR_SALE else (" (distressed)" if c.status == c.DISTRESSED else ""))
        int held = market.holdings.get(c.id, 0)
        game.panel_row(name + "\t" + names.sector_short[c.sector] + "\t" + fmt.price(c.price) + "\t" + change(c, 30) + "\t" + pe(market, c) + "\t" + yield_of(c) + "\t" + fmt.short_credits(c.market_value()) + "\t" + (fmt.credits(float(held)) if held > 0 else "-"))
        row_ids.append(c.id)

// A heading, marked when the market is sorted by it.
string heading(string label, int column):
    if column != sort_column:
        return label
    return label + (" v" if descending else " ^")

// Whether a comes before b in the market's sort.
bool before(Market market, Company a, Company b):
    float x = sort_key(market, a)
    float y = sort_key(market, b)
    if sort_column == 0:
        return alphabetical(a.name, b.name) if !descending else alphabetical(b.name, a.name)
    if x == y:
        return alphabetical(a.name, b.name)
    return x > y if descending else x < y

// Whether a comes before b, by code point.
bool alphabetical(string a, string b):
    int n = a.len() if a.len() < b.len() else b.len()
    for i in 0..<n:
        int x = a.code_point_at(i)
        int y = b.code_point_at(i)
        if x != y:
            return x < y
    return a.len() < b.len()

float sort_key(Market market, Company c):
    if sort_column == 1:
        return float(c.sector)
    if sort_column == 2:
        return c.price
    if sort_column == 3:
        return change_value(c, 30)
    if sort_column == 4:
        return pe_value(c)
    if sort_column == 5:
        return c.dividend / c.price if c.price > 0.0 else 0.0
    if sort_column == 7:
        return float(market.holdings.get(c.id, 0))
    return c.market_value()

void portfolio_table(es.Game game, Market market):
    game.panel_columns("Company\tShares\tPrice\tValue\tPaid\tGain")
    for id, n in market.holdings:
        if !market.by_id.has(id):
            continue
        Company c = market.by_id[id]
        float v = c.price * float(n)
        float p = market.basis.get(id, 0.0)
        game.panel_row(c.name + "\t" + fmt.credits(float(n)) + "\t" + fmt.price(c.price) + "\t" + fmt.credits(v) + "\t" + fmt.credits(p) + "\t" + fmt.percent(v / p - 1.0 if p > 0.0 else 0.0))
        row_ids.append(id)

void contracts_table(es.Game game, Market market):
    game.panel_columns("Client\tSector\tSystem\tValue\tStatus")
    tender_rows(game, market)
    restock_rows(game, market)
    []Contract open = market.contracts.filter(bool(Contract k): return k.status == k.OPEN && k.kind != k.RESTOCK && k.kind != k.TENDER && k.kind != k.ORDER)
    for k in open:
        int left = k.closes - market.day
        game.panel_row(market.client_name(k) + "\t" + names.sector_short[k.sector] + "\t" + k.system + "\t" + fmt.short_credits(k.budget) + "\tbids close " + ("today" if left <= 0 else "in " + string(left) + (" day" if left == 1 else " days")))
        row_ids.append(0)
    []Contract recent = market.contracts.filter(bool(Contract k): return k.status != k.OPEN && k.status != k.LAPSED && k.kind != k.RESTOCK && k.kind != k.TENDER && k.kind != k.ORDER)
    recent.sort(bool(Contract a, Contract b): return a.start > b.start)
    for k in recent:
        string who = market.by_id[k.winner].name if market.by_id.has(k.winner) else "a company"
        string state = "running: " + who
        if k.status == k.DELIVERED:
            state = "delivered: " + who
        else if k.status == k.FAILED:
            state = "failed: " + who
        game.panel_row(market.client_name(k) + "\t" + names.sector_short[k.sector] + "\t" + k.system + "\t" + fmt.short_credits(k.price) + "\t" + state)
        row_ids.append(k.winner)

// Military tenders (C6) first: open ones with their closing day and who can
// bid, then running and recent ones with the winner and the due day. Every
// one is tagged "military". Clicking a row chooses the winner.
void tender_rows(es.Game game, Market market):
    []Contract list = market.contracts.filter(bool(Contract k): return k.kind == k.TENDER && k.status != k.LAPSED)
    list.sort(bool(Contract a, Contract b): return (a.status == a.OPEN && b.status != b.OPEN) || (a.status == b.status && a.issued > b.issued))
    for k in list:
        string what = k.client + " tender: " + string(k.units) + " " + market.model_label(k.model, k.units) + " (military)"
        string state = ""
        if k.status == k.OPEN:
            int left = k.closes - market.day
            []string who = market.tender_bidders(k)
            string bidders = "no bidders yet"
            if who.len() > 0:
                bidders = "bidders: " + (who[0..<3].join(", ") + " and " + string(who.len() - 3) + " more" if who.len() > 3 else who.join(", "))
            state = "bids close " + ("today" if left <= 0 else "in " + string(left) + (" day" if left == 1 else " days")) + " (" + fmt.date(k.closes) + "); " + bidders
        else:
            string winner = market.by_id[k.winner].name if market.by_id.has(k.winner) else ("government yards" if k.winner == 0 else "a builder")
            if k.status == k.RUNNING && k.convoy == 1:
                state = "under way as a convoy: " + winner
            else if k.status == k.RUNNING:
                state = "running: " + winner + ", due " + fmt.date(k.ends)
            else if k.status == k.DELIVERED:
                state = "delivered: " + winner
            else:
                state = "failed: " + winner + "; issued again"
        game.panel_row(what + "\tMilitary\t" + k.system + "\t" + fmt.short_credits(k.budget if k.status == k.OPEN else k.price) + "\t" + state)
        row_ids.append(k.winner if k.status != k.OPEN else 0)

// Shipyard restocks are many and small: one row per company that owns hull
// designs, summing its restocks running and delivered lately (kept 20 days).
// Clicking the row chooses the company.
void restock_rows(es.Game game, Market market):
    []int owners = []
    {int: int} on_order = {}
    {int: int} delivered = {}
    {int: float} value = {}
    {int: []string} yards = {}
    for k in market.contracts:
        if k.kind != k.RESTOCK || (k.status != k.RUNNING && k.status != k.DELIVERED):
            continue
        if !owners.contains(k.winner):
            owners.append(k.winner)
            yards[k.winner] = []
        if k.status == k.RUNNING:
            on_order[k.winner] = on_order.get(k.winner, 0) + k.units
            value[k.winner] = value.get(k.winner, 0.0) + k.price
            if !yards[k.winner].contains(k.client):
                yards[k.winner].append(k.client)
        else:
            delivered[k.winner] = delivered.get(k.winner, 0) + k.units
    for id in owners:
        string who = market.by_id[id].name if market.by_id.has(id) else "a company"
        int n = on_order.get(id, 0)
        int y = yards[id].len()
        string where = (string(y) + (" shipyard" if y == 1 else " shipyards")) if y > 0 else "-"
        game.panel_row("Shipyard restocks\tShips\t" + where + "\t" + fmt.short_credits(value.get(id, 0.0)) + "\t" + string(n) + " hulls on order, " + string(delivered.get(id, 0)) + " delivered: " + who)
        row_ids.append(id)

void news_table(es.Game game, Market market):
    game.panel_columns("News: " + filter_names[filter] + " (click to filter)\tWhen")
    for i in 0..<market.news.len():
        string line = market.news[market.news.len() - 1 - i]
        []string f = line.split("|")
        if f.len() < 2 || !shows(market, f[2] if f.len() > 2 else ""):
            continue
        int ago = market.day - f[0].to_int()
        game.panel_row(f[1] + "\t" + ("today" if ago <= 0 else (string(ago) + (" day ago" if ago == 1 else " days ago"))))
        row_ids.append(first_company(market, f[2] if f.len() > 2 else ""))

// Whether a news line with these tags passes the filter.
bool shows(Market market, string tags):
    if filter == 0:
        return true
    []string t = tags.split(",")
    if filter == 2:
        return t.contains("s")
    if filter == 3:
        return t.contains("w")
    for x in t:
        if x.starts_with("c") && market.holdings.get(x[1..<x.len()].to_int(), 0) > 0:
            return true
    return false

// The first company a news line is about, so clicking it chooses that company; 0 for none.
int first_company(Market market, string tags):
    for x in tags.split(","):
        if x.starts_with("c") && x.len() > 1:
            int id = x[1..<x.len()].to_int()
            if market.by_id.has(id):
                return id
    return 0

// The map's layers: a row each, clicked to switch it.
void map_table(es.Game game):
    game.panel_columns("Map layer\tShown")
    for i in 0..<maps.layer_keys.len():
        game.panel_row(maps.layer_names[i] + "\t" + ("on" if maps.on(game, maps.layer_keys[i]) else "off"))
        row_ids.append(-(i + 1))

// (M2) The Orders tab: the player's orders (any builder), then this
// builder's civilian hulls with price, deposit and lead time now.
void orders_table(es.Game game, Market market):
    order_items = []
    Company b = market.orders.builder_at(market, game.planet())
    game.panel_columns("Hull\tCategory\tPrice\tDeposit\tDelivery")
    for k in market.contracts:
        if k.kind != k.ORDER:
            continue
        string who = market.by_id[k.winner].name if market.by_id.has(k.winner) else "a builder"
        string state = ("ready: " + fmt.credits(float(market.orders.remainder(k))) + " to pay") if k.status == k.DELIVERED else ("due " + fmt.date(k.ends))
        game.panel_row("Your order: " + string(k.units) + " " + market.model_label(k.model, k.units) + " from " + who + "\t" + game.model_category(k.model) + "\t" + fmt.short_credits(k.price) + "\t" + fmt.short_credits(k.budget) + " paid\t" + state)
        row_ids.append(0)
        order_items.append("o:" + string(k.id))
    if b.id == 0:
        return
    []int rows = market.orders.models(market, b)
    for r in rows:
        string model = market.hulls.models[r]
        int price = market.orders.unit_price(game, market, b, model)
        if price <= 0:
            continue
        int days = market.orders.lead(game, market, b, r, 1)
        game.panel_row(game.model_name(model) + "\t" + game.model_category(model) + "\t" + fmt.credits(float(price)) + "\t" + fmt.credits(float(market.orders.deposit(price))) + "\t" + string(days) + " days")
        row_ids.append(0)
        order_items.append("m:" + model)

Contract order_by_id(Market market, int id):
    for k in market.contracts:
        if k.kind == k.ORDER && k.id == id:
            return k
    return Contract()

string orders_text(es.Game game, Market market):
    Company b = market.orders.builder_at(market, game.planet())
    string t = ""
    if b.id != 0:
        int st = market.standing.effective(game, market, b.id)
        t = b.name + " takes orders for its civilian hulls here: 1 to " + string(market.orders.MAX_UNITS) + " at a time, " + fmt.whole_percent(market.orders.DEPOSIT) + " down, the rest on delivery. Orders are built ahead of shipyard restocks. Cancelling refunds half the deposit.\n\n"
        t = t + "Your standing with " + b.name + ": " + string(st) + " (" + market.standing.word(st) + "). Good standing shortens delivery"
        if market.orders.discounted(game, market, b):
            t = t + "; at " + string(market.standing.DISCOUNT_AT) + " or more you get " + fmt.whole_percent(market.orders.DISCOUNT) + " off (at most " + fmt.short_credits(float(market.orders.DISCOUNT_MAX)) + " a hull), which spends " + string(market.standing.ORDER_COST) + " standing a hull"
        t = t + ". Escorting its convoys and carrying its parts raise it.\n\n"
    else:
        t = "Orders are placed at a builder's home planet.\n\n"
    if order_choice.starts_with("m:") && b.id != 0:
        string model = order_choice[2..<order_choice.len()]
        int price = market.orders.unit_price(game, market, b, model)
        t = t + game.model_name(model) + ": " + fmt.credits(float(price)) + " credits each, " + fmt.credits(float(market.orders.deposit(price))) + " down.\n"
        string why = market.orders.refusal(game, market, b, model, 1)
        if why != "":
            t = t + why + "\n"
    t = t + "\nYou have " + fmt.credits(float(game.condition("credits"))) + " credits."
    return t

void ask_delivery(es.Game game, Market market, Contract k):
    string who = market.by_id[k.winner].name if market.by_id.has(k.winner) else "The builder"
    game.confirm(who + " has your " + string(k.units) + " " + market.model_label(k.model, k.units) + " ready. Pay the remaining " + fmt.credits(float(market.orders.remainder(k))) + " credits and take delivery now?", DELIVER_OK)

// ---- The sidebar ----

// The chart over the sidebar's text: the chosen company's price, the
// player's shares' worth on their portfolio, or the exchange's index.
void chart(es.Game game, Market market):
    if selected != 0 && market.by_id.has(selected):
        Company c = market.by_id[selected]
        if c.history.len() > 1:
            []string prices = []
            for h in c.history:
                prices.append(string(float(h) / 100.0))
            game.panel_chart(c.name + ", 60 days", prices.join(","))
        return
    if tab == PORTFOLIO && market.holdings.len() > 0 && market.portfolio_history.len() > 1:
        game.panel_chart("Your shares' worth", numbers(market.portfolio_history))
    else if market.index_history.len() > 1:
        game.panel_chart("Exchange index", numbers(market.index_history))

string numbers([]float xs):
    []string out = []
    for x in xs:
        int n = globalThis.Math.round(x)
        out.append(string(n))
    return out.join(",")

string sidebar(es.Game game, Market market):
    string top = (note + "\n\n") if note != "" else ""
    if tab == ORDERS:
        return top + orders_text(game, market)
    if tab == COMPANY:
        return top + charter_text(game, market)
    if selected != 0 && market.by_id.has(selected):
        return top + company_text(game, market, market.by_id[selected])
    return top + summary(game, market)

string summary(es.Game game, Market market):
    float value = 0.0
    float paid = 0.0
    for id, n in market.holdings:
        if market.by_id.has(id):
            value += market.by_id[id].price * float(n)
            paid += market.basis.get(id, 0.0)
    string t = "The economy is in " + market.cycle_names[market.cycle] + ".\n"
    t = t + "The exchange index stands at " + fmt.one_decimal(market.index) + index_change(market) + ".\n\n"
    t = t + "You have " + fmt.credits(float(game.condition("credits"))) + " credits.\n"
    if market.scrutiny > 0:
        t = t + "The regulator's attention to you: " + string(market.scrutiny) + " of " + string(market.board.FINE_AT) + " (a fine at " + string(market.board.FINE_AT) + ").\n"
    if market.owed > 0.0:
        t = t + "You owe " + fmt.credits(market.owed) + " credits in fines, taken from what you earn (dividends, sales, job pay) until it is paid.\n"
    if paid > 0.0:
        t = t + "Your shares are worth " + fmt.credits(value) + " credits, " + fmt.percent(value / paid - 1.0) + " on what you paid.\n"
    t = t + "Dividends received: " + fmt.credits(market.dividends_paid) + " credits.\n\n"
    t = t + string(market.listed_count()) + " companies are listed. Click one for its details; click a heading to sort the market. The arrow keys step through the list.\n\n"
    if tab == NEWS:
        t = t + "Click the News heading to filter: all, companies you hold, shipyards and hulls, or the war. Click a line to choose the company it is about.\n\n"
    else if tab == MAP:
        t = t + "Click a layer to show or hide it on the map. Canonical companies' homes are lit and labelled; each shipyard system's panel gives its loss index: how many ships its region has lost lately against quiet space (1.0).\n\n"
    t = t + "Trades pay a broker 1% (at least 100 credits). You may hold up to " + fmt.whole_percent(market.MAX_HOLDING) + " of a company, and large orders move the price: each 1% of a company's shares you buy or sell moves it about 2%."
    return t

// The index's change over the last 30 days, as ", +3.4% over 30 days".
string index_change(Market market):
    int n = market.index_history.len()
    if n < 2:
        return ""
    float then = market.index_history[(n - 31) if n > 31 else 0]
    return ", " + fmt.percent(market.index / then - 1.0) + " over 30 days" if then > 0.0 else ""

string company_text(es.Game game, Market market, Company c):
    string t = c.name + "\n"
    t = t + names.sectors[c.sector] + (", one of human space's established companies" if c.canon else "") + ".\nHome: " + game.planet_name(c.home) + ", in " + c.system + ".\n"
    if c.status == c.DISTRESSED:
        t = t + "In distress: out of cash at its debt limit since day " + string(c.since) + ".\n"
    else if c.status == c.FOR_SALE:
        t = t + "For sale to its rivals since day " + string(c.since) + ".\n"
    else if c.status == c.BANKRUPT:
        t = t + "Bankrupt and delisted on day " + string(c.since) + ".\n"
    else if c.status == c.MERGED:
        t = t + "Bought by " + (market.by_id[c.parent].name if market.by_id.has(c.parent) else "a rival") + " on day " + string(c.since) + ".\n"
    if c.suitor > 0 && market.by_id.has(c.suitor):
        t = t + market.by_id[c.suitor].name + " is building a stake, offering " + fmt.price(c.offer) + " a share.\n"
    if c.review > 0:
        t = t + "Under antitrust review since day " + string(c.review) + ".\n"
    t = t + "\nPrice " + fmt.price(c.price) + "\n" + change(c, 30) + " over 30 days, " + change(c, 60) + " over 60" + range_of(c) + ".\n"
    t = t + "Market value " + fmt.short_credits(c.market_value()) + ", " + fmt.credits(float(c.shares)) + " shares.\n"
    t = t + "Book value " + fmt.price(market.book(c)) + " a share. P/E " + pe(market, c) + ". Yield " + yield_of(c) + ".\n"
    t = t + "Last reports: " + reports(c) + ".\n\n"
    t = t + "Cash " + fmt.short_credits(c.cash) + ", debt " + fmt.short_credits(c.debt) + ".\n"
    t = t + "Capacity " + fmt.one_decimal(c.capacity) + " units a day, " + fmt.whole_percent(c.load / c.capacity if c.capacity > 0.0 else 0.0) + " busy. Reliability " + fmt.whole_percent(c.reliability) + ".\n"
    t = t + "Recent contracts: " + recent_contracts(market, c) + "\n"
    t = t + m3_text(game, market, c)
    t = t + m2_text(game, market, c)
    t = t + restocks_text(market, c)
    t = t + tenders_text(market, c)
    t = t + demand_text(market, c)
    int held = market.holdings.get(c.id, 0)
    if held > 0:
        float value = c.price * float(held)
        float paid = market.basis.get(c.id, 0.0)
        t = t + "\nYou hold " + fmt.credits(float(held)) + " shares (" + fmt.whole_percent(float(held) / float(c.shares)) + "), worth " + fmt.credits(value) + " credits: " + fmt.percent(value / paid - 1.0 if paid > 0.0 else 0.0) + " on what you paid.\n"
    t = t + "\nYou have " + fmt.credits(float(game.condition("credits"))) + " credits."
    return t

// ---- What the player does ----

void press(es.Game game, Market market, int index):
    string action = actions[index] if index >= 0 && index < actions.len() else "close"
    if action == "close":
        game.panel_close()
        return
    if action == "market":
        tab = MARKET
    else if action == "portfolio":
        tab = PORTFOLIO
    else if action == "contracts":
        tab = CONTRACTS
    else if action == "news":
        tab = NEWS
    else if action == "map":
        tab = MAP
    else if action == "orders":
        tab = ORDERS
        order_choice = ""
    else if action == "order" && order_choice.starts_with("m:"):
        Company b = market.orders.builder_at(market, game.planet())
        string model = order_choice[2..<order_choice.len()]
        string why = market.orders.refusal(game, market, b, model, 1) if b.id != 0 else "Orders are placed at a builder's home planet."
        if why == "":
            int price = market.orders.unit_price(game, market, b, model)
            int most = market.orders.MAX_UNITS
            for most > 1 && market.orders.refusal(game, market, b, model, most) != "":
                most -= 1
            pending_model = model
            game.ask_number("How many " + game.model_name(model) + " hulls will you order from " + b.name + "? Each costs " + fmt.credits(float(price)) + " credits: " + fmt.credits(float(market.orders.deposit(price))) + " now, the rest on delivery. Up to " + string(most) + ".", ORDER_UNITS, most)
            return
        note = why
    else if action == "cancel" && order_choice.starts_with("o:"):
        Contract k = order_by_id(market, order_choice[2..<order_choice.len()].to_int())
        if k.id != 0:
            game.confirm("Cancel your order of " + string(k.units) + " " + market.model_label(k.model, k.units) + "? Half the deposit, " + fmt.credits(float(int(k.budget) / 2)) + " credits, is refunded; the builder keeps the rest.", CANCEL_OK)
            return
    else if action == "deliver" && order_choice.starts_with("o:"):
        Contract k = order_by_id(market, order_choice[2..<order_choice.len()].to_int())
        if k.id != 0 && k.status == k.DELIVERED:
            ask_delivery(game, market, k)
            return
    else if action == "buy" && market.by_id.has(selected):
        Company c = market.by_id[selected]
        int most = market.can_buy(game, c)
        if most >= 1:
            game.ask_number("Buy shares of " + c.name + " at " + fmt.price(c.price) + " each, plus a 1% fee (at least 100 credits). Your order raises the price as it fills: buying 1% of the company (" + fmt.credits(float(c.shares) / 100.0) + " shares) moves it about 2%. You can buy up to " + fmt.credits(float(most)) + ".", BUY, most)
            return
        note = "You can't buy shares of " + c.name + " now: you lack the credits, or you already hold " + fmt.whole_percent(market.MAX_HOLDING) + " of it."
    else if action == "company":
        tab = COMPANY
    else if press_m3(game, market, action):
        return
    else if action == "sell" && market.by_id.has(selected):
        Company c = market.by_id[selected]
        int held = market.holdings.get(c.id, 0)
        if held > 0:
            game.ask_number("Sell shares of " + c.name + " at " + fmt.price(c.price) + " each, less a 1% fee (at least 100 credits). Your order lowers the price as it fills: selling 1% of the company (" + fmt.credits(float(c.shares) / 100.0) + " shares) moves it about 2%. You hold " + fmt.credits(float(held)) + ".", SELL, held)
            return
    show(game, market)

void row(es.Game game, Market market, int index):
    if tab == COMPANY:
        if index >= 0 && index < ship_items.len():
            ship_choice = ship_items[index]
            show(game, market)
        return
    if tab == ORDERS:
        if index >= 0 && index < order_items.len():
            order_choice = order_items[index]
            show(game, market)
        return
    if index < 0 || index >= row_ids.len() || row_ids[index] == 0:
        return
    if row_ids[index] < 0:
        // A map layer.
        maps.toggle(game, maps.layer_keys[-row_ids[index] - 1])
        map_changed = true
        show(game, market)
        return
    selected = row_ids[index]
    show(game, market)

// A click on a heading sorts the market by it, or turns the sort around.
void header(es.Game game, Market market, int column):
    if tab == NEWS && column == 0:
        filter = (filter + 1) % filter_names.len()
        show(game, market)
        return
    if tab != MARKET:
        return
    if column == sort_column:
        descending = !descending
    else:
        sort_column = column
        descending = column != 0 && column != 1
    show(game, market)

// Answers whether the market changed (and must be saved).
bool number(es.Game game, Market market, int token, int value):
    if token >= SHORT && token != ORDER_UNITS:
        return number_m3(game, market, token, value)
    if token == ORDER_UNITS:
        Company b = market.orders.builder_at(market, game.planet())
        if b.id == 0 || pending_model == "":
            return false
        string why = market.orders.refusal(game, market, b, pending_model, value)
        if why != "":
            note = why
            show(game, market)
            return false
        int price = market.orders.unit_price(game, market, b, pending_model)
        int row = market.hulls.find(pending_model)
        pending_units = value
        int days = market.orders.lead(game, market, b, row, value)
        string cut = (" (less for your standing, which spends " + string(market.standing.ORDER_COST * value) + " of it)") if market.orders.discounted(game, market, b) else ""
        game.confirm("Order " + string(value) + " " + market.model_label(pending_model, value) + " from " + b.name + " for " + fmt.credits(float(price * value)) + " credits" + cut + "? You pay " + fmt.credits(float(market.orders.deposit(price) * value)) + " now and " + fmt.credits(float((price - market.orders.deposit(price)) * value)) + " on delivery here, in about " + string(days) + " days.", ORDER_OK)
        return false
    if !market.by_id.has(selected):
        return false
    Company c = market.by_id[selected]
    bool changed = false
    if token == BUY:
        float cost = market.buy(game, c, value)
        changed = cost > 0.0
        note = ("Bought " + fmt.credits(float(value)) + " shares of " + c.name + " for " + fmt.credits(cost) + " credits.") if changed else "That purchase didn't go through."
    else if token == SELL:
        float got = market.sell(game, c, value)
        changed = got > 0.0
        note = ("Sold " + fmt.credits(float(value)) + " shares of " + c.name + " for " + fmt.credits(got) + " credits.") if changed else "That sale didn't go through."
    show(game, market)
    return changed

// (M2) The player confirmed: an order placed, cancelled or delivered.
// Answers whether the market changed (and must be saved).
bool confirmed(es.Game game, Market market, int token, Galaxy galaxy):
    bool changed = false
    if token >= BLOCK_OK:
        changed = confirmed_m3(game, market, token, galaxy)
        show(game, market)
        return changed
    if token == ORDER_OK:
        Company b = market.orders.builder_at(market, game.planet())
        if b.id != 0 && pending_model != "" && pending_units > 0:
            Contract k = market.orders.place(game, market, b, pending_model, pending_units, market.day)
            changed = k.id != 0
            note = ("Ordered " + string(k.units) + " " + market.model_label(k.model, k.units) + " from " + b.name + ": " + fmt.credits(k.budget) + " credits paid, due " + fmt.date(k.ends) + ".") if changed else "That order didn't go through."
            if changed:
                order_choice = "o:" + string(k.id)
        pending_model = ""
        pending_units = 0
    else if token == CANCEL_OK && order_choice.starts_with("o:"):
        Contract k = order_by_id(market, order_choice[2..<order_choice.len()].to_int())
        if k.id != 0:
            int back = market.orders.cancel(game, market, k)
            note = "Order cancelled: " + fmt.credits(float(back)) + " credits refunded."
            order_choice = ""
            changed = true
    else if token == DELIVER_OK && order_choice.starts_with("o:"):
        Contract k = order_by_id(market, order_choice[2..<order_choice.len()].to_int())
        if k.id != 0 && k.status == k.DELIVERED:
            int units = k.units
            int got = market.orders.deliver(game, market, k)
            changed = got > 0
            if got == units:
                note = "Your new " + market.model_label(k.model, got) + " " + ("is" if got == 1 else "are") + " waiting in the shipyard."
                order_choice = ""
            else if got > 0:
                note = string(got) + " delivered; the game refused the rest (credits or licenses). They wait here for you."
            else:
                note = "You can't take delivery: you need " + fmt.credits(float(market.orders.remainder(k))) + " credits, and every license the hull needs."
    else:
        return false
    show(game, market)
    return changed

// ---- Figures ----

// The price's change over the last n days.
string change(Company c, int n):
    if c.history.len() == 0:
        return "new"
    int back = c.history.len() - 1 - n
    int then = c.history[back if back >= 0 else 0]
    if then <= 0:
        return "new"
    return fmt.percent(c.price * 100.0 / float(then) - 1.0)

string range_of(Company c):
    if c.history.len() < 2:
        return ""
    int lo = c.history[0]
    int hi = c.history[0]
    for h in c.history:
        lo = h if h < lo else lo
        hi = h if h > hi else hi
    return " (low " + fmt.price(float(lo) / 100.0) + ", high " + fmt.price(float(hi) / 100.0) + ")"

string pe(Market market, Company c):
    float v = pe_value(c)
    if c.earnings.len() == 0:
        return "-"
    if v <= 0.0:
        return "loss"
    return fmt.one_decimal(v)

// The price over a year's earnings at the last four reports' pace; 0 for none or a loss.
float pe_value(Company c):
    if c.earnings.len() == 0:
        return 0.0
    float sum = 0.0
    for e in c.earnings:
        sum += e
    float eps = sum * 365.0 / (30.0 * float(c.earnings.len())) / float(c.shares)
    return c.price / eps if eps > 0.0 else 0.0

// The price's change over the last n days, as a share (0 when new).
float change_value(Company c, int n):
    if c.history.len() == 0:
        return 0.0
    int back = c.history.len() - 1 - n
    int then = c.history[back if back >= 0 else 0]
    return c.price * 100.0 / float(then) - 1.0 if then > 0 else 0.0

string yield_of(Company c):
    if c.dividend <= 0.0 || c.price <= 0.0:
        return "-"
    return fmt.one_decimal(c.dividend * 365.0 / 30.0 / c.price * 100.0) + "%"

string reports(Company c):
    if c.earnings.len() == 0:
        return "none yet"
    []string out = []
    for e in c.earnings:
        out.append(("" if e >= 0.0 else "loss ") + fmt.short_credits(e if e >= 0.0 else -e))
    return out.join(", ")

string recent_contracts(Market market, Company c):
    []Contract mine = market.contracts.filter(bool(Contract k): return k.winner == c.id && k.status != k.OPEN && k.kind != k.RESTOCK && k.kind != k.TENDER && k.kind != k.ORDER)
    mine.sort(bool(Contract a, Contract b): return a.start > b.start)
    if mine.len() == 0:
        return "none lately."
    []string out = []
    for k in mine:
        if out.len() >= 4:
            break
        string state = "running" if k.status == k.RUNNING else ("delivered" if k.status == k.DELIVERED else "failed")
        out.append(market.client_name(k) + " (" + fmt.short_credits(k.price) + ", " + state + ")")
    return out.join("; ") + "."

// (M2) A crisis at the company, its convoys under way, and the player's
// standing with it (for the companies the player can deal with), or "".
string m2_text(es.Game game, Market market, Company c):
    string t = ""
    for x in market.crises:
        if x.company == c.id:
            t = t + "In a " + market.crisis_desk.kind_names[x.kind] + " crisis until about " + fmt.date(x.ends) + ": prices around " + x.system + " are up.\n"
    int moving = 0
    for k in market.contracts:
        if k.convoy == 1 && k.status == k.RUNNING && k.winner == c.id:
            moving += 1
    if moving > 0:
        t = t + string(moving) + (" convoy" if moving == 1 else " convoys") + " under way through dangerous space.\n"
    int st = market.standing.effective(game, market, c.id)
    if st != 0 || c.canon:
        t = t + "Your standing with it: " + string(st) + " (" + market.standing.word(st) + ").\n"
    return t

// "Hull restocks: 3 on order for shipyards, 5 delivered lately.", or "".
string restocks_text(Market market, Company c):
    int running = 0
    int delivered = 0
    for k in market.contracts:
        if k.kind != k.RESTOCK || k.winner != c.id:
            continue
        if k.status == k.RUNNING:
            running += k.units
        else if k.status == k.DELIVERED:
            delivered += k.units
    if running == 0 && delivered == 0:
        return ""
    return "Hull restocks: " + string(running) + " on order for shipyards, " + string(delivered) + " delivered lately.\n"

// "Military tenders: 2 running (due 3 Apr 3015), 1 delivered, 1 failed lately.", or "".
string tenders_text(Market market, Company c):
    int running = 0
    int delivered = 0
    int failed = 0
    int due = -1
    for k in market.contracts:
        if k.kind != k.TENDER || k.winner != c.id:
            continue
        if k.status == k.RUNNING:
            running += 1
            due = k.ends if due < 0 || k.ends < due else due
        else if k.status == k.DELIVERED:
            delivered += 1
        else if k.status == k.FAILED:
            failed += 1
    if running + delivered + failed == 0:
        return ""
    string t = "Military tenders: " + string(running) + " running"
    if due >= 0:
        t = t + " (next due " + fmt.date(due) + ")"
    return t + ", " + string(delivered) + " delivered" + (", " + string(failed) + " failed" if failed > 0 else "") + " lately.\n"

// Where a hull owner's demand comes from: the regions whose losses sell most
// of its hulls, with their loss index and cause.
string demand_text(Market market, Company c):
    []string top = market.demand_regions(c, 3)
    if top.len() == 0:
        return ""
    []string out = []
    for sys in top:
        int r = market.losses.region_of.get(sys, -1)
        string why = market.losses.cause(r)
        out.append(sys + " (loss index " + fmt.one_decimal(market.losses.index(r)) + (", " + why if why != "" else "") + ")")
    return "Hull demand is strongest near " + out.join(", ") + ".\n"

// ---- M3: shorts, the board, the player's company ----

// "Chief executive: ...", the player's short, board power, a freeze; or "".
string m3_text(es.Game game, Market market, Company c):
    string t = ""
    if c.ceo != "":
        t = t + "Chief executive: " + (c.ceo + " (you)" if c.ceo == "you" else market.execs.label(c)) + ", since " + fmt.date(c.ceo_since) + ".\n"
    if c.status == c.NATIONALISED:
        t = t + "Nationalised on day " + string(c.since) + ".\n"
    if market.frozen(c):
        t = t + "Your faction is at war with the government of its home: your shares are frozen and half their dividends withheld.\n"
    int short = market.shorts.get(c.id, 0)
    if short > 0:
        float loss = market.shorts_desk.loss(market, c)
        t = t + "You are short " + fmt.credits(float(short)) + " shares (margin " + fmt.credits(market.short_margin.get(c.id, 0.0)) + "; " + ("open loss " + fmt.credits(loss) if loss > 0.0 else "open gain " + fmt.credits(-loss)) + "). The lender's fee is " + fmt.one_decimal(market.shorts_desk.RATE * 36500.0) + "% a year" + (", five times that while it is in trouble" if c.status != c.LISTED else "") + "; a loss past " + fmt.whole_percent(market.shorts_desk.CALL) + " of the margin is a margin call.\n"
    float s = market.board.share(market, c)
    if s >= market.board.VOTE && c.owner == 0:
        t = t + "Your " + fmt.whole_percent(s) + " gives you " + ("a seat on its board: you can set its payout and direct its bidding" if s >= market.board.SEAT else "a vote on any bid for it") + (", and sell your stake to a suitor at a premium" if s >= market.board.CONTROL else "") + ".\n"
    if c.bias != 0:
        t = t + "Its board has it bidding " + ("aggressively" if c.bias > 0 else "conservatively") + " until " + fmt.date(c.bias_until) + ".\n"
    return t

bool press_m3(es.Game game, Market market, string action):
    Company c = market.by_id.get(selected, Company())
    if action == "short" && c.id != 0:
        int most = market.shorts_desk.most(game, market, c)
        if most >= 1:
            game.ask_number("Sell shares of " + c.name + " short at about " + fmt.price(c.price) + ": you borrow them and sell them, and post " + fmt.whole_percent(market.shorts_desk.MARGIN) + " of their value as margin. The lender is paid " + fmt.one_decimal(market.shorts_desk.RATE * 36500.0) + "% a year and every dividend; a buyout buys them back at the offer; a loss past " + fmt.whole_percent(market.shorts_desk.CALL) + " of your margin is a margin call. Up to " + fmt.credits(float(most)) + ".", SHORT, most)
            return true
        note = "You can't sell " + c.name + " short now: you lack the margin, or " + fmt.whole_percent(market.shorts_desk.LIMIT) + " of it is short already."
        return false
    if action == "cover" && c.id != 0:
        int n = market.shorts.get(c.id, 0)
        game.ask_number("Buy back shares of " + c.name + " to close your short at about " + fmt.price(c.price) + " (the price rises as the order fills, plus the fee). You are short " + fmt.credits(float(n)) + ".", COVER, n)
        return true
    if action == "block" && c.id != 0:
        Company b = market.by_id.get(c.suitor, Company())
        game.confirm("Vote your shares against " + b.name + "'s bid for " + c.name + "? It fails, and " + c.name + "'s price falls back. " + b.name + " will not forget it, and the regulator notices.", BLOCK_OK)
        return true
    if action == "demand" && c.id != 0:
        Company b = market.by_id.get(c.suitor, Company())
        game.confirm("Demand that " + b.name + " raise its offer for " + c.name + " by " + fmt.whole_percent(market.board.DEMAND) + " for your votes? It may walk away instead (" + fmt.whole_percent(market.board.WITHDRAW / 100.0) + " of the time).", DEMAND_OK)
        return true
    if action == "payout" && c.id != 0:
        game.ask_number("Set " + c.name + "'s payout: 1 low (" + fmt.whole_percent(market.board.payouts[0]) + " of earnings; its shares slip), 2 normal (" + fmt.whole_percent(market.board.payouts[1]) + "), 3 high (" + fmt.whole_percent(market.board.payouts[2]) + "; less left to invest, its reliability falls).", PAYOUT_ASK, 3)
        return true
    if action == "direct" && c.id != 0:
        game.ask_number("Direct " + c.name + "'s bidding for " + string(market.board.DIRECT_DAYS) + " days: 1 aggressive (bids " + fmt.whole_percent(market.board.DIRECT_MARGIN) + " lower; its reliability suffers), 2 conservative (bids higher; its shares slip).", DIRECT_ASK, 2)
        return true
    if action == "sell suitor" && c.id != 0:
        Company b = market.by_id.get(c.suitor, Company())
        int held = market.holdings.get(c.id, 0)
        game.confirm("Sell your " + fmt.credits(float(held)) + " shares of " + c.name + " to " + b.name + " at " + fmt.price(c.offer * (1.0 + market.board.PREMIUM)) + " each (its offer plus " + fmt.whole_percent(market.board.PREMIUM) + ")? The regulator will take note.", SELL_SUITOR_OK)
        return true
    Company mine = market.charter.mine(market)
    if action == "charter":
        game.ask_number("Charter your own company for " + fmt.credits(float(market.charter.FEE)) + " credits (half becomes its first cash): 1 freight, 2 security.", CHARTER_ASK, 2)
        return true
    if mine.id == 0:
        return false
    if action == "assign" && ship_choice != "":
        game.confirm("Assign the " + game.fleet_ship_name(ship_choice) + " to " + mine.name + "? It is parked while it works for the company, adding " + fmt.one_decimal(market.charter.ship_capacity(game, mine, ship_choice)) + " to its capacity.", ASSIGN_OK)
        return true
    if action == "unassign" && ship_choice != "":
        game.confirm("Take the " + game.fleet_ship_name(ship_choice) + " back from " + mine.name + "? It is unparked, and the company loses its capacity.", UNASSIGN_OK)
        return true
    if action == "sell ship" && ship_choice != "":
        int price = market.charter.sale_price(game, ship_choice)
        if float(price) > mine.cash:
            note = mine.name + " can't pay " + fmt.credits(float(price)) + " credits for the " + game.fleet_ship_name(ship_choice) + "; it has " + fmt.credits(mine.cash) + "."
            return false
        game.confirm("Sell the " + game.fleet_ship_name(ship_choice) + " to " + mine.name + " for good? It leaves your fleet with everything aboard; the company pays you " + fmt.credits(float(price)) + " credits (" + fmt.whole_percent(market.charter.SALE_PAY) + " of a new one's price).", SELLSHIP_OK)
        return true
    if action == "capacity":
        game.ask_number("Buy capacity for " + mine.name + " at " + fmt.credits(market.charter.CAPITAL) + " credits a unit (work a day).", CAPACITY_ASK, 10)
        return true
    if action == "policy":
        game.ask_number("Set " + mine.name + "'s margins: 1 low (wins more, earns less), 2 normal, 3 high.", POLICY_ASK, 3)
        return true
    if action == "hire":
        game.ask_number("Hire a chief executive for " + fmt.credits(float(market.charter.HIRE_FEE)) + " credits: 1 aggressive, 2 prudent, 3 visionary, 4 crooked.", HIRE_ASK, 4)
        return true
    if action == "ipo":
        game.confirm("List " + mine.name + " on the exchange? The market buys " + fmt.whole_percent(market.charter.IPO_SHARE) + " of it in new shares and the company keeps the money, but rivals may then bid for it.", IPO_OK)
        return true
    if action == "dissolve":
        game.confirm("Dissolve " + mine.name + "? Its ships come back to you and its books are paid out to its holders.", DISSOLVE_OK)
        return true
    return false

// The company tab: the player's fleet, each ship assigned or not.
void company_table(es.Game game, Market market):
    ship_items = []
    Company mine = market.charter.mine(market)
    game.panel_columns("Ship\tModel\tCategory\tFor your company")
    if mine.id == 0:
        return
    for k in 0..<game.fleet_count():
        string ship = game.fleet_ship(k)
        string model = game.fleet_ship_model(ship)
        bool on = market.charter.has_ship(mine, ship)
        game.panel_row(game.fleet_ship_name(ship) + "\t" + model + "\t" + game.model_category(model) + "\t" + ("assigned (" + fmt.one_decimal(market.charter.ship_capacity(game, mine, ship)) + ")" if on else "-"))
        row_ids.append(0)
        ship_items.append(ship)

void company_buttons(es.Game game, Market market):
    Company mine = market.charter.mine(market)
    if mine.id == 0:
        if game.planet() != "" && game.planet_service(game.planet(), "bank"):
            button(game, "Charter", "charter")
        return
    if market.api_park && ship_choice != "":
        if market.charter.has_ship(mine, ship_choice):
            button(game, "Take back", "unassign")
        else:
            button(game, "Assign", "assign")
            if market.api_remove && !mine.ipo:
                button(game, "Sell ship", "sell ship")
    if !market.api_park:
        button(game, "Capacity", "capacity")
    button(game, "Margins", "policy")
    button(game, "Hire chief", "hire")
    if market.charter.may_ipo(mine):
        button(game, "IPO", "ipo")
    if market.charter.may_dissolve(market, mine):
        button(game, "Dissolve", "dissolve")

string charter_text(es.Game game, Market market):
    Company mine = market.charter.mine(market)
    if mine.id == 0:
        return "You have no company of your own. At a planet with a bank you can charter one in freight or security for " + fmt.credits(float(market.charter.FEE)) + " credits. It bids for contracts like any company; " + ("your ships give it capacity: each one you assign is parked while it works." if market.api_park else "you buy its capacity with credits.") + "\n\nYou have " + fmt.credits(float(game.condition("credits"))) + " credits."
    string t = company_text(game, market, mine) + "\n\n"
    t = t + "Margins: " + ["low", "normal", "high"][mine.policy + 1] + ". " + ("Listed on the exchange: rivals may bid for it; vote your shares to defend it." if mine.ipo else "Private: only you hold its shares.") + "\n"
    if market.api_park:
        t = t + "Click one of your ships to assign it (it is parked while assigned) or take it back."
    return t

bool number_m3(es.Game game, Market market, int token, int value):
    Company c = market.by_id.get(selected, Company())
    Company mine = market.charter.mine(market)
    bool changed = false
    if token == SHORT && c.id != 0:
        float margin = market.shorts_desk.open(game, market, c, value, market.day)
        changed = margin > 0.0
        if changed:
            market.tips_desk.traded(game, market, c, c.price * float(value))
        note = ("Sold " + fmt.credits(float(value)) + " shares of " + c.name + " short; " + fmt.credits(margin) + " credits posted as margin.") if changed else "That short sale didn't go through."
    else if token == COVER && c.id != 0:
        float before = c.price * float(value)
        float net = market.shorts_desk.cover(game, market, c, value, -1.0)
        market.tips_desk.traded(game, market, c, before)
        changed = true
        note = "Bought back " + fmt.credits(float(value)) + " shares of " + c.name + ": " + (fmt.credits(net) + " credits back." if net >= 0.0 else fmt.credits(-net) + " credits lost beyond your margin.")
    else if token == PAYOUT_ASK && c.id != 0:
        pending_level = value - 1
        game.confirm("Set " + c.name + "'s payout " + market.board.payout_names[pending_level] + "?", PAYOUT_OK)
        return false
    else if token == DIRECT_ASK && c.id != 0:
        pending_level = 1 if value == 1 else -1
        game.confirm("Direct " + c.name + " to bid " + ("aggressively" if pending_level == 1 else "conservatively") + " for " + string(market.board.DIRECT_DAYS) + " days?", DIRECT_OK)
        return false
    else if token == CHARTER_ASK:
        pending_level = 6 if value == 1 else 7
        game.confirm("Charter a " + market.names.sectors[pending_level].to_lower() + " company for " + fmt.credits(float(market.charter.FEE)) + " credits?", CHARTER_OK)
        return false
    else if token == CAPACITY_ASK && mine.id != 0:
        changed = market.charter.buy_capacity(game, market, mine, value)
        note = ("Bought " + string(value) + " units of capacity.") if changed else "You lack the credits."
    else if token == POLICY_ASK && mine.id != 0:
        market.charter.set_policy(market, mine, value - 2)
        changed = true
    else if token == HIRE_ASK && mine.id != 0:
        changed = market.charter.hire(game, market, mine, value - 1, market.day)
        note = ("You hire " + market.execs.label(mine) + ".") if changed else "You lack the credits."
    show(game, market)
    return changed

bool confirmed_m3(es.Game game, Market market, int token, Galaxy galaxy):
    Company c = market.by_id.get(selected, Company())
    Company mine = market.charter.mine(market)
    int d = market.day
    if token == BLOCK_OK && c.id != 0:
        market.board.block(game, market, c, d)
        note = "Your votes block the bid."
        return true
    if token == DEMAND_OK && c.id != 0:
        market.board.demand(game, market, c, d)
        note = ("The suitor raises its offer to " + fmt.price(c.offer) + ".") if c.suitor > 0 else "The suitor walks away."
        return true
    if token == PAYOUT_OK && c.id != 0:
        market.board.payout(game, market, c, pending_level, d)
        return true
    if token == DIRECT_OK && c.id != 0:
        market.board.direct(game, market, c, pending_level, d)
        return true
    if token == SELL_SUITOR_OK && c.id != 0:
        float got = market.board.sell(game, market, c, d)
        note = "Sold your stake for " + fmt.credits(got) + " credits."
        return got > 0.0
    if token == CHARTER_OK:
        Company made = market.charter.found(game, market, galaxy, pending_level, d)
        note = ("You charter " + made.name + ".") if made.id != 0 else "You can't charter a company now."
        if made.id != 0:
            selected = made.id
        return made.id != 0
    if mine.id == 0:
        return false
    if token == ASSIGN_OK:
        bool ok = market.charter.assign(game, market, mine, ship_choice)
        note = "Assigned." if ok else "That ship can't be assigned (your flagship, or not here)."
        return ok
    if token == UNASSIGN_OK:
        return market.charter.unassign(game, market, mine, ship_choice)
    if token == SELLSHIP_OK:
        bool ok = market.charter.sell_ship(game, market, mine, ship_choice)
        ship_choice = ""
        return ok
    if token == IPO_OK:
        float raised = market.charter.ipo(game, market, mine, d)
        note = "Listed: the company raises " + fmt.credits(raised) + " credits."
        return raised > 0.0
    if token == DISSOLVE_OK:
        float paid = market.charter.dissolve(game, market, mine, d)
        note = "Dissolved: " + fmt.credits(paid) + " credits are yours."
        return true
    return false
