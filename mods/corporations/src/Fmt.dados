class Fmt

// Numbers as the player reads them.

// "1,234,567": whole credits with thousands separators.
string credits(float value):
    int n = globalThis.Math.round(value)
    bool negative = n < 0
    string digits = string(-n if negative else n)
    string out = ""
    int i = digits.len()
    for i > 3:
        out = "," + digits[i - 3..<i] + out
        i -= 3
    out = digits[0..<i] + out
    return ("-" if negative else "") + out

// "12.34": a share price, to the hundredth.
string price(float value):
    int cents = globalThis.Math.round(value * 100.0)
    int whole = cents / 100
    int part = cents % 100
    return credits(float(whole)) + "." + ("0" if part < 10 else "") + string(part)

// "+3.4%" or "-12.0%".
string percent(float share):
    int tenths = globalThis.Math.round(share * 1000.0)
    bool negative = tenths < 0
    int t = -tenths if negative else tenths
    return ("-" if negative else "+") + string(t / 10) + "." + string(t % 10) + "%"

// "34%": a share, whole.
string whole_percent(float share):
    int n = globalThis.Math.round(share * 100.0)
    return string(n) + "%"

// "1.2M" or "850k": a large sum, short.
string short_credits(float value):
    float a = value if value >= 0.0 else -value
    string sign = "" if value >= 0.0 else "-"
    if a >= 1000000000.0:
        return sign + one_decimal(a / 1000000000.0) + "B"
    if a >= 1000000.0:
        return sign + one_decimal(a / 1000000.0) + "M"
    if a >= 1000.0:
        int k = globalThis.Math.round(a / 1000.0)
        return sign + string(k) + "k"
    int n = globalThis.Math.round(a)
    return sign + string(n)

string one_decimal(float value):
    int tenths = globalThis.Math.round(value * 10.0)
    return string(tenths / 10) + "." + string(tenths % 10)
