class Galaxy

import "imports:sdk/es"

// Human space as the market sees it, read from the game once a session:
// systems held by human governments, their lanes, the planets with a bank, and
// the planets with a shipyard.
// Who holds a system is read live (system_government), since wars and the
// story change it.

// Human space is every system reachable over the lanes from the human
// governments' systems without entering an alien one: so a system held by a
// government the market has never heard of (a rebel one, from Diplomacy) is
// human space if it lies there, and uninhabited systems inside it link the
// rest (jumps count through them). `alien` lists the governments that are not
// (the game's alien species and their client states); anything else counts as
// human once it is reached.
[]string human = ["Republic", "Free Worlds", "Syndicate", "Pirate", "Independent", "Militia", "Merchant", "Navy (Oathkeeper)", "Deep Security", "Neutral"]
// Alien governments, by the start of their name ("Hai" covers "Hai Merchant",
// "Kor" every Korath faction, "Quarg (Hai)" too, and so on).
[]string alien = ["Hai", "Quarg", "Kor", "Wanderer", "Remnant", "Coalition", "Heliarch", "Lunarium", "Ka'het", "Ka'sei", "Sheragi", "Pug", "Drak", "Bunrodea", "Gegno", "Avgi", "Incipias", "Successor", "Aberrant", "Rulei", "Ember Waste", "House ", "Old Houses", "New Houses", "People's Houses", "High Houses", "Hicemus", "Conlatio", "Alpha", "Indigenous", "Silent Ones", "Predecessor", "Builder", "Solitude", "Magic Asteroid", "Wormhole"]

bool is_alien(string government):
    for a in alien:
        if government.starts_with(a):
            return true
    return false

bool built = false
[]string systems = []
{string: int} index = {}
[][]int links = []
// Planets with a bank, and each one's system.
[]string planets = []
{string: string} planet_system = {}
// Planets in human space (systems held by a human government) whose shipyards
// sell ships (Mod API 9), as the session began: the only shipyards the market
// stocks. Any other shipyard, alien or human, stays untracked (unlimited). A
// planet that gains a shipyard during a session is stocked from the next one.
[]string yards = []
{string: bool} is_yard = {}
// Every planet in human space, for the monthly check for shipyards that
// opened since (Market.step).
[]string human_planets = []
// Systems with at least one bank planet, and the first such planet in each.
[]string served = []
{string: string} system_planet = {}
// Jumps from a system to every other (-1 = not reachable), by source.
{string: []int} distances = {}

void build(es.Game game):
    if built:
        return
    built = true
    // Seeds: the human governments' systems; then out over the lanes to every
    // system not held by an alien government.
    []string queue = []
    for i in 0..<game.system_count():
        string s = game.system_at(i)
        if human.contains(game.system_government(s)):
            index[s] = systems.len()
            systems.append(s)
            queue.append(s)
    int head = 0
    for head < queue.len():
        string at = queue[head]
        head += 1
        for k in 0..<game.link_count(at):
            string l = game.link(at, k)
            if l == "" || index.has(l) || is_alien(game.system_government(l)) || game.system_government(l) == "":
                continue
            index[l] = systems.len()
            systems.append(l)
            queue.append(l)
    for s in systems:
        []int out = []
        for k in 0..<game.link_count(s):
            string l = game.link(s, k)
            if index.has(l):
                out.append(index[l])
        links.append(out)
        bool any = false
        for k in 0..<game.planet_count(s):
            string p = game.planet_at(s, k)
            human_planets.append(p)
            if game.shipyard_count(p) > 0:
                yards.append(p)
                is_yard[p] = true
            if game.planet_service(p, "bank"):
                planets.append(p)
                planet_system[p] = s
                if !any:
                    system_planet[s] = p
                any = true
        if any:
            served.append(s)

// The system a planet is in, from what was read, or from the game.
string system_of(es.Game game, string planet):
    if planet_system.has(planet):
        return planet_system[planet]
    return game.planet_system(planet)

// Jumps from one system to another, or -1.
int jumps(string from, string to):
    if !index.has(from) || !index.has(to):
        return -1
    if !distances.has(from):
        distances[from] = bfs(index[from])
    []int d = distances[from]
    return d[index[to]]

// (M2) The systems a ship passes from `from` to `to`, one jump each, ending
// with `to` (not `from`); empty when they are the same or not linked. The
// path follows the cached distances to `to`: from each system, the first
// neighbour one jump closer.
[]string route(string from, string to):
    []string out = []
    if !index.has(from) || !index.has(to) || from == to:
        return out
    if !distances.has(to):
        distances[to] = bfs(index[to])
    []int d = distances[to]
    int at = index[from]
    if d[at] < 0:
        return out
    for d[at] > 0:
        int next = -1
        for n in links[at]:
            if d[n] == d[at] - 1:
                next = n
                break
        if next < 0:
            break
        at = next
        out.append(systems[at])
    return out

// (M2) The systems one jump from a system, in human space.
[]string neighbours(string system):
    []string out = []
    if !index.has(system):
        return out
    for n in links[index[system]]:
        out.append(systems[n])
    return out

[]int bfs(int start):
    []int dist = []
    for i in 0..<systems.len():
        dist.append(-1)
    dist[start] = 0
    []int queue = [start]
    int head = 0
    for head < queue.len():
        int at = queue[head]
        head += 1
        for next in links[at]:
            if dist[next] < 0:
                dist[next] = dist[at] + 1
                queue.append(next)
    return dist
