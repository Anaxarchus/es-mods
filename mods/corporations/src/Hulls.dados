class Hulls

// GENERATED by tools/make-hulls.mjs from the game's data/human ship files; do
// not edit by hand. Run: node mods/corporations/tools/make-hulls.mjs <endless-sky>/data
//
// Every human ship model: who owns its design (a canonical company's name, or
// "military"), its full new price (hull and outfits, as a shipyard charges),
// its category, and its hull class, which sets the stock a shipyard keeps and
// how long a restock takes. A model not in the table is left untracked:
// unlimited, as without the mod.

string MILITARY = "military"

// Hull classes: 0 CIVIL (transports and freighters), 1 LIGHT (interceptors, fighters and drones), 2 WARSHIP (light, medium and heavy warships), 3 CAPITAL (anything costing 8 million or more).
int CIVIL = 0
int LIGHT = 1
int WARSHIP = 2
int CAPITAL = 3
// The stock a shipyard keeps of a hull, and the base days a restock takes, by class.
[]int targets = [4, 3, 2, 1]
[]int lead_days = [12, 10, 20, 45]

