// Model -> its row; built on first use.
{string: int} rows = {}

// The row of a model, or -1 when the table does not know it.
int find(string model):
    if rows.len() == 0:
        for i in 0..<models.len():
            rows[models[i]] = i
    return rows.get(model, -1)

bool military(int row):
    return owners[row] == MILITARY

int target(int row):
    return targets[classes[row]]
