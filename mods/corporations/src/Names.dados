// (M3) Chief executives: names, and traits (Executives). Each trait moves a
// company's bid margins, its appetite for buyouts, its payout and its luck.
[]string first_names = ["Ada", "Bram", "Celia", "Dmitri", "Esme", "Farid", "Greta", "Hollis", "Ines", "Jonah", "Kaya", "Lucan", "Mira", "Nestor", "Odile", "Pavel", "Quinn", "Rosalind", "Silas", "Tamsin", "Ulric", "Vesna", "Wendell", "Xiomara", "Yusuf", "Zelda", "Anouk", "Bastian", "Corin", "Delphine", "Emeric", "Fen", "Gideon", "Halima", "Isidore", "Juno"]
[]string last_names = ["Achterberg", "Bellamy", "Castellan", "Draycott", "Ekwueme", "Fairweather", "Grisham", "Halvorsen", "Iwasaki", "Jaramillo", "Kowalczyk", "Lindqvist", "Marchetti", "Nakashima", "Okonkwo", "Pemberton", "Quaresma", "Rautenbach", "Szymanski", "Thibodeaux", "Umarov", "Vanterpool", "Whitlock", "Xenakis", "Yardley", "Zamorano", "Abernathy", "Baptiste", "Carrow", "Desrosiers", "Engstrom", "Fontaine"]
[]string traits = ["aggressive", "prudent", "visionary", "crooked"]

// A chief executive's name, from a number (the market's dice, or a company's
// id for a save from before M3).
string person(int n):
    int a = n % first_names.len()
    int b = (n / first_names.len()) % last_names.len()
    a = a if a >= 0 else -a
    b = b if b >= 0 else -b
    return first_names[a] + " " + last_names[b]

// A name for a new company in `sector`, not among `used`.
string invent(Rng rng, int sector, []string used):
    []string ends = suffixes[sector]
    for attempt in 0..<60:
        string name = prefixes[rng.range(0, prefixes.len() - 1)] + " " + ends[rng.range(0, ends.len() - 1)]
        if !used.contains(name):
            return name
    // Every pairing taken: number them.
    int n = 2
    string base = prefixes[rng.range(0, prefixes.len() - 1)] + " " + ends[0]
    for used.contains(base + " " + string(n)):
        n += 1
    return base + " " + string(n)
