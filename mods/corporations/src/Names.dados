[][]string suffixes = [["Shipworks", "Yards", "Drydocks", "Hullwrights"], ["Systems", "Instruments", "Arms", "Ordnance"], ["Propulsion", "Drives", "Thrust", "Engineworks"], ["Electronics", "Logic", "Photonics", "Signals"], ["Provisions", "Foods", "Goods", "Commodities"], ["Ore", "Mining", "Minerals", "Extraction"], ["Haulage", "Freight", "Lines", "Transit"], ["Security", "Guard", "Escort", "Watch"]]

// A name for a new company in `sector`, not among `used`.
string invent(Rng rng, int sector, []string used):
    []string ends = suffixes[sector]
    for attempt in 0..<60:
        string name = prefixes[rng.range(0, prefixes.len() - 1)] + " " + ends[rng.range(0, ends.len() - 1)]
        if !used.contains(name):
            return name
    // Every pairing taken: number them.
    int n = 2
    string base = prefixes[rng.range(0, prefixes.len() - 1)] + " " + ends[0]
    for used.contains(base + " " + string(n)):
        n += 1
    return base + " " + string(n)
