class Sanctions

import "imports:sdk/es"

// (M3) Diplomacy's wars reach the exchange (its README: "diplomacy: member",
// the wars, the flotillas):
// - embargo: a government at war tenders to, and contracts with, no company
//   whose home system its enemy holds (Market.award);
// - the player's faction (`diplomacy: member`, 1-3): their shares in its
//   enemies' companies are frozen (no buying, selling, shorting or board
//   votes) and TAX of those companies' dividends to them is withheld;
// - a company whose home system changes hands (Company.home_gov, checked each
//   day) loses CAPTURE_SHOCK of its price; a canonical one is rescued by its
//   new government (a state loan); another is nationalised NATIONALISE of the
//   time (delisted; holders get NATIONAL_PAY of the price; shorts close there);
// - blockade runs: within 1 to 4 jumps of a system under siege (a war flotilla
//   at its goal), a job carrying illegal supplies to a planet there
//   ("corporations: blockade <n>" = 1 on delivery: standing with its
//   companies, and news);
// - shortfall: for each Diplomacy side (Market.government_name) with military
//   shipyards, "corporations: shortfall <side>" = the share (0-100) of its
//   military shelves' targets that is missing, and the bus event
//   corporations.shortfall {side, government, shortfall} when it moves
//   SHORTFALL_STEP points or more (Diplomacy can make an under-supplied side
//   fight worse).

float TAX = 0.5
float CAPTURE_SHOCK = 0.8
float NATIONALISE = 30.0
float NATIONAL_PAY = 0.6
int SHORTFALL_STEP = 5
int MAX_SIDES = 23

// Counted since the mod started (not saved), for tests and tools.
int captures = 0
int nationalised = 0

// The player's faction's government ("" for none), read each day.
string member = ""

void refresh(es.Game game, Market m):
    member = m.government_name(game.condition("diplomacy: member")) if game.condition("diplomacy: active") != 0 else ""

// A company the government `client` will not deal with: its home is held by an enemy.
bool embargoed(Market m, Company c, string client):
    return c.home_gov != "" && m.enemies.has(client) && m.enemies[client].contains(c.home_gov)

// The player's shares in this company are frozen: their faction is at war with its home's government.
bool frozen(Market m, Company c):
    return member != "" && c.home_gov != "" && m.enemies.has(member) && m.enemies[member].contains(c.home_gov)

void daily(es.Game game, Galaxy galaxy, Market m, int d):
    refresh(game, m)
    for c in m.companies:
        if !c.listed() || c.system == "":
            continue
        string g = game.system_government(c.system)
        if c.home_gov == "":
            c.home_gov = g
        else if g != "" && g != c.home_gov:
            string old = c.home_gov
            c.home_gov = g
            captured(game, m, c, old, g, d)
    shortfall(game, m, d)
    settle(game, galaxy, m, d)

void captured(es.Game game, Market m, Company c, string old, string now, int d):
    captures += 1
    c.captured = d
    m.shock(c, CAPTURE_SHOCK)
    c.reliability = m.clamp(c.reliability - 0.05, 0.0, 0.99)
    c.note("after its home fell to the " + now)
    if c.canon || c.owner == 1 || !m.rng.chance(NATIONALISE):
        float loan = m.upkeep(c) * 60.0
        c.cash += loan
        c.debt += loan
        m.say_tagged(d, "The " + now + " takes " + c.system + " from the " + old + "; " + c.name + "'s shares fall, and its new masters back it with a state loan.", "w,c" + string(c.id))
        if m.holdings.get(c.id, 0) > 0:
            m.player_events.append(c.name + ", whose shares you hold, now answers to the " + now + ".")
        return
    nationalised += 1
    float per = c.price * NATIONAL_PAY
    int held = m.holdings.get(c.id, 0)
    if held > 0:
        m.credit(game, per * float(held))
        m.must_save = true
        m.player_events.append("The " + now + " nationalises " + c.name + ": your " + m.fmt.credits(float(held)) + " shares bring " + m.fmt.credits(per * float(held)) + " credits.")
        m.holdings.delete(c.id)
        m.basis.delete(c.id)
    m.shorts_desk.squeeze(game, m, c, per, "by its nationalisation")
    m.say_tagged(d, "The " + now + " nationalises " + c.name + " after taking " + c.system + "; holders get " + m.fmt.price(per) + " a share.", "w,c" + string(c.id))
    m.post_bus("corporations.nationalised", "{\"company\":" + m.json(c.name) + ",\"government\":" + m.json(now) + ",\"system\":" + m.json(c.system) + "}")
    m.release_contracts(c, d)
    c.status = c.NATIONALISED
    c.since = d
    c.capacity = 0.0
    c.price = per

// Each side's military supply shortfall, published.
void shortfall(es.Game game, Market m, int d):
    {string: int} need = {}
    {string: int} want = {}
    for s in m.military_shelves:
        string g = game.planet_government(s.planet)
        need[g] = need.get(g, 0) + (s.target - s.count if s.count < s.target else 0)
        want[g] = want.get(g, 0) + s.target
    for side in 1..=MAX_SIDES:
        string g = m.government_name(side)
        if g == "" || !want.has(g) || want[g] <= 0:
            // (M3 review) No shelves left: no shortfall.
            if game.condition("corporations: shortfall " + string(side)) != 0:
                game.set_condition("corporations: shortfall " + string(side), 0)
            continue
        int v = need[g] * 100 / want[g]
        string key = "corporations: shortfall " + string(side)
        int was = game.condition(key)
        if v == was:
            continue
        game.set_condition(key, v)
        int last = m.shortfall_posted.get(side, -100)
        if v - last >= SHORTFALL_STEP || last - v >= SHORTFALL_STEP:
            m.shortfall_posted[side] = v
            m.post_bus("corporations.shortfall", "{\"side\":" + string(side) + ",\"government\":" + m.json(g) + ",\"shortfall\":" + string(v) + "}")

// ---- Blockade runs ----

void offer(es.Game game, Galaxy galaxy, Market m):
    string planet = game.planet()
    if planet == "" || m.losses.besieged.len() == 0:
        return
    string here = galaxy.system_of(game, planet)
    for sys in m.losses.besieged:
        int j = galaxy.jumps(here, sys)
        string to = galaxy.system_planet.get(sys, "")
        if j < 1 || j > 4 || to == "" || !galaxy.index.has(sys):
            continue
        int n = galaxy.index[sys] + 1
        string key = "corporations: blockade " + string(n)
        if game.condition(key) != 0:
            continue
        int pay = 60000 + 15000 * j
        []string lines = []
        lines.append("name \"Run the blockade of " + sys + "\"")
        lines.append("description \"" + sys + " is under siege. Merchants on <destination> will pay <payment> for <cargo> brought through the lines by <date>. The besiegers will search any ship they can, and the cargo is contraband to them.\"")
        lines.append("cargo \"blockade supplies\" 10")
        lines.append("illegal " + string(pay / 2) + " \"The patrol finds the blockade supplies and fines you <fine> credits.\"")
        lines.append("destination \"" + to + "\"")
        lines.append("deadline " + string(j * 2 + 4))
        lines.append("on complete")
        lines.append("\tpayment " + string(pay))
        lines.append("\t\"" + key + "\" = 1")
        lines.append("\tdialog \"The merchants unload the supplies before the besiegers notice and pay you <payment>.\"")
        if game.offer_job("blockade " + string(n), lines.join("\n")):
            if !m.blockades.contains(string(n)):
                m.blockades.append(string(n))
            return

void settle(es.Game game, Galaxy galaxy, Market m, int d):
    []string keep = []
    for n in m.blockades:
        string key = "corporations: blockade " + n
        if game.condition(key) == 1:
            game.set_condition(key, 0)
            int i = n.to_int() - 1
            string sys = galaxy.systems[i] if i >= 0 && i < galaxy.systems.len() else ""
            for c in m.companies:
                if c.listed() && c.system == sys:
                    m.standing.add(game, c.id, 3)
            m.must_save = true
            m.say_tagged(d, "A blockade runner brings supplies into besieged " + sys + ".", "w")
            continue
        if m.losses.besieged.contains(galaxy.systems[n.to_int() - 1] if n.to_int() >= 1 && n.to_int() <= galaxy.systems.len() else ""):
            keep.append(n)
    m.blockades = keep
