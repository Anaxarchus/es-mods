{string: int} rows = {}

// A system's data price for a commodity: 0 when it has no market, -1 when
// the table does not know the system or commodity.
int base(string system, string commodity):
    if rows.len() == 0:
        for i in 0..<systems.len():
            rows[system_key(systems[i])] = i
    int row = rows.get(system_key(system), -1)
    int k = commodities.index_of(commodity) if commodities.contains(commodity) else -1
    if row < 0 || k < 0:
        return -1
    return prices[row * commodities.len() + k]

string system_key(string s):
    return s
