class Charts extends es.Mod

// Corsair Charts: pirate treasure trails (DESIGN.md). A pirate the player
// destroys or disables sometimes transmits a chart (a cargo item); on landing
// the player may follow it, through steps of six kinds, to a derelict cache
// whose hold and strongbox hold the reward. The parts:
//   Gen     builds a trail from a seed (and Rng, Galaxy, Cipher, Step, Trail)
//   Tables  names and reward tables (generated by tools/gen.py with the data)
//   Json    the saved state's JSON
// Mod API 11 is the floor: outfit_give and outfit_take carry the charts, the
// fragments, the manifest and the strongbox; ship_x, ship_y and ship_distance
// drive the scanner and the disable credit. Nothing of API 12 is used.

import "imports:sdk/es"

Tables tables = Tables()
Gen gen = Gen()
Json json = Json()
Rng dice = Rng()
Trail trail = Trail()

string name():
    return "corsair charts"

// The loader's API check (min_api, API 10 loaders; api_version for older ones).
int api_version():
    return 11

int min_api():
    return 11

string TAG = "charts."
float R = 0.95
float G = 0.72
float B = 0.25

// ---- The pilot's state (saved as JSON under "state") ----

int VERSION = 1
bool loaded = false
string last_text = ""
// The generator's state for charts dropping (saved, so a reload rolls the same).
int dice_state = 0
// Records: trails finished by tier, abandoned, charts found; the collection log.
[]int finished = [0, 0, 0, 0]
int abandoned = 0
int charts_found = 0
[]string found = []
// Whether the player declined the chart on this landing (not saved).
bool asked = false

// ---- This visit (not saved: landing or jumping clears the system) ----
// Pirates seen afloat (name|model), those credited as disabled, and the models
// credited, so their destruction afterwards is not counted again.
[]string afloat = []
[]string credited = []
[]string credited_models = []
// The scanner's last reading (-1: none yet), seconds since it last spoke.
int reading = -1
int quiet = 0
// The courier or the cache has been placed on this visit.
bool placed_here = false

// ---- Panels ----
// What each button of the open panel does, by index.
[]string actions = []
string screen = ""

// ---- Mod API checks ----
bool api_ok = false
bool checked = false

void check_api(es.Game game):
    if checked:
        return
    checked = true
    api_ok = false
    bool has = globalThis.Reflect.has(game, "has")
    if !has:
        return
    any g = game
    bool give = g.has("call:outfit_give")
    bool take = g.has("call:outfit_take")
    bool x = g.has("call:ship_x")
    bool y = g.has("call:ship_y")
    bool d = g.has("call:ship_distance")
    api_ok = give && take && x && y && d
    if !api_ok:
        log(game, "this game lacks outfit_give, outfit_take or ship positions (mod API 11): charts are off")

// ---- Loading and saving ----

void reset():
    trail.clear()
    dice_state = 0
    finished = [0, 0, 0, 0]
    abandoned = 0
    charts_found = 0
    found = []
    asked = false
    clear_visit()

void clear_visit():
    afloat = []
    credited = []
    credited_models = []
    reading = -1
    quiet = 0
    placed_here = false

string encode():
    []string f = []
    f.append("\"version\":" + string(VERSION))
    f.append("\"dice\":" + string(dice_state))
    f.append("\"finished\":" + json.ints(finished))
    f.append("\"abandoned\":" + string(abandoned))
    f.append("\"charts\":" + string(charts_found))
    f.append("\"found\":" + json.strs(found))
    f.append("\"trail\":" + trail.encode())
    return "{" + f.join(",") + "}"

void decode(string text):
    reset()
    any o = json.parse_object(text)
    dice_state = json.num(o, "dice", 0)
    []int fin = json.int_list(o, "finished")
    if fin.len() == 4:
        finished = fin
    abandoned = json.num(o, "abandoned", 0)
    charts_found = json.num(o, "charts", 0)
    found = json.str_list(o, "found")
    if json.has(o, "trail"):
        any t = o["trail"]
        trail.decode(t)

// Read the pilot's state when memory does not hold it: a new pilot, or a save
// of this one loaded again (the state text then differs from the last written).
void ensure(es.Game game):
    check_api(game)
    if !loaded || game.data("state") != last_text:
        loaded = true
        last_text = game.data("state")
        decode(last_text)

void write(es.Game game):
    last_text = encode()
    game.set_data("state", last_text)
    game.set_condition("corsair charts: trail", trail.tier + 1 if trail.active else 0)
    int total = 0
    for n in finished:
        total += n
    game.set_condition("corsair charts: trails finished", total)

void on_load(es.Game game):
    check_api(game)

void on_pilot_loaded(es.Game game):
    loaded = false
    checked = false
    reset()
    gen.galaxy.forget()
    ensure(game)

void on_save(es.Game game):
    ensure(game)

// ---- The generator ----

void seed_dice(es.Game game):
    if dice_state <= 0:
        dice.seed(game.day() * 7919 + dice.hash(game.here()) + 12345)
    else:
        dice.seed(dice_state)

int roll(es.Game game, int n):
    seed_dice(game)
    int r = dice.below(n)
    dice_state = dice.state
    return r

// ---- Charts dropping ----

bool is_pirate(string government):
    return government == "Pirate" || government == "Pirate (Rival)" || government == "Marauder"

// The tier a pirate hull's chart would be (3 only for the biggest).
int tier_of(es.Game game, string model):
    int cost = game.model_cost(model)
    if cost <= 0:
        string c = game.model_category(model)
        if c == "Heavy Warship":
            return 3
        if c == "Medium Warship" || c == "Heavy Freighter" || c == "Utility":
            return 2
        if c == "Light Warship":
            return 1
        return 0
    if cost < 1000000:
        return 0
    if cost < 3000000:
        return 1
    if cost < 9000000:
        return 2
    return 3

// Chance (per thousand) that a pirate of each tier drops a chart, and for the
// biggest, the share of those that are the elite chart.
[]int chance = [50, 70, 90, 120]
int elite_share = 25

// A pirate of this model was destroyed or disabled by the player: maybe it transmits a chart.
void maybe_chart(es.Game game, string model):
    int tier = tier_of(game, model)
    int r = roll(game, 1000)
    if r >= chance[tier]:
        write(game)
        return
    if tier == 3 && roll(game, 100) >= elite_share:
        tier = 2
    string clue = tables.clues[tier]
    int given = game.outfit_give(clue, 1, "cargo")
    if given <= 0:
        write(game)
        return
    charts_found += 1
    write(game)
    log(game, "a " + model + " dropped a " + clue)
    string who = game.model_name(model)
    if who == "":
        who = "pirate ship"
    game.message("The " + who + " transmitted a burst of mysterious coordinates before it went dark. Your computer saved them: a " + clue + " is in your hold.")

void watch_kills(es.Game game):
    int n = game.losses()
    for k in 0..<n:
        if !game.loss_by_player(k) || !is_pirate(game.loss_government(k)):
            continue
        string model = game.loss_model(k)
        if credited_models.contains(model):
            credited_models.remove_at(credited_models.index_of(model))
            continue
        maybe_chart(game, model)

// Pirates the player disables: seen afloat, then disabled near the flagship.
void watch_disabled(es.Game game):
    int me = game.flagship()
    if me < 0:
        return
    for i in 0..<game.ship_count():
        if game.is_player(i) || !is_pirate(game.ship_government(i)):
            continue
        string key = game.ship_name(i) + "|" + game.ship_model(i)
        if !game.is_disabled(i):
            if !afloat.contains(key):
                afloat.append(key)
            continue
        if !afloat.contains(key) || credited.contains(key):
            continue
        float d = game.ship_distance(i)
        if d < 0.0 || d > 4000.0:
            continue
        credited.append(key)
        credited_models.append(game.ship_model(i))
        maybe_chart(game, game.ship_model(i))

// ---- Starting, advancing, ending a trail ----

// The best chart the player has with them (cargo, or storage here), or -1.
int chart_held(es.Game game):
    int best = -1
    for c, i in tables.clues:
        if game.condition("outfit (cargo): " + c) > 0 || game.condition("outfit (storage): " + c) > 0:
            best = i
    return best

bool start_trail(es.Game game, int tier):
    if trail.active || tier < 0 || tier > 3:
        return false
    string clue = tables.clues[tier]
    if game.outfit_take(clue, 1, "any") <= 0:
        return false
    int seed = roll(game, 2000000000) + 1
    string from = game.here()
    Trail t = gen.make(game, tier, seed, from, found)
    trail = t
    write(game)
    log(game, "started a trail of tier " + string(tier) + ", " + string(t.steps.len()) + " steps, seed " + string(seed))
    refresh_map(game)
    return true

void advance(es.Game game, string said):
    if !trail.active:
        return
    trail.index += 1
    reading = -1
    quiet = 0
    placed_here = false
    if trail.index >= trail.steps.len():
        trail.index = trail.steps.len() - 1
    write(game)
    refresh_map(game)
    if said != "":
        game.message(said + " The chart leads on: " + trail.current().text)

// The manifest is aboard: open the strongbox, log the finds, end the trail.
void finish(es.Game game):
    []string got = []
    for item, i in trail.box_items:
        int n = trail.box_counts[i]
        if item == "Cloaking Device" && game.condition("outfit (all): Cloaking Device") > 0:
            item = tables.bond
            n = 20
        int given = game.outfit_give(item, n, "cargo")
        if given > 0:
            got.append(string(given) + " " + game.outfit_name(item) if given > 1 else game.outfit_name(item))
            if tables.exotics.contains(item) && !found.contains(item):
                found.append(item)
    finished[trail.tier] += 1
    trail.clear()
    write(game)
    refresh_map(game)
    string what = "The strongbox was empty."
    if got.len() > 0:
        what = "In the strongbox: " + got.join(", ") + "."
    game.message("The manifest's codes open the cache's strongbox. " + what + " The trail ends here.")

void abandon(es.Game game):
    if !trail.active:
        return
    trail.clear()
    abandoned += 1
    game.outfit_take(tables.fragment, 99, "any")
    game.outfit_take(tables.manifest, 99, "any")
    write(game)
    refresh_map(game)

// The collection log: exotics and prototype hulls the player has had.
void update_log(es.Game game):
    bool changed = false
    for x in tables.exotics:
        if !found.contains(x) && game.condition("outfit (all): " + x) > 0:
            found.append(x)
            changed = true
    for p in tables.prototypes:
        if !found.contains(p) && game.condition("ship model (all): " + p) > 0:
            found.append(p)
            changed = true
    if changed:
        write(game)

// Never soft-lock: a step whose system cannot be reached from here any more,
// or whose world can no longer be landed on, is generated again from here.
void keep_reachable(es.Game game):
    if !trail.active:
        return
    Step s = trail.current()
    string here = game.here()
    bool broken = s.kind == 0
    if !broken && here != "" && s.system != here:
        broken = gen.galaxy.jumps(game, here, s.system, 60) < 0
    if !broken && s.planet != "" && (s.kind == gen.QUESTION || s.kind == gen.LOCK) && game.planet() != "" && game.planet_system(s.planet) == here:
        broken = !gen.galaxy.can_land(game, s.planet)
    if broken:
        gen.reroute(game, trail, here)
        write(game)
        refresh_map(game)
        game.message("The trail has gone cold where it led. You work out another lead: " + trail.current().text)

// ---- Hooks ----

void on_enter(es.Game game, string system):
    ensure(game)
    if !api_ok:
        return
    clear_visit()
    update_log(game)
    keep_reachable(game)
    if game.planet() != "":
        landed(game)
    else:
        arrived(game, system)
    refresh_map(game)

void landed(es.Game game):
    asked = false
    take_items(game)
    show_button(game)
    if !trail.active:
        int c = chart_held(game)
        if c >= 0:
            offer(game, c)
        return
    Step s = trail.current()
    string p = game.planet()
    if s.kind == gen.CIPHER && s.planet != "" && s.planet == p:
        advance(game, "")
        main_panel(game, "You have found the world the cipher named. In a dockside locker under a false name you find the next leg of the chart.")
        return
    if (s.kind == gen.QUESTION || s.kind == gen.LOCK) && s.planet == p:
        main_panel(game, "")

void arrived(es.Game game, string system):
    if !trail.active:
        return
    Step s = trail.current()
    if trail.ambush_at == trail.index && !trail.ambushed && s.system == system:
        string rival = tables.rival_fleets[trail.tier]
        if rival != "" && game.spawn(rival, "", TAG + "rival", true) > 0:
            trail.ambushed = true
            write(game)
            game.message("Someone else has a copy of your chart. A rival treasure hunter jumps in, guns hot.")
    if s.system != system:
        return
    if s.kind == gen.RIDDLE || (s.kind == gen.CIPHER && s.planet == ""):
        advance(game, "This is the place the chart meant. Its next leg was hidden in a navigation beacon here.")
    else if s.kind == gen.SCAN:
        game.message("Your scanner picks up a faint signal somewhere in " + system + ".")
    else if s.kind == gen.COURIER:
        string fleet = tables.courier_fleets[trail.tier]
        if game.spawn(fleet, "", TAG + "courier", false) > 0:
            placed_here = true
            game.message("A pirate courier is here, and it has seen you.")
        else:
            // No courier could be placed: the fragment is found without one.
            advance(game, "The courier is gone, but it dropped what it carried.")
    else if s.kind == gen.FINALE:
        place_cache(game, system)

int most_placed = 4

void place_cache(es.Game game, string system):
    if trail.placed >= most_placed:
        trail.clear()
        abandoned += 1
        write(game)
        refresh_map(game)
        game.message("Only scattered debris is left of the cache in " + system + ". Whatever it held is gone, and the trail with it.")
        return
    int n = game.spawn(trail.finale_fleet, "", TAG + "cache", false)
    if n <= 0:
        // The cache could not be placed: the strongbox is opened all the same.
        finish(game)
        return
    trail.placed += 1
    placed_here = true
    log(game, "placed the cache " + trail.finale_fleet + " in " + system + " (" + string(trail.placed) + " of " + string(most_placed) + ")")
    string guard = tables.guard_fleets[trail.tier]
    if guard != "":
        game.spawn(guard, "", TAG + "guard", false)
    write(game)
    game.message("A derelict drifts in " + system + ", just where the chart said it would be." + (" It is not unguarded." if guard != "" else ""))

// Fragments and the manifest the player carries move the trail on.
void take_items(es.Game game):
    if !trail.active:
        game.outfit_take(tables.fragment, 99, "cargo")
        return
    Step s = trail.current()
    if s.kind == gen.COURIER && game.outfit_take(tables.fragment, 1, "cargo") > 0:
        advance(game, "You pry the " + tables.fragment + " out of the courier's hold.")
    else if s.kind == gen.FINALE && game.outfit_take(tables.manifest, 1, "cargo") > 0:
        finish(game)

void on_step(es.Game game, int step):
    ensure(game)
    if !api_ok || game.planet() != "":
        return
    watch_kills(game)
    if step % 30 == 0:
        watch_disabled(game)
        take_items(game)
    if step % 60 == 0:
        scanner(game)

// ---- The scanner (hot and cold) ----

[]int scan_steps = [5000, 3000, 1600, 800, 350]
[]string scan_words = ["The scanner is silent.", "The scanner reads cold.", "The scanner reads cool.", "The scanner reads warm.", "The scanner reads hot.", "The scanner is burning!"]
float found_at = 250.0

void scanner(es.Game game):
    if !trail.active:
        return
    Step s = trail.current()
    if s.kind != gen.SCAN || game.here() != s.system:
        return
    int me = game.flagship()
    if me < 0:
        return
    float dx = game.ship_x(me) - float(s.x)
    float dy = game.ship_y(me) - float(s.y)
    float d = globalThis.Math.sqrt(dx * dx + dy * dy)
    if d <= found_at:
        int bonds = tables.scan_bonds[trail.tier]
        int got = game.outfit_give(tables.bond, bonds, "cargo")
        string what = "" if got <= 0 else " Inside, " + string(got) + " " + (tables.bond + "s" if got > 1 else tables.bond) + " and"
        advance(game, "Your scanner leads you to a small sealed canister." + what + " the next leg of the chart.")
        return
    int level = 0
    for t in scan_steps:
        if d < float(t):
            level += 1
    quiet += 1
    if level != reading || quiet >= 15:
        bool closer = reading >= 0 && level > reading
        bool farther = reading >= 0 && level < reading
        reading = level
        quiet = 0
        string word = scan_words[level]
        if closer:
            word += " Warmer."
        else if farther:
            word += " Colder."
        game.message(word)

// ---- The map ----

void refresh_map(es.Game game):
    game.map_clear()
    if !trail.active:
        return
    Step s = trail.current()
    string title = "Corsair chart (" + tables.clues[trail.tier] + ")"
    string body = "Step " + string(trail.index + 1) + " of " + string(trail.steps.len()) + ". " + s.text
    if s.kind == gen.CIPHER || s.kind == gen.RIDDLE:
        string at = s.region if s.region != "" else trail.origin
        game.map_ring(at, 1.5, R, G, B)
        game.map_label(at, "chart: within " + string(s.radius) + " jumps", R, G, B)
        game.map_detail(at, title, body + (" " + s.hint if s.kind == gen.CIPHER else ""), R, G, B)
    else:
        game.map_marker(s.system, R, G, B, "chart")
        game.map_detail(s.system, title, body, R, G, B)

// ---- Panels ----

void show_button(es.Game game):
    if trail.active || chart_held(game) >= 0 || found.len() > 0 || charts_found > 0:
        game.planet_button("Corsair Charts")
    else:
        game.planet_button("")

void open(es.Game game, string id, string title, string text):
    screen = id
    actions = []
    game.panel_open(title, text)

void button(es.Game game, string label, string action):
    game.panel_button(label)
    actions.append(action)

void offer(es.Game game, int tier):
    string clue = tables.clues[tier]
    open(game, "offer", "A pirate's chart", "Among your cargo is a " + clue + ". Its coordinates lead somewhere, if you are willing to follow them. Investigate?")
    button(game, "Investigate", "start:" + string(tier))
    button(game, "Not now", "close")

void main_panel(es.Game game, string news):
    if !trail.active:
        int c = chart_held(game)
        string text = "You are not following a chart."
        if c >= 0:
            text += " You carry a " + tables.clues[c] + "."
        text += " " + record_line()
        open(game, "main", "Corsair Charts", text)
        if c >= 0:
            button(game, "Follow the " + tables.clues[c], "start:" + string(c))
        button(game, "Collection log", "log")
        button(game, "Close", "close")
        return
    Step s = trail.current()
    string text = ""
    if news != "":
        text += news + "\n\n"
    text += "You are following a " + tables.clues[trail.tier] + ". Step " + string(trail.index + 1) + " of " + string(trail.steps.len()) + ".\n\n" + s.text
    if s.hint != "":
        text += "\n\n" + s.hint
    string p = game.planet()
    bool here = s.planet != "" && s.planet == p
    if s.kind == gen.QUESTION && here:
        text += "\n\nThe informant is waiting for your answer."
        if s.tries > 0:
            text += " (Wrong answers so far: " + string(s.tries) + " of 3.)"
    open(game, "main", "Corsair Charts", text)
    if s.kind == gen.QUESTION && here:
        button(game, "Answer the informant", "answer")
    if s.kind == gen.LOCK && here:
        button(game, "Work the lock", "lock")
    button(game, "Seek another lead", "reroute")
    button(game, "Abandon the trail", "abandon")
    button(game, "Collection log", "log")
    button(game, "Close", "close")

string record_line():
    int total = 0
    for n in finished:
        total += n
    return "Trails followed to the end: " + string(total) + "."

void lock_panel(es.Game game, string news):
    Step s = trail.current()
    string text = ""
    if news != "":
        text += news + "\n\n"
    text += "The dials read " + s.digits(s.dials) + ". The chart's combination is " + s.digits(s.target) + ".\n\n" + s.hint
    open(game, "lock", "The strongroom lock", text)
    for i in 0..<s.dials.len():
        button(game, "Turn dial " + string(i + 1), "turn:" + string(i))
    button(game, "Start over", "reset")
    button(game, "Step back", "back")

void log_panel(es.Game game):
    open(game, "log", "Collection log", "What the charts have given up so far. Unknown finds are shown by tier only.")
    game.panel_columns("Find\tTier\tFound")
    for x, i in tables.exotics:
        bool have = found.contains(x)
        game.panel_row((x if have else "???") + "\t" + tables.clues[tables.exotic_tier[i]].replace_all(" Star Chart", "") + "\t" + ("yes" if have else ""))
    for p, i in tables.prototypes:
        bool have = found.contains(p)
        game.panel_row((p + " (prototype hull)" if have else "??? (prototype hull)") + "\t" + tables.clues[tables.prototype_tier[i]].replace_all(" Star Chart", "") + "\t" + ("yes" if have else ""))
    button(game, "Back", "back")

void on_planet_button(es.Game game):
    ensure(game)
    if !api_ok:
        return
    main_panel(game, "")

void on_panel(es.Game game, int index):
    ensure(game)
    if index < 0 || index >= actions.len():
        return
    string a = actions[index]
    if a == "close":
        game.panel_close()
        return
    if a.starts_with("start:"):
        int tier = int(globalThis.Number(a[6..<a.len()]))
        if start_trail(game, tier):
            show_button(game)
            main_panel(game, "You decode the first leg of the chart.")
        else:
            game.panel_close()
        return
    if a == "log":
        log_panel(game)
        return
    if a == "back":
        main_panel(game, "")
        return
    if a == "answer":
        Step s = trail.current()
        if s.kind == gen.QUESTION:
            game.ask_number(s.text, 1, 99)
        return
    if a == "lock":
        lock_panel(game, "")
        return
    if a == "reroute":
        game.confirm("Give up on this step and look for another lead from here? The rest of the trail stays as it is.", 2)
        return
    if a == "abandon":
        game.confirm("Abandon this trail? The chart is lost.", 1)
        return
    if a == "reset":
        trail.current().reset_lock()
        write(game)
        lock_panel(game, "You spin the dials back to where you found them.")
        return
    if a.starts_with("turn:"):
        Step s = trail.current()
        if s.kind != gen.LOCK:
            return
        int i = int(globalThis.Number(a[5..<a.len()]))
        s.turn(i)
        if s.solved():
            advance(game, "")
            main_panel(game, "The last dial clicks home and the strongroom door swings open. Inside is the next leg of the chart.")
            return
        write(game)
        lock_panel(game, "")

void on_confirm(es.Game game, int token):
    ensure(game)
    if token == 1:
        abandon(game)
        main_panel(game, "")
    else if token == 2:
        if trail.active:
            gen.reroute(game, trail, game.here())
            write(game)
            refresh_map(game)
            main_panel(game, "You ask around and piece together another lead.")

void on_number(es.Game game, int token, int value):
    ensure(game)
    if token != 1 || !trail.active:
        return
    Step s = trail.current()
    if s.kind != gen.QUESTION:
        return
    if value == s.answer:
        advance(game, "")
        main_panel(game, "The informant nods, and tells you where the trail goes next.")
        return
    s.tries += 1
    if s.tries >= 3:
        Rng rng = Rng()
        rng.seed(trail.seed + 31 * s.tries + 977 * trail.index + value)
        s.tries = 0
        gen.ask(game, rng, trail.tier, s, s.system)
        write(game)
        main_panel(game, "\"Wrong again. Here, try this one instead.\"")
        return
    write(game)
    main_panel(game, "\"That's not it,\" the informant says.")
