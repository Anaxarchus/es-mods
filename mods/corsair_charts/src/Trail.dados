class Trail

// The trail being followed (one at a time), as generated by Gen, and where the
// player is on it. Saved with the pilot as part of the mod's state.

Json json = Json()

bool active = false
int tier = 0
int seed = 0
// The system the chart was opened in (the first step's search starts there).
string origin = ""
[]Step steps = []
int index = 0
// The step whose system a rival ambushes the player in (-1: none), and whether it has.
int ambush_at = -1
bool ambushed = false
// The finale: the cache's fleet, the prototype it is ("" for none), how many
// times it has been placed, and the strongbox's contents.
string finale_fleet = ""
string proto = ""
int placed = 0
[]string box_items = []
[]int box_counts = []
int started = 0
int reroutes = 0

void clear():
    active = false
    tier = 0
    seed = 0
    origin = ""
    steps = []
    index = 0
    ambush_at = -1
    ambushed = false
    finale_fleet = ""
    proto = ""
    placed = 0
    box_items = []
    box_counts = []
    started = 0
    reroutes = 0

Step current():
    if index >= 0 && index < steps.len():
        return steps[index]
    return Step()

bool at_finale():
    return active && index == steps.len() - 1

string encode():
    []string parts = []
    for s in steps:
        parts.append(s.encode())
    []string f = []
    f.append("\"active\":" + ("true" if active else "false"))
    f.append("\"tier\":" + string(tier))
    f.append("\"seed\":" + string(seed))
    f.append("\"origin\":" + json.str(origin))
    f.append("\"steps\":[" + parts.join(",") + "]")
    f.append("\"index\":" + string(index))
    f.append("\"ambush_at\":" + string(ambush_at))
    f.append("\"ambushed\":" + ("true" if ambushed else "false"))
    f.append("\"finale_fleet\":" + json.str(finale_fleet))
    f.append("\"proto\":" + json.str(proto))
    f.append("\"placed\":" + string(placed))
    f.append("\"box_items\":" + json.strs(box_items))
    f.append("\"box_counts\":" + json.ints(box_counts))
    f.append("\"started\":" + string(started))
    f.append("\"reroutes\":" + string(reroutes))
    return "{" + f.join(",") + "}"

void decode(any o):
    clear()
    active = json.flag(o, "active", false)
    tier = json.num(o, "tier", 0)
    if tier < 0 || tier > 3:
        tier = 0
    seed = json.num(o, "seed", 0)
    origin = json.text(o, "origin", "")
    for so in json.objects(o, "steps"):
        Step s = Step()
        s.decode(so)
        steps.append(s)
    index = json.num(o, "index", 0)
    ambush_at = json.num(o, "ambush_at", -1)
    ambushed = json.flag(o, "ambushed", false)
    finale_fleet = json.text(o, "finale_fleet", "")
    proto = json.text(o, "proto", "")
    placed = json.num(o, "placed", 0)
    box_items = json.str_list(o, "box_items")
    box_counts = json.int_list(o, "box_counts")
    started = json.num(o, "started", 0)
    reroutes = json.num(o, "reroutes", 0)
    if box_counts.len() != box_items.len():
        box_items = []
        box_counts = []
    // A trail that does not hold together is dropped rather than followed.
    if active && (steps.len() == 0 || index < 0 || index >= steps.len()):
        clear()
