class Admirals

// The named commanders who lead each side's flotillas and raids. Each side
// keeps a roster of tune.admirals_per_side, in World.admirals as a flat
// [name, personality, wins] per place:
//   name         1 + the index of their surname in the side's list (0 = vacant)
//   personality  1 bold, 2 cautious, 3 methodical, 4 reckless
//   wins         battles they won and raids or hunts they finished
// A vacant post is filled with a new commander when one is needed. A commander
// whose flotilla is destroyed may die (tune.admiral_death_chance).

Tuning tune = Tuning()
Factions factions = Factions()
World world = World()
Rng rng = Rng()

void wire(Tuning t, Factions f, World w, Rng r):
    tune = t
    factions = f
    world = w
    rng = r

[]int roster(int side):
    if side < 0 || side >= world.admirals.len():
        return []
    []int r = world.admirals[side]
    if r.len() < tune.admirals_per_side * 3:
        r.resize(tune.admirals_per_side * 3)
        world.admirals[side] = r
    return r

int field(int side, int k, int f):
    if k < 1 || k > tune.admirals_per_side:
        return 0
    return roster(side)[(k - 1) * 3 + f]

void put(int side, int k, int f, int value):
    if k < 1 || k > tune.admirals_per_side:
        return
    []int r = roster(side)
    r[(k - 1) * 3 + f] = value

bool filled(int side, int k):
    return field(side, k, 0) != 0

string surname(int side, int k):
    int n = field(side, k, 0)
    []string list = factions.surname_list(side)
    if n <= 0 || n > list.len():
        return ""
    return list[n - 1]

// "Adm. Okafor", for map labels.
string short_name(int side, int k):
    if !filled(side, k):
        return ""
    return factions.commander_abbrev(side) + " " + surname(side, k)

// "Admiral Okafor", for messages and panels.
string full_name(int side, int k):
    if !filled(side, k):
        return ""
    return factions.commander_title(side) + " " + surname(side, k)

int personality(int side, int k):
    return field(side, k, 1) if filled(side, k) else 0

string personality_name(int side, int k):
    return factions.personalities[personality(side, k)]

int wins(int side, int k):
    return field(side, k, 2)

void add_win(int side, int k):
    if filled(side, k):
        put(side, k, 2, wins(side, k) + 1)

// A commander for a new flotilla of `side`: a free one from the roster (not
// leading any of `busy`), filling a vacant post if need be; 0 if all are taken.
int pick(int side, []int busy):
    []int free = []
    int vacant = 0
    for k in 1..=tune.admirals_per_side:
        if !filled(side, k):
            if vacant == 0:
                vacant = k
        else if !busy.contains(k):
            free.append(k)
    if free.len() > 0:
        return free[rng.range(0, free.len() - 1)]
    if vacant == 0:
        return 0
    appoint(side, vacant)
    return vacant

void appoint(int side, int k):
    []int taken = []
    for j in 1..=tune.admirals_per_side:
        if j != k:
            taken.append(field(side, j, 0))
    []int choices = []
    for n in 1..=factions.surname_list(side).len():
        if !taken.contains(n):
            choices.append(n)
    int name = choices[rng.range(0, choices.len() - 1)] if choices.len() > 0 else 1
    put(side, k, 0, name)
    put(side, k, 1, rng.range(1, 4))
    put(side, k, 2, 0)

// The flotilla commander k led was destroyed. Answers true if they died.
bool fallen(int side, int k):
    if !filled(side, k) || !rng.chance(tune.admiral_death_chance):
        return false
    put(side, k, 0, 0)
    put(side, k, 1, 0)
    put(side, k, 2, 0)
    world.stat("commanders killed", 1)
    return true

// A side's roster is dissolved (a rebel faction that is gone).
void dissolve(int side):
    if side >= 0 && side < world.admirals.len():
        world.admirals[side] = []

int attack(int side, int k):
    int p = personality(side, k)
    if p == 1:
        return tune.bold_attack
    if p == 4:
        return tune.reckless_attack
    return 100

int damage_taken(int side, int k):
    int p = personality(side, k)
    if p == 2:
        return tune.cautious_damage
    if p == 4:
        return tune.reckless_damage
    return 100

int siege(int side, int k):
    return tune.methodical_siege if personality(side, k) == 3 else 100
