class Diplomacy extends es.Mod

// Diplomacy: once the Free Worlds campaign is over, the Republic, the Free
// Worlds and the Syndicate compete for the minor regions of human space; wars
// over them run side by side, regions rise against their rulers or go over to
// a neighbour, and named commanders lead the fleets. See README.md and
// DESIGN.md. This class wires the parts together and routes the game's hooks:
//   Tuning      every tunable number
//   Regions     the minors (generated by tools/regions/build.mjs)
//   Factions    the sides: majors, pirates and rebel factions
//   World       the state, saved as JSON with the pilot (Game.data)
//   State       the conditions shared with missions and other plugins
//   Json, Rng   reading and writing the state; a deterministic random generator
//   Galaxy      lanes, cached distances, ownership and the minors' holdings
//   Garrisons   the defenders of besieged systems
//   Flotilla, War   one flotilla or raid; one war
//   Admirals    the named commanders and their personalities
//   Quality     the sim score: what a strength point is worth, from fleet stats
//   Changes     the day's world changes, sent as one event
//   Chronicle   the chronicle, the daily digest, the history and medals
//   Politics    unrest, rebellion, defection, wars declared and ended
//   Simulation  flotillas, raids, battles, sieges and captures
//   Operations  jobs from the live war, and what they do to it
//   Battlefield the ships the player finds in person
//   Service     the faction panel, the War Room, membership, merit and salary
//   MapView     the map overlay

import "imports:sdk/es"

Tuning tune = Tuning()
Factions factions = Factions()
World world = World()
State state = State()
Rng rng = Rng()
Galaxy galaxy = Galaxy()
Garrisons garrisons = Garrisons()
Admirals admirals = Admirals()
Quality quality = Quality()
Changes changes = Changes()
Chronicle chronicle = Chronicle()
Politics politics = Politics()
Simulation sim = Simulation()
Operations ops = Operations()
Battlefield field = Battlefield()
Service service = Service()
MapView overlay = MapView()
Intel intel = Intel()
Occupation occupation = Occupation()
Rivals rivals = Rivals()
Squadron squadron = Squadron()
Json json = Json()

void init():
    galaxy.wire(tune, factions)
    rng.wire(world)
    state.wire(tune, factions, galaxy, world)
    garrisons.wire(tune, world)
    admirals.wire(tune, factions, world, rng)
    quality.wire(tune, factions)
    chronicle.wire(tune, factions, galaxy, world)
    politics.wire(tune, factions, galaxy, world, rng, garrisons, admirals, changes, chronicle)
    sim.wire(tune, factions, galaxy, world, rng, garrisons, admirals, quality, politics, chronicle)
    ops.wire(tune, factions, galaxy, world, rng, garrisons, sim, chronicle)
    field.wire(tune, factions, galaxy, world, garrisons, sim)
    service.wire(tune, factions, galaxy, state, world, garrisons, sim, chronicle)
    overlay.wire(factions, galaxy, world, garrisons, sim)
    intel.wire(tune, factions, galaxy, world)
    occupation.wire(tune, factions, galaxy, world, changes)
    rivals.wire(tune, factions, world, rng, admirals, chronicle)
    squadron.wire(tune, factions, galaxy, world, admirals, quality, sim, chronicle)
    squadron.wire_intel(intel)
    sim.wire_intel(intel)
    sim.wire_rivals(rivals)
    politics.wire_occupation(occupation)
    ops.wire_m2(intel, occupation, rivals)
    overlay.wire_intel(intel)
    service.wire_m2(squadron, intel)

string name():
    return "diplomacy"

// The mod API this mod needs: 9 (tables, screens and charts, jobs, storage,
// map rings and labels). Both say 9, whatever the SDK it is built with: loader
// 0.1.0 checks only api_version and refuses a newer one, and a loader of mod
// API 10 checks min_api. The API 10 calls (the notification bus, on_pilot_loaded)
// are used only where the game has them (Game.has, checked through Reflect).
int api_version():
    return 9

int min_api():
    return 9

// ---- The state of the pilot loaded ----

// The world in memory belongs to the pilot whose stored "world" and "rev"
// these are, as last read or saved. A revision is "<n>.<session>": n is a
// high-water mark that only grows in a game session (never reset on a load),
// and the session token is drawn once per game session, so no two save
// histories of a pilot share a revision (as Corporations does). "world" is a
// random number drawn when the world is made, so two pilots never share one.
string loaded_world = "?"
string loaded_rev = "?"
int rev_high = 0
string session = ""

// Make sure the world in memory is the loaded pilot's: read it again when
// another pilot (or an older save of this one) is loaded. An active pilot
// without a saved world was made by the old version: migrate it.
void prepare(es.Game game):
    galaxy.build(game)
    check_api(game)
    string w = game.data("world")
    string r = game.data("rev")
    if w == loaded_world && r == loaded_rev && w != "":
        return
    state.forget()
    field.reset()
    chronicle.digest = []
    changes.discard()
    if w != "" && world.decode(game.data("state"), factions.regions.count(), factions.sides()):
        loaded_world = w
        loaded_rev = r
        // What is in memory is the save now: nothing to write until it changes.
        dirty = false
        // M1 rosters (three fields a place) are widened now.
        for s in 0..<world.admirals.len():
            admirals.roster(s)
        galaxy.refresh(game)
        return
    world.reset(factions.regions.count(), factions.sides())
    loaded_world = ""
    loaded_rev = ""
    world.world = 0
    if state.get(game, "active") != 0:
        migrate(game)

// A revision no save history of this pilot has used.
string next_rev():
    if session == "":
        float r = globalThis.Math.random()
        int token = int(r * 2000000000.0)
        session = string(token)
    rev_high += 1
    return string(rev_high) + "." + session

// Keep the state. With mod API 10's on_save the game asks for it just before
// it writes the pilot, so a day only marks it dirty: the first change after a
// save writes a new revision (not the state), so a save loaded later never
// looks like the world in memory. On API 9 it is written every time.
bool dirty = false

void save(es.Game game):
    if world.world == 0:
        return
    // (A new world is written at once: the revision alone means nothing yet.)
    if save_hook && loaded_world == string(world.world):
        if !dirty:
            dirty = true
            string mark = next_rev()
            game.set_data("rev", mark)
            loaded_rev = mark
        return
    write(game)

void on_save(es.Game game):
    if world.world == 0 || !dirty:
        return
    write(game)

void write(es.Game game):
    dirty = false
    world.rev += 1
    string rev = next_rev()
    game.set_data("state", world.encode())
    game.set_data("world", string(world.world))
    game.set_data("rev", rev)
    loaded_world = string(world.world)
    loaded_rev = rev

// ---- Mod API 10, guarded: the mod runs on loader 0.1.0 (API 9) too ----

bool checked_api = false

// Whether the game object has a call; an API 9 game has no `has`.
bool host_has(es.Game game, string call):
    bool exists = globalThis.Reflect.has(game, call)
    return exists

void check_api(es.Game game):
    if checked_api:
        return
    checked_api = true
    if !host_has(game, "has"):
        return
    any g = game
    bool bus = g.has("notify")
    chronicle.bus = bus
    bool trade = g.has("trade_price")
    occupation.api_trade = trade
    bool parking = g.has("ship_parking")
    squadron.api_parked = parking
    bool outfits = g.has("outfit_stock")
    occupation.api_outfits = outfits
    bool hook = g.has("on_save")
    save_hook = hook
    bool sections = g.has("timing_section")
    timing = sections

bool save_hook = false
bool timing = false

// Name the part of the hook that runs from now, for API 10's timing report.
void section(es.Game game, string name):
    if !timing:
        return
    any g = game
    g.timing_section(name)

// ---- The Corporations link (mod API 10's bus) ----

int side_of_government(string government):
    for s in 1..=3:
        if factions.governments[s] == government:
            return s
    return 0

bool at_war(int s):
    for w in world.wars:
        if w.a == s || w.b == s:
            return true
    return false

// A system where a war is fought: held by a side at war, or with a flotilla near.
bool war_zone(int i):
    if i < 0:
        return false
    if at_war(galaxy.owner(i)):
        return true
    for x in world.fleets:
        if x.alive() && galaxy.jumps(x.at, i) <= 1:
            return true
    return false

void on_notification(es.Game game, string name, string payload, string sender):
    if !name.starts_with("corporations.") || !active(game):
        return
    any o = json.parse_object(payload)
    int day = world.day
    if name == "corporations.tender_delivered":
        // Warships delivered: the government's next flotilla goes out stronger,
        // at most once in tender_gap days (an award alone does nothing).
        int s = side_of_government(json.str(o, "government", ""))
        if s > 0 && (world.boost_day[s] == 0 || day - world.boost_day[s] >= tune.tender_gap):
            world.boost[s] = 1
            world.boost_day[s] = day
    else if name == "corporations.tender_failed":
        int s = side_of_government(json.str(o, "government", ""))
        if s > 0:
            world.penalty[s] = 1
    else if name == "corporations.bankrupt":
        string company = json.str(o, "company", "a company")
        int hit = 0
        for s in 1..=3:
            if at_war(s):
                world.defeat[s] += tune.scandal_unrest * 10
                hit += 1
        if hit > 0:
            chronicle.add(game, day, "Scandal: " + company + " has gone bankrupt owing the war ministries; the profiteering stirs unrest at home.", false, true)
    else if name == "corporations.convoy_lost":
        int i = galaxy.find(json.str(o, "system", ""))
        if war_zone(i):
            string owner = json.str(o, "owner", "a shipyard")
            chronicle.add(game, day, "A convoy of new hulls for " + owner + " was lost near " + galaxy.name(i) + ", in the war zone.", false, true)
    else if name == "corporations.crisis":
        reserve(o, day)
    else if name == "corporations.shortfall":
        int s = json.num(o, "side", 0)
        int v = json.num(o, "shortfall", 0)
        if s >= 1 && s < world.shortfall.len():
            world.shortfall[s] = v if v >= 0 && v <= 100 else (0 if v < 0 else 100)
    save(game)

// Corporations' shortfall conditions (M3), on any API: read each day for the
// sides with flotillas (majors and rebels).
void read_shortfall(es.Game game):
    if !occupation.corporations:
        return
    for s in 1..<world.shortfall.len():
        if s == factions.pirates():
            continue
        int v = game.condition("corporations: shortfall " + string(s))
        world.shortfall[s] = v if v >= 0 && v <= 100 else (0 if v < 0 else 100)

// Corporations raised prices in a system and next to it: leave them alone
// until the crisis is over (with a margin).
void reserve(any o, int day):
    int i = galaxy.find(json.str(o, "system", ""))
    if i < 0:
        return
    int days = json.num(o, "days", 30)
    days = 0 if days < 0 else (365 if days > 365 else days)
    int until = day + days + tune.crisis_margin
    []string goods = []
    if !json.has(o, "commodities"):
        return
    any list = o["commodities"]
    bool is_list = globalThis.Array.isArray(list)
    if !is_list:
        return
    // Only the goods whose prices this mod moves matter; anything else is skipped.
    int n = list.length
    for k in 0..<n:
        any c = list[k]
        if !json.is_string(c):
            continue
        string cs = c
        if tune.damaged_goods.contains(cs) && !goods.contains(cs):
            goods.append(cs)
    for j in 0..<galaxy.count():
        if j == i || galaxy.jumps(i, j) == 1:
            for c in goods:
                if world.reserved.len() < tune.reserved_cap:
                    world.reserved.append(galaxy.name(j) + "|" + c + "|" + string(until))

// (Mod API 10.) Another pilot was loaded: read its world, whatever the revisions say.
void on_pilot_loaded(es.Game game):
    loaded_world = "?"
    loaded_rev = "?"

// A fresh world from today.
void begin(es.Game game, int day):
    world.reset(factions.regions.count(), factions.sides())
    float r = globalThis.Math.random()
    world.world = int(r * 2000000000.0) + 1
    world.activated = day
    world.day = day
    rng.seed(day, 0)
    world.story[0] = day + rng.range(tune.first_war_min, tune.first_war_max)
    world.story[4] = day
    galaxy.refresh(game)
    state.put(game, "activated", day)
    state.put(game, "last day", day)

// A pilot of the old version (its state all in conditions): its standing is
// kept (active, member, merit, rank, licenses, salary), the old war state is
// cleared, borders stay where they are, and a new world starts today.
void migrate(es.Game game):
    int day = game.day()
    state.clear_v1(game)
    for f in 1..=3:
        for g in 1..=3:
            if f != g:
                changes.attitude(factions.flotilla_governments[f], factions.flotilla_governments[g], 0)
    begin(game, day)
    world.stat("migrated", 1)
    log(game, "migrated a pilot from the old version: standing kept, the war state started afresh")
    changes.flush(game)
    save(game)

// ---- Debug mode ----

bool debug = false

void check_debug(es.Game game):
    bool on = game.plugin_enabled(tune.debug_plugin)
    if on == debug:
        return
    debug = on
    if on:
        tune.launch_chance = tune.debug_launch_chance
        tune.truce_min_days = tune.debug_truce_days
        tune.truce_max_days = tune.debug_truce_days
        tune.raid_chance = tune.debug_raid_chance
        tune.verbose = true
        log(game, "debug mode on")

bool snoozed = false

// Whether the diplomacy runs for this pilot (opt-in once the campaign is over;
// a test override or debug mode turns it on without asking).
bool active(es.Game game):
    if game.here() == "":
        service.offering = false
        return false
    check_debug(game)
    prepare(game)
    if state.get(game, "active") != 0:
        service.offering = false
        ensure_attitudes(game)
        if debug:
            debug_war(game, game.day())
        return true
    if state.get(game, "force active") != 0 || debug:
        activate(game)
        return true
    service.offering = offer_wanted(game)
    return false

bool offer_wanted(es.Game game):
    return game.condition("free worlds plot completed") != 0 && state.get(game, "declined") == 0

void activate(es.Game game):
    int day = game.day()
    service.offering = false
    state.put(game, "active", 1)
    begin(game, day)
    log(game, "active from day " + string(day))
    ensure_attitudes(game)
    luna_yard(game)
    if debug:
        game.message("[Diplomacy debug] Debug mode is on: Diplomacy is active from today, and the Republic and the Free Worlds are at war. Open the map to follow their flotillas.")
        debug_war(game, day)
    changes.flush(game)
    state.publish(game, politics.player)
    save(game)

// The pirates are hostile to the flotillas and the rebels, as those are to them.
void ensure_attitudes(es.Game game):
    if state.get(game, "pirate attitudes") >= 2:
        return
    state.put(game, "pirate attitudes", 2)
    string body = "government \"Pirate\"\n\t\"attitude toward\""
    for s in 1..=factions.sides():
        // Only sides with a government (a core's or a pirate holding's minor has no rebels).
        if s != factions.pirates() && factions.flotilla_government(s) != "":
            body = body + "\n\t\t\"" + factions.flotilla_government(s) + "\" -1"
    changes.add(body)

// The Republic's capital-warship yard. The Free Worlds' war wrecks Geminus,
// the only world that sells the Navy's Frigate, Cruiser, Carrier and
// Auxiliary, until "geminus rebuilt" 90 days after the campaign; and Geminus
// can now change hands. So Luna, in Sol, which is never taken, sells them
// too: once per pilot, when the campaign is over or Geminus lies wrecked.
void luna_yard(es.Game game):
    if game.condition("diplomacy: luna yard") != 0:
        return
    bool wrecked = game.condition("event: war begins") != 0 && game.condition("event: geminus rebuilt") == 0
    if game.condition("free worlds plot completed") == 0 && !wrecked:
        return
    game.set_condition("diplomacy: luna yard", 1)
    changes.add("planet \"Luna\"\n\tshipyard \"Navy Advanced\"")

void accept_offer(es.Game game):
    activate(game)
    service.join_at(game, 2, tune.veteran_rank)
    politics.player = 2
    service.apply_reputations(game)
    service.check_rank(game)
    game.message("You accept the commission: the Free Worlds have you back as a " + factions.ranks[tune.veteran_rank] + ". The border is quiet, for now.")
    save(game)

// Debug mode: once per pilot, reveal the map and hand over a fortune; make
// sure the Free Worlds hold territory; and keep them at war with the Republic.
void debug_war(es.Game game, int day):
    if state.get(game, "debug gifts") == 0:
        state.put(game, "debug gifts", 1)
        debug_gifts(game)
    if galaxy.territory(2) == 0:
        for name in factions.free_worlds_territory:
            changes.government(name, "Free Worlds")
            int i = galaxy.find(name)
            if i >= 0:
                galaxy.set_owner(i, 2)
        game.message("[Diplomacy debug] The Free Worlds now hold their wartime territory.")
    world.first_war = 1
    if world.war_between(1, 2).id != 0:
        return
    []int goals = politics.goals_for(1, 2, 1, -1)
    if goals.len() == 0:
        goals = politics.goals_for(2, 1, 1, -1)
    if goals.len() == 0:
        return
    politics.declare(game, 1, 2, 1, goals, "debug", day)
    sim.launch_now(game, day)
    changes.flush(game)
    service.apply_reputations(game)

void debug_gifts(es.Game game):
    string visits = ""
    for i in 0..<galaxy.count():
        visits = visits + "visit \"" + galaxy.name(i) + "\"\n"
    game.change(visits)
    game.set_condition("credits", game.condition("credits") + tune.debug_credits)
    game.message("[Diplomacy debug] The whole map is revealed, and 100,000,000 credits are in your account.")

// ---- Hooks ----

void on_load(es.Game game):
    galaxy.build(game)
    check_api(game)
    if chronicle.bus:
        any g = game
        g.listen("corporations.*")
    field.reset()
    bool on = active(game)
    if on:
        politics.player = state.member(game)
        luna_yard(game)
        changes.flush(game)
        service.apply_reputations(game)
        service.check_rank(game)
    overlay.draw(game, on)
    service.update_button(game, on)
    log(game, "loaded; " + string(galaxy.count()) + " systems, " + string(factions.regions.count()) + " minors")

void on_day(es.Game game, int day):
    bool on = active(game)
    if on:
        int last = world.day
        if day > last:
            simulate(game, day)
        world.day = day
        state.put(game, "last day", day)
        field.dirty = true
        save(game)
    overlay.draw(game, on)
    service.update_button(game, on)

// One day of the simulation.
void simulate(es.Game game, int day):
    galaxy.check_links(game)
    galaxy.refresh(game)
    world.day = day
    politics.player = state.member(game)
    chronicle.today = 0
    occupation.corporations = game.plugin_enabled(tune.corporations_plugin)
    read_shortfall(game)
    section(game, "squadron")
    squadron.check(game)
    squadron.cap_strength(game)
    sim.player = politics.player
    // The places the player's squadrons hold; the AI fills the rest.
    sim.reserved = squadron.mine().len()
    section(game, "politics")
    bool changed = politics.day(game, day)
    section(game, "war")
    sim.day(game, day)
    section(game, "squadron")
    rivals.day(game, politics.player, day)
    intel.update(game, politics.player, day)
    section(game, "operations")
    ops.outcomes(game, politics.player, day)
    section(game, "occupation")
    occupation.day(game, day)
    section(game, "")
    chronicle.sample(day)
    changes.flush(game)
    state.publish(game, politics.player)
    if changed:
        service.apply_reputations(game)
    service.check_rank(game)
    service.keep_standing(game)
    chronicle.flush(game)

void on_enter(es.Game game, string system):
    bool on = active(game)
    service.update_button(game, on)
    if on:
        politics.player = state.member(game)
        service.apply_reputations(game)
        service.check_rank(game)
        sim.force_flotilla(game, game.day())
        sim.force_raid(game, game.day())
        force_squadron(game)
        stock_on(game)
        field.enter(game, system)
        if game.planet() != "":
            ops.offer(game, politics.player, game.day())
        changes.flush(game)
        state.publish(game, politics.player)
        save(game)
    else:
        field.reset()
        if service.offering && !snoozed:
            service.open_offer(game)
    overlay.draw(game, on)

// Shipyard stock (the damage tiers' trims) shows only while it is switched
// on; it is not saved, so switch it on again on entering a system.
void stock_on(es.Game game):
    if world.stock.len() > 0 && !occupation.corporations:
        game.ship_stock_on(true)
        if occupation.api_outfits:
            any g = game
            g.outfit_stock_on(true)

// Test override "diplomacy: force squadron" (a system index + 1): give the
// player a squadron ordered to attack that system, room or not.
void force_squadron(es.Game game):
    int target = state.get(game, "force squadron") - 1
    if target < 0:
        return
    state.put(game, "force squadron", 0)
    squadron.force(game, target, game.day())

void on_step(es.Game game, int step):
    if state.get(game, "active") == 0:
        return
    if field.dirty:
        prepare(game)
        field.enter(game, game.here())
    if step % tune.sync_steps == 0:
        prepare(game)
        field.sync(game)
        service.poll_kills(game)
        if field.changed:
            field.changed = false
            changes.flush(game)
            state.publish(game, politics.player)
            save(game)
        if field.redraw:
            field.redraw = false
            overlay.draw(game, true)

void on_planet_button(es.Game game):
    if !active(game) && service.offering:
        service.open_offer(game)
        return
    service.open_panel(game)

void on_panel(es.Game game, int button):
    string action = service.on_panel(game, button)
    if action == "activate":
        accept_offer(game)
        if service.faction_here(game) != 0:
            service.open_panel(game)
        else:
            game.panel_close()
    else if action == "snooze":
        snoozed = true
        game.panel_close()
    else if action == "never":
        state.put(game, "declined", 1)
        service.offering = false
        game.panel_close()
        game.message("Diplomacy is off for this pilot. Its plugin can stay installed.")
    bool on = active(game)
    if on:
        save(game)
    overlay.draw(game, on)
    service.update_button(game, on)

void on_panel_row(es.Game game, int row):
    service.on_panel_row(game, row)
