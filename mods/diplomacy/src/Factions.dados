class Factions

// The sides of the simulation. 1..3 are the major factions (1 the Republic,
// 2 the Free Worlds, 3 the Syndicate), 4 the pirates, and 5 + k the rebel
// faction minor k forms if it secedes (Regions; most never exist). 0 is none.
// Loops over the majors run 1..3; over every side, 1..sides().
//
// Majors have their real governments (which own their systems), separate
// flotilla governments (data/diplomacy.txt) their war fleets fly under, so a
// war never touches the game's own politics, and capitals that are never
// taken. A rebel faction's government is its own, defined with its fleets in
// data/diplomacy factions.txt, and serves for both: it owns the rebel systems
// and its flotillas fly under it. Pirates fly as the real pirates.

Regions regions = Regions()

[]string governments = ["", "Republic", "Free Worlds", "Syndicate", "Pirate"]
[]string names = ["", "the Republic", "the Free Worlds", "the Syndicate", "the pirates"]
[]string titles = ["", "The Republic", "The Free Worlds", "The Syndicate", "The pirates"]
[]string adjectives = ["", "Republic", "Free Worlds", "Syndicate", "Pirate"]
[]string capitals = ["", "Sol", "Gamma Corvi", "Markab", ""]
[]string flotilla_governments = ["", "Republic Flotilla", "Free Worlds Flotilla", "Syndicate Flotilla", "Pirate"]
// The game's own colours of the majors' governments (data/governments.txt), put
// back when a member leaves (Service.mark_worlds).
[]string government_colors = ["", "governments: Republic", "governments: Free", "governments: Syndicate", "governments: Pirate"]
// The majors' ship colours (their governments' swizzles in the game's data),
// which a member's own ships take (Service.mark_ships), and the player's
// ships' own: the game's "Escort" government, swizzle 5.
[]int swizzles = [5, 0, 2, 4]
int PLAYER_SWIZZLE = 5
// Pirates use their home system's own pirate fleets; these are the fallback.
[]string small_fleets = ["", "Small Republic", "Small Free Worlds", "Small Syndicate", "Small Core Pirates"]
[]string large_fleets = ["", "Large Republic", "Large Free Worlds", "Large Syndicate", "Large Core Pirates"]
[]float red = [1.0, 0.91, 0.06, 0.0, 0.85]
[]float green = [1.0, 0.42, 0.68, 0.41, 0.2]
[]float blue = [1.0, 0.09, 0.0, 0.71, 0.6]
[]string sizes = ["", "small", "medium", "large"]
// The systems the campaign's "war begins" event gives the Free Worlds; debug
// mode hands them over on a pilot that has not reached the war yet.
[]string free_worlds_territory = ["Gamma Corvi", "Spica", "Minkar", "Acrux", "Mimosa", "Kraz", "Izar", "Zeta Centauri", "Hadar", "Alkaid", "Zubeneschamali", "Kochab", "Ildaria", "Zubenelgenubi", "Sabik", "Unukalhai", "Kornephoros", "Sargas", "Lesath", "Aldhibain", "Dschubba", "Atria", "Alniyat", "Han", "Pherkad", "Yed Prior", "Beta Lupi", "Kappa Centauri"]
// The ranks a member climbs, and the merit each needs.
[]string ranks = ["Recruit", "Ensign", "Lieutenant", "Commander", "Captain", "Commodore", "Admiral", "Fleet Admiral", "High Admiral"]
[]int rank_merit = [0, 10, 25, 50, 100, 200, 400, 700, 1100]
// The ranks above Admiral (M2), by faction: they command more squadrons.
[][]string high_ranks = [[], ["Fleet Admiral", "Grand Admiral"], ["Vice Marshal", "Marshal of the Free Worlds"], ["Senior Director", "Executive Director"]]

// Licenses a faction issues its members at a rank, kept after leaving, as
// licenses are. Only the Republic issues any: its Navy licenses.
[]int license_faction = [1, 1, 1, 1]
[]int license_rank = [2, 4, 5, 6]
[]string licenses = ["Navy", "Navy Auxiliary", "Navy Cruiser", "Navy Carrier"]

// Commanders: each major's rank title (and its short form), and the surnames
// its commanders are drawn from. Rebels' commanders are "Commander"s, named
// from rebel_surnames; pirates are "Captain"s.
[]string commander_titles = ["", "Admiral", "Commodore", "Director", "Captain"]
[]string commander_short = ["", "Adm.", "Cdre.", "Dir.", "Capt."]
[][]string surnames = [[], ["Okafor", "Lindqvist", "Harrow", "Castellano", "Whitfield", "Ishikawa", "Mbeki", "Duarte", "Kowalczyk", "Ferreira", "Nakamura", "Ashworth", "Delacroix", "Sato", "Brennan", "Vasquez"], ["Rourke", "Tamsin", "Adeyemi", "Cho", "Halvorsen", "Mercado", "Ndiaye", "Quill", "Barros", "Lund", "Petrov", "Abara", "Kestrel", "Ito", "Calloway", "Navarro"], ["Vance", "Sterling", "Holloway", "Mercer", "Kaine", "Ashford", "Thorne", "Lockwood", "Pryce", "Gallagher", "Sinclair", "Weston", "Hale", "Crane", "Marlowe", "Steele"], ["Black", "Varga", "Kurtz", "Grim", "Sable", "Rook", "Mallory", "Teague", "Vex", "Hask", "Drago", "Cutter", "Brand", "Kincaid", "Morrow", "Slate"]]
[]string rebel_surnames = ["Arkwright", "Bellamy", "Corwin", "Dasari", "Esposito", "Fairweather", "Gutierrez", "Hollis", "Iversen", "Jaramillo", "Kaur", "Lowell", "Moreau", "Nwosu", "Orlov", "Penhaligon"]
// Personalities, 1..4.
[]string personalities = ["", "bold", "cautious", "methodical", "reckless"]

int count():
    return 3

int pirates():
    return 4

// Every side: the majors, the pirates and a rebel faction per minor.
int sides():
    return 4 + regions.count()

bool is_major(int side):
    return side >= 1 && side <= 3

bool is_rebel(int side):
    return side > 4 && side <= sides()

// The rebel side minor m forms, and the minor a rebel side came from.
int rebel_side(int m):
    return 5 + m

int rebel_minor(int side):
    return side - 5 if is_rebel(side) else -1

// The major a rebel side broke away from (its minor's default parent).
int rebel_parent(int side):
    int m = rebel_minor(side)
    return regions.parents[m] if m >= 0 else 0

// The government that owns a side's systems.
string government(int side):
    if side >= 1 && side <= 4:
        return governments[side]
    if is_rebel(side):
        return regions.rebels[rebel_minor(side)]
    return ""

// The government a side's flotillas fly under.
string flotilla_government(int side):
    if side >= 1 && side <= 4:
        return flotilla_governments[side]
    return government(side)

string name(int side):
    if side >= 1 && side <= 4:
        return names[side]
    if is_rebel(side):
        return "the " + regions.rebels[rebel_minor(side)]
    return "no one"

string title(int side):
    if side >= 1 && side <= 4:
        return titles[side]
    if is_rebel(side):
        return "The " + regions.rebels[rebel_minor(side)]
    return "No one"

string adjective(int side):
    if side >= 1 && side <= 4:
        return adjectives[side]
    if is_rebel(side):
        return regions.rebels[rebel_minor(side)]
    return ""

// The fleets a side's flotillas spawn as: a rebel faction flies its own fleets
// (its parent's ships under its flag).
string small_fleet(int side):
    if side >= 1 && side <= 4:
        return small_fleets[side]
    return "Small " + government(side)

string large_fleet(int side):
    if side >= 1 && side <= 4:
        return large_fleets[side]
    return "Large " + government(side)

// The major whose ships a side's are (for the sim score): a rebel's parent.
int stock(int side):
    if is_rebel(side):
        return rebel_parent(side)
    return side

float r(int side):
    if side >= 0 && side <= 4:
        return red[side]
    return regions.red[rebel_minor(side)] if is_rebel(side) else 1.0

float g(int side):
    if side >= 0 && side <= 4:
        return green[side]
    return regions.green[rebel_minor(side)] if is_rebel(side) else 1.0

float b(int side):
    if side >= 0 && side <= 4:
        return blue[side]
    return regions.blue[rebel_minor(side)] if is_rebel(side) else 1.0

string commander_title(int side):
    return commander_titles[side] if side >= 1 && side <= 4 else "Commander"

string commander_abbrev(int side):
    return commander_short[side] if side >= 1 && side <= 4 else "Cmdr."

[]string surname_list(int side):
    return surnames[side] if side >= 1 && side <= 4 else rebel_surnames

// The side whose government this is (a major, the pirates or a rebel), or 0.
int of_government(string government):
    if government == "":
        return 0
    for f in 1..=4:
        if governments[f] == government:
            return f
    for m in 0..<regions.count():
        if regions.rebels[m] == government:
            return rebel_side(m)
    return 0

bool is_capital(string system):
    for f in 1..=3:
        if capitals[f] == system:
            return true
    return false

// A rank's name in faction f's service.
string rank_name(int f, int r):
    if r >= 7 && f >= 1 && f <= 3 && r - 7 < high_ranks[f].len():
        return high_ranks[f][r - 7]
    return ranks[r] if r >= 0 && r < ranks.len() else ""

// The rank merit earns: 0 (Recruit) .. 8.
int rank_of(int merit):
    int r = 0
    for k in 0..<rank_merit.len():
        if merit >= rank_merit[k]:
            r = k
    return r

// Merit needed for the next rank, or -1 at the top.
int next_rank_merit(int rank):
    if rank + 1 < rank_merit.len():
        return rank_merit[rank + 1]
    return -1

// The tag prefix of every ship this mod spawns for side f.
string tag_prefix(int f):
    return "diplomacy:" + string(f) + ":"

// The condition the game pays a member's salary through. For the Free Worlds
// it is the campaign's own "salary: Free Worlds", so a pilot who finished the
// campaign keeps one salary, set by rank, and not two.
string salary_key(int f):
    if f == 2:
        return "salary: Free Worlds"
    return "salary: " + adjectives[f] + " commission"
