class Flotilla

// One flotilla or raid, kept in memory and saved with the rest of the state
// (World, as a JSON array). Fields:
//   id         its number, unique for the pilot (another flotilla's `target` names it)
//   side       its side (Factions): a major, the pirates or a rebel faction
//   war        the war it fights in (War.id), or 0 (relief flotillas, raids)
//   strength   points left; 0 = gone
//   size       1 small, 2 medium, 3 large
//   kind       0 a war flotilla, 1 a relief flotilla hunting a raid, 2 a pirate
//              raid, 3 going home to disband
//   admiral    its commander: their place in the side's roster (1..), or 0
//   full       its strength when it set out
//   at, goal, home   systems (indices; -1 none): where it is, its objective or
//              destination, and where it set out from and goes back to
//   target     the flotilla it is chasing (id), or 0
//   siege      days it has besieged its goal
//   launched   the day it set out
//   stops      a raid's stops (-1 = none); leg, the stop it is bound for (1..3;
//              past the last, it goes home); dwell, days at the stop; plan, days
//              it means to stay; alerted, the majors it has alerted (bit 1 << f)
//   squadron   1 if it is the player's squadron (M2): it follows the player's orders
//   order      a squadron's order: 0 none (it holds where it is), 1 attack its goal,
//              2 relieve its goal (an own system under siege), 3 hunt `target`,
//              4 hold at its goal
//   supply     its effectiveness from supply today, in percent (Simulation: not saved)

int id = 0
int side = 0
int war = 0
int strength = 0
int size = 0
int kind = 0
int admiral = 0
int full = 0
int at = -1
int goal = -1
int home = -1
int target = 0
int siege = 0
int launched = 0
[]int stops = [-1, -1, -1]
int leg = 0
int dwell = 0
int plan = 0
int alerted = 0
int squadron = 0
int order = 0
int supply = 100

bool alive():
    return strength > 0

// The raid's stops, in order (fewer than three when the route is short).
[]int route():
    []int out = []
    for s in stops:
        if s >= 0:
            out.append(s)
    return out

// The tag its ships carry in flight.
string tag():
    return "diplomacy:" + string(side) + ":f" + string(id) + ":"

[]int encode():
    return [id, side, war, strength, size, kind, admiral, full, at, goal, home, target, siege, launched, stops[0], stops[1], stops[2], leg, dwell, plan, alerted, squadron, order]

void decode([]int v):
    if v.len() < 21:
        return
    id = v[0]
    side = v[1]
    war = v[2]
    strength = v[3]
    size = v[4]
    kind = v[5]
    admiral = v[6]
    full = v[7]
    at = v[8]
    goal = v[9]
    home = v[10]
    target = v[11]
    siege = v[12]
    launched = v[13]
    stops = [v[14], v[15], v[16]]
    leg = v[17]
    dwell = v[18]
    plan = v[19]
    alerted = v[20]
    squadron = v[21] if v.len() > 21 else 0
    order = v[22] if v.len() > 22 else 0
