class Garrisons

// The defenders of systems that have been besieged. A system at full strength
// has no record; a damaged one has [system, hp, siege start, last day
// besieged] in World.garrisons, at most tune.garrison_slots of them (the one
// besieged longest ago is forgotten first). A garrison not besieged recovers,
// faster while a fresh capture consolidates, and its record goes once whole.
// A freshly captured system's full strength is raised to tune.consolidation
// percent for tune.consolidation_days (Simulation.full_strength).

Tuning tune = Tuning()
World world = World()

void wire(Tuning t, World w):
    tune = t
    world = w

int find(int i):
    for k in 0..<world.garrisons.len():
        if world.garrisons[k][0] == i:
            return k
    return -1

bool damaged(int i):
    return find(i) >= 0

// The garrison's strength now: its record, or `full`.
int hp(int i, int full):
    int k = find(i)
    return world.garrisons[k][1] if k >= 0 else full

// The day its siege began, or -1.
int start(int i):
    int k = find(i)
    return world.garrisons[k][2] if k >= 0 else -1

int last(int i):
    int k = find(i)
    return world.garrisons[k][3] if k >= 0 else -1

// Set the garrison of system i to `value`, besieged today.
void set(int i, int value, int day):
    int k = find(i)
    if k < 0:
        if world.garrisons.len() >= tune.garrison_slots:
            int oldest = 0
            for j in 1..<world.garrisons.len():
                if world.garrisons[j][3] < world.garrisons[oldest][3]:
                    oldest = j
            world.garrisons.remove_at(oldest)
        world.garrisons.append([i, value, day, day])
        return
    world.garrisons[k][1] = value
    world.garrisons[k][3] = day

// A record without a siege (a fresh capture's garrison): last besieged yesterday.
void place(int i, int value, int day):
    release(i)
    set(i, value, day)
    world.garrisons[find(i)][3] = day - 1

void release(int i):
    int k = find(i)
    if k >= 0:
        world.garrisons.remove_at(k)

void clear_all():
    world.garrisons = []
