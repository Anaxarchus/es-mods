class Json

// Writing and reading the state as JSON text (Game.set_data, mod API 6).
// Writing builds the text by hand; reading goes through the engine's
// JSON.parse and picks fields out of the `any` it answers, with a default for
// one that is missing, so a state written by an older version still reads.

string text(string s):
    string out = globalThis.JSON.stringify(s)
    return out

string ints([]int v):
    []string parts = []
    for x in v:
        parts.append(string(x))
    return "[" + parts.join(",") + "]"

string strings([]string v):
    []string parts = []
    for x in v:
        parts.append(text(x))
    return "[" + parts.join(",") + "]"

string rows([][]int v):
    []string parts = []
    for r in v:
        parts.append(ints(r))
    return "[" + parts.join(",") + "]"

// ---- Reading ----

any parse(string s):
    any doc = globalThis.JSON.parse(s)
    return doc

// Text from another mod: an object, or {} when it is not a JSON object.
any parse_object(string s):
    any f = globalThis.Function("s", "try { const o = JSON.parse(s); return (o && typeof o === 'object' && !Array.isArray(o)) ? o : {}; } catch (e) { return {}; }")
    any doc = f(s)
    return doc

bool has(any o, string key):
    bool h = globalThis.Object.prototype.hasOwnProperty.call(o, key)
    return h

// A number field, truncated; the fallback when missing, not a finite number
// (NaN, a string, null, an object), or past 2^31.
int num(any o, string key, int fallback):
    if !has(o, key):
        return fallback
    any x = o[key]
    bool ok = globalThis.Number.isFinite(x)
    if !ok:
        return fallback
    float f = globalThis.Math.trunc(x)
    if f > 2147483647.0 || f < -2147483648.0:
        return fallback
    return int(f)

bool is_string(any x):
    string t = globalThis.Object.prototype.toString.call(x)
    return t == "[object String]"

// A text field; the fallback when missing or not a string.
string str(any o, string key, string fallback):
    if !has(o, key):
        return fallback
    any x = o[key]
    if !is_string(x):
        return fallback
    string v = x
    return v

[]int int_list(any o, string key):
    []int out = []
    if !has(o, key):
        return out
    any list = o[key]
    int n = list.length
    for k in 0..<n:
        int v = globalThis.Math.trunc(list[k])
        out.append(v)
    return out

[]string string_list(any o, string key):
    []string out = []
    if !has(o, key):
        return out
    any list = o[key]
    int n = list.length
    for k in 0..<n:
        string v = list[k]
        out.append(v)
    return out

[][]int int_rows(any o, string key):
    [][]int out = []
    if !has(o, key):
        return out
    any list = o[key]
    int n = list.length
    for k in 0..<n:
        []int row = []
        any r = list[k]
        int m = r.length
        for j in 0..<m:
            int v = globalThis.Math.trunc(r[j])
            row.append(v)
        out.append(row)
    return out
