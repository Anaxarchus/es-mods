class MapView

// The map overlay. Each flotilla and raid is a marker in its side's colour,
// with a short label ("Free Worlds flotilla (small)", "Pirate raiders
// (medium)") and a line to where it is heading; a besieged system gets a
// "Siege: 40%" marker. The systems a war is fought over (its goals, still held
// by the other side) get a ring in the attacker's colour (map_ring, mod API
// 9), and each minor a label with its name and owner under its first system
// (map_label): "Paradise Worlds (Republic)", "Rim (Free Worlds core)",
// "Central Dirt Belt (split)", "Front: Republic / Free Worlds". The details go
// in the map's side panel (map_detail, mod API 4).

import "imports:sdk/es"

Factions factions = Factions()
Galaxy galaxy = Galaxy()
World world = World()
Garrisons garrisons = Garrisons()
Simulation sim = Simulation()
Intel intel = Intel()
// The player's faction (fog of war: README.md, "Fog of war"); set by the mod.
int player = 0

void wire_intel(Intel i):
    intel = i

void wire(Factions f, Galaxy g, World w, Garrisons gs, Simulation sm):
    factions = f
    galaxy = g
    world = w
    garrisons = gs
    sim = sm

string label(Flotilla x):
    if x.side == factions.pirates():
        return "Pirate raiders (" + factions.sizes[x.size] + ")"
    return factions.adjective(x.side) + " flotilla (" + factions.sizes[x.size] + ")"

int heading(Flotilla x):
    if x.kind == 3:
        return x.home
    if x.kind == 2:
        []int route = x.route()
        if x.leg >= 1 && x.leg <= route.len():
            return route[x.leg - 1]
        return x.home
    if x.target != 0:
        Flotilla y = sim.by_id(x.target)
        if y.alive():
            return y.at
    return x.goal

void draw(es.Game game, bool active):
    game.map_clear()
    if !active:
        return
    player = game.condition("diplomacy: member")
    []int besieged = []
    int day = game.day()
    for x in world.fleets:
        if !x.alive() || !intel.sees_force(game, player, x, day):
            continue
        int f = x.side
        game.map_marker(galaxy.name(x.at), factions.r(f), factions.g(f), factions.b(f), label(x))
        int dest = heading(x)
        if dest != x.at && dest >= 0:
            game.map_line(galaxy.name(x.at), galaxy.name(dest), factions.r(f), factions.g(f), factions.b(f))
        game.map_detail(galaxy.name(x.at), label(x), details(game, x), factions.r(f), factions.g(f), factions.b(f))
        if sim.besieging(x) && !besieged.contains(x.goal):
            besieged.append(x.goal)
    // Forces out of sight: where they were last seen, faded.
    for s in world.sightings:
        []string f = s.split("|")
        if f.len() < 5:
            continue
        Flotilla y = world.fleet_by_id(f[0].to_int())
        if y.alive() && intel.sees_force(game, player, y, day):
            continue
        int side = f[1].to_int()
        int ago = day - f[4].to_int()
        string what = "Pirate raiders" if side == factions.pirates() else factions.adjective(side) + " flotilla"
        game.map_label(galaxy.name(f[3].to_int()), what + ", seen " + string(ago) + (" day" if ago == 1 else " days") + " ago", factions.r(side) * 0.5, factions.g(side) * 0.5, factions.b(side) * 0.5)
    for i in besieged:
        int owner = galaxy.owner(i)
        game.map_marker(galaxy.name(i), factions.r(owner), factions.g(owner), factions.b(owner), "Siege: " + string(progress(game, i)) + "%")
        game.map_detail(galaxy.name(i), "Siege of " + galaxy.name(i), siege_details(game, i, owner), factions.r(owner), factions.g(owner), factions.b(owner))
    // War goals: a ring on each system still to be taken, in the attacker's colour.
    for w in world.wars:
        for s in [w.a, w.b]:
            for i in sim.targets(w, s):
                if !besieged.contains(i):
                    game.map_ring(galaxy.name(i), 1.4, factions.r(s), factions.g(s), factions.b(s))
    // Minor names, with their owners.
    for m in 0..<factions.regions.count():
        if galaxy.minor_systems[m].len() == 0:
            continue
        int o = galaxy.minor_owner(m)
        string text = minor_label(m)
        game.map_label(galaxy.name(galaxy.minor_systems[m][0]), text, factions.r(o), factions.g(o), factions.b(o))

// "Paradise Worlds (Republic)", "Rim (Free Worlds core)", "Central Dirt Belt
// (split)", or a front: "Front: Republic / Free Worlds".
string minor_label(int m):
    string name = factions.regions.shorts[m]
    for w in world.wars:
        if w.goals.contains(m):
            return name + ", front: " + factions.adjective(w.a) + " / " + factions.adjective(w.b)
    int o = galaxy.minor_owner(m)
    if factions.regions.cores[m] && o == factions.regions.parents[m]:
        return name + " (" + factions.adjective(o) + " core)"
    if galaxy.split(m):
        return name + " (split)"
    return name + " (" + factions.adjective(o) + ")"

int progress(es.Game game, int i):
    int full = sim.full_strength(game, i)
    int hp = garrisons.hp(i, full)
    if hp > full:
        hp = full
    return 100 - hp * 100 / full

string jumps(int a, int b):
    if a == b:
        return "here"
    int d = galaxy.jumps(a, b)
    if d < 0:
        return "no route"
    return string(d) + (" jump" if d == 1 else " jumps")

string details(es.Game game, Flotilla x):
    string text = ""
    if x.admiral != 0 && sim.admirals.filled(x.side, x.admiral):
        int w = sim.admirals.wins(x.side, x.admiral)
        text = sim.admirals.full_name(x.side, x.admiral) + ", " + sim.admirals.personality_name(x.side, x.admiral) + "\n" + string(w) + (" victory" if w == 1 else " victories")
    else:
        text = "No commander"
    text = text + "\nStrength " + string(x.strength) + " of " + string(x.full)
    text = text + "\n" + task(game, x)
    War war = sim.war_of(x)
    if war.id != 0:
        text = text + "\nIn the " + war.kind_name() + " with " + factions.name(war.other(x.side))
    int out = game.day() - x.launched
    if out <= 0:
        text = text + "\nSet out today, from " + galaxy.name(x.home)
    else:
        text = text + "\nOut " + string(out) + (" day" if out == 1 else " days") + ", from " + galaxy.name(x.home)
    return text

string task(es.Game game, Flotilla x):
    if x.kind == 3:
        return "Going home to " + galaxy.name(x.home) + " (" + jumps(x.at, x.home) + ")"
    if x.kind == 2:
        []int route = x.route()
        if x.leg >= 1 && x.leg <= route.len():
            int stop = route[x.leg - 1]
            string next = ""
            for k in x.leg..<route.len():
                next = next + (", then " if next != "" else "; then ") + galaxy.name(route[k])
            if x.at == stop:
                int today = x.dwell if x.dwell > 0 else 1
                string days = "day " + string(today) + (" of " + string(x.plan) if x.plan > 0 else "")
                return "Raiding " + galaxy.name(stop) + " (" + days + ")" + next
            return "Bound for " + galaxy.name(stop) + " (" + jumps(x.at, stop) + ")" + next
        return "Going home to " + galaxy.name(x.home) + " (" + jumps(x.at, x.home) + ")"
    if x.target != 0:
        Flotilla y = sim.by_id(x.target)
        if y.alive():
            string what = "the pirate raiders" if y.side == factions.pirates() else "the " + factions.adjective(y.side) + " flotilla"
            if y.at == x.at:
                return "Fighting " + what + " here"
            string verb = "Hunting " if x.kind == 1 else "Intercepting "
            return verb + what + " at " + galaxy.name(y.at) + " (" + jumps(x.at, y.at) + ")"
    if sim.besieging(x):
        string day = ", day " + string(x.siege) if x.siege > 0 else ""
        return "Besieging " + galaxy.name(x.goal) + day + " (" + string(progress(game, x.goal)) + "% done)"
    if x.at == x.goal:
        return "Holding " + galaxy.name(x.goal)
    return "Objective: " + galaxy.name(x.goal) + " (" + jumps(x.at, x.goal) + ")"

string siege_details(es.Game game, int i, int owner):
    int full = sim.full_strength(game, i)
    int hp = garrisons.hp(i, full)
    string text = "Held by " + factions.name(owner) + "\nGarrison " + string(hp) + " of " + string(full)
    int start = garrisons.start(i)
    if start >= 0:
        text = text + "\nUnder siege for " + string(game.day() - start + 1) + " days"
    int m = galaxy.minor(i)
    if m >= 0:
        text = text + "\nPart of " + factions.regions.names[m]
    return text
