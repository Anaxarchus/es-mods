class MapView

// The map overlay. On the map itself each flotilla and raid is a marker in its
// side's colour, with a short label ("Free Worlds flotilla (small)", "Pirate
// raiders (medium)") and a line to where it is heading; a besieged system gets
// a "Siege: 40%" marker. The details go in the map's side panel, below the map
// key, while the player has the system selected (game.map_detail, mod API 4):
// for each flotilla or raid there, its commander, strength, task and
// destination, and for a siege, the garrison and how long it has held.

import "imports:sdk/es"

Factions factions = Factions()
Galaxy galaxy = Galaxy()
State state = State()
Garrisons garrisons = Garrisons()
Simulation sim = Simulation()

void wire(Factions f, Galaxy g, State s, Garrisons gs, Simulation sm):
    factions = f
    galaxy = g
    state = s
    garrisons = gs
    sim = sm

// The marker's label: what it is and how big, nothing more.
string label(Flotilla x):
    if x.faction == factions.pirates():
        return "Pirate raiders (" + factions.sizes[x.size] + ")"
    return factions.adjectives[x.faction] + " flotilla (" + factions.sizes[x.size] + ")"

// Where the flotilla is heading next, for the line on the map (or its own system).
int heading(es.Game game, Flotilla x, []Flotilla fl):
    if x.kind == 3:
        return x.home
    if x.kind == 2:
        []int route = x.route()
        if x.leg >= 1 && x.leg <= route.len():
            return route[x.leg - 1]
        return x.home
    if x.target != 0:
        Flotilla y = sim.by_code(fl, x.target)
        if y.alive():
            return y.at
    return x.goal

void draw(es.Game game, bool active):
    game.map_clear()
    if !active:
        return
    []Flotilla fl = sim.load_all(game)
    []int besieged = []
    for x in fl:
        if !x.alive():
            continue
        int f = x.faction
        float r = factions.red[f]
        float g = factions.green[f]
        float b = factions.blue[f]
        game.map_marker(galaxy.name(x.at), r, g, b, label(x))
        int dest = heading(game, x, fl)
        if dest != x.at && dest >= 0:
            game.map_line(galaxy.name(x.at), galaxy.name(dest), r, g, b)
        game.map_detail(galaxy.name(x.at), label(x), details(game, x, fl), r, g, b)
        if sim.besieging(game, x) && !besieged.contains(x.goal):
            besieged.append(x.goal)
    for i in besieged:
        int owner = galaxy.owner(game, i)
        game.map_marker(galaxy.name(i), factions.red[owner], factions.green[owner], factions.blue[owner], "Siege: " + string(progress(game, i)) + "%")
        game.map_detail(galaxy.name(i), "Siege of " + galaxy.name(i), siege_details(game, i, owner), factions.red[owner], factions.green[owner], factions.blue[owner])

// How far the siege of system i has got, in percent.
int progress(es.Game game, int i):
    int full = galaxy.full_garrison(game, i)
    int hp = garrisons.hp(game, i, full)
    return 100 - hp * 100 / full

// "3 jumps", "1 jump", "here".
string jumps(int from, int to):
    if from == to:
        return "here"
    []int dist = galaxy.distances_one(from)
    int d = dist[to]
    if d < 0:
        return "no route"
    return string(d) + (" jump" if d == 1 else " jumps")

// The side panel's lines for one flotilla or raid.
string details(es.Game game, Flotilla x, []Flotilla fl):
    string text = ""
    if x.admiral != 0 && sim.admirals.filled(game, x.faction, x.admiral):
        int w = sim.admirals.wins(game, x.faction, x.admiral)
        text = sim.admirals.full_name(game, x.faction, x.admiral) + ", " + sim.admirals.personality_name(game, x.faction, x.admiral) + "\n" + string(w) + (" victory" if w == 1 else " victories")
    else:
        text = "No commander"
    text = text + "\nStrength " + string(x.strength) + " of " + string(x.full)
    text = text + "\n" + task(game, x, fl)
    int out = game.day() - x.launched
    if out <= 0:
        text = text + "\nSet out today, from " + galaxy.name(x.home)
    else:
        text = text + "\nOut " + string(out) + (" day" if out == 1 else " days") + ", from " + galaxy.name(x.home)
    return text

string task(es.Game game, Flotilla x, []Flotilla fl):
    if x.kind == 3:
        return "Going home to " + galaxy.name(x.home) + " (" + jumps(x.at, x.home) + ")"
    if x.kind == 2:
        []int route = x.route()
        if x.leg >= 1 && x.leg <= route.len():
            int stop = route[x.leg - 1]
            string next = ""
            for k in x.leg..<route.len():
                next = next + (", then " if next != "" else "; then ") + galaxy.name(route[k])
            if x.at == stop:
                int today = x.dwell if x.dwell > 0 else 1
                string days = "day " + string(today) + (" of " + string(x.plan) if x.plan > 0 else "")
                return "Raiding " + galaxy.name(stop) + " (" + days + ")" + next
            return "Bound for " + galaxy.name(stop) + " (" + jumps(x.at, stop) + ")" + next
        return "Going home to " + galaxy.name(x.home) + " (" + jumps(x.at, x.home) + ")"
    if x.target != 0:
        Flotilla y = sim.by_code(fl, x.target)
        if y.alive():
            string what = "the pirate raiders" if y.faction == factions.pirates() else "the " + factions.adjectives[y.faction] + " flotilla"
            if y.at == x.at:
                return "Fighting " + what + " here"
            string verb = "Hunting " if x.kind == 1 else "Intercepting "
            return verb + what + " at " + galaxy.name(y.at) + " (" + jumps(x.at, y.at) + ")"
    if sim.besieging(game, x):
        string day = ", day " + string(x.siege) if x.siege > 0 else ""
        return "Besieging " + galaxy.name(x.goal) + day + " (" + string(progress(game, x.goal)) + "% done)"
    if x.at == x.goal:
        return "Holding " + galaxy.name(x.goal)
    return "Objective: " + galaxy.name(x.goal) + " (" + jumps(x.at, x.goal) + ")"

string siege_details(es.Game game, int i, int owner):
    int full = galaxy.full_garrison(game, i)
    int hp = garrisons.hp(game, i, full)
    string text = "Held by " + factions.names[owner] + "\nGarrison " + string(hp) + " of " + string(full)
    int start = garrisons.start(game, i)
    if start >= 0:
        text = text + "\nUnder siege for " + string(game.day() - start + 1) + " days"
    if factions.is_capital(galaxy.name(i)):
        text = text + "\nA capital: it cannot fall"
    return text
