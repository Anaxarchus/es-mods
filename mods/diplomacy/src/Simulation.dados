class Simulation

// The military side of a day: sides at war launch flotillas at the systems
// of their war's goals; pirates set out on raids, and majors send relief
// after them; everything moves one jump; hostile forces in one system fight;
// flotillas at their objective besiege its garrison until the system falls
// (Politics.capture); raids plunder; and flotillas and raids that are home
// disband.
//
// Every fight rolls a winner each day with odds score_a : score_b, where a
// score is strength * quality (Quality, from the fleets' real stats) * the
// commander's personality (Admirals).

import "imports:sdk/es"

Tuning tune = Tuning()
Factions factions = Factions()
Galaxy galaxy = Galaxy()
World world = World()
Rng rng = Rng()
Garrisons garrisons = Garrisons()
Admirals admirals = Admirals()
Quality quality = Quality()
Politics politics = Politics()
Chronicle chronicle = Chronicle()
Rivals rivals = Rivals()

// The player's faction and how many flotilla places its squadrons hold back
// from the faction's own launches (set by the mod each day).
int player = 0
int reserved = 0
// Set by Battlefield while a flotilla is destroyed in front of the player.
bool in_person = false
// Each side's jumps from its depots, worked out once a day (supply).
{int: []int} depot_dist = {}
int depot_version = -1
int depot_down_sig = -1
int depot_day = -1

void wire_rivals(Rivals rv):
    rivals = rv

Intel intel = Intel()

void wire_intel(Intel i):
    intel = i

void wire(Tuning t, Factions f, Galaxy g, World w, Rng r, Garrisons gs, Admirals a, Quality q, Politics p, Chronicle c):
    tune = t
    factions = f
    galaxy = g
    world = w
    rng = r
    garrisons = gs
    admirals = a
    quality = q
    politics = p
    chronicle = c

// ---- Flotillas ----

[]Flotilla live():
    return world.fleets.filter(bool(Flotilla x): return x.alive())

int count_side(int side):
    int n = 0
    for x in world.fleets:
        if x.alive() && x.side == side:
            n += 1
    return n

int count_war(int side, int war):
    int n = 0
    for x in world.fleets:
        if x.alive() && x.side == side && x.war == war:
            n += 1
    return n

// How many flotillas a side may have out at once.
int cap(int side):
    if side == factions.pirates():
        return tune.max_raids
    if factions.is_rebel(side):
        return tune.rebel_flotillas
    return tune.max_flotillas

// Room for another: flotillas going home to disband do not hold a place.
// Room for one of the faction's own flotillas: its squadrons' places held back.
bool ai_room(int side):
    int n = 0
    for x in world.fleets:
        if x.alive() && x.side == side && x.kind != 3 && x.squadron == 0:
            n += 1
    int keep = reserved if side == player else 0
    return n < cap(side) - keep

bool has_room(int side):
    int n = 0
    for x in world.fleets:
        if x.alive() && x.side == side && x.kind != 3:
            n += 1
    return n < cap(side)

Flotilla by_id(int id):
    return world.fleet_by_id(id)

bool hostile(int s, int t):
    return world.hostile(s, t)

// The war a flotilla fights in (empty for none).
War war_of(Flotilla x):
    return world.war_by_id(x.war)

// Whether system i is an objective side s may take in war w: held by its
// enemy in that war, in one of the war's goals, and not a capital.
bool can_take(War w, int s, int i):
    if w.id == 0 || i < 0 || !w.involves(s):
        return false
    if galaxy.owner(i) != w.other(s) || factions.is_capital(galaxy.name(i)):
        return false
    return w.goals.contains(galaxy.minor(i))

// Whether a war flotilla is besieging its objective now.
bool besieging(Flotilla x):
    if !x.alive() || x.kind != 0 || x.target != 0 || x.at != x.goal || x.goal < 0:
        return false
    return can_take(war_of(x), x.side, x.goal)

[]int busy(int side):
    []int out = []
    for x in world.fleets:
        if x.alive() && x.side == side && x.admiral != 0:
            out.append(x.admiral)
    return out

// A new flotilla or raid, with a commander.
Flotilla commission(int side, int war, int kind, int size, int strength, int at, int day):
    Flotilla x = Flotilla()
    x.id = world.next_flotilla
    world.next_flotilla += 1
    x.side = side
    x.war = war
    x.kind = kind
    x.size = size
    x.strength = strength
    x.full = strength
    x.at = at
    x.home = at
    x.goal = at
    x.launched = day
    x.admiral = admirals.pick(side, busy(side))
    world.fleets.append(x)
    return x

string led_by(Flotilla x):
    if x.admiral != 0 && admirals.filled(x.side, x.admiral):
        return admirals.full_name(x.side, x.admiral)
    return "an unnamed commander"

// ---- The sim score ----

// The pirate fleets a raid from `home` flies as: the home system's own pirate
// fleets, else the core pirates'. [small, large].
[]string pirate_fleets(es.Game game, int home):
    string small = ""
    string large = ""
    if home >= 0:
        string s = galaxy.name(home)
        for k in 0..<game.system_fleet_count(s):
            string f = game.system_fleet(s, k)
            if f.contains("Pirate"):
                if f.contains("Large") && large == "":
                    large = f
                else if f.contains("Small") && small == "":
                    small = f
    if small == "":
        small = large if large != "" else factions.small_fleets[factions.pirates()]
    if large == "":
        large = small if small != "" else factions.large_fleets[factions.pirates()]
    return [small, large]

// The fleets a flotilla spawns as.
[]string fleets_of(es.Game game, Flotilla x):
    if x.side == factions.pirates():
        return pirate_fleets(game, x.home)
    return [factions.small_fleet(x.side), factions.large_fleet(x.side)]

float quality_of(es.Game game, Flotilla x):
    if x.side == factions.pirates():
        []string f = pirate_fleets(game, x.home)
        return quality.side_quality(game, f[0], f[1])
    int st = factions.stock(x.side)
    return quality.side_quality(game, factions.small_fleets[st], factions.large_fleets[st])

float score(es.Game game, Flotilla x):
    float s = float(x.strength) * quality_of(game, x) * float(admirals.attack(x.side, x.admiral)) / 100.0
    // Supply: away from its depots a flotilla fights at less than full strength.
    s = s * float(x.supply) / 100.0
    // The player with their squadron.
    if x.squadron == 1 && galaxy.name(x.at) == game.here():
        s = s * float(tune.squadron_presence) / 100.0
    return s

// ---- Supply ----

// Jumps from side s's depots (the inhabited systems it holds whose depot is
// not raided) to every system, once a day.
[]int depots(es.Game game, int s, int day):
    // Worked out again when an owner changes or a raided depot goes down or back up.
    int down = 0
    for r in world.depots_down:
        if r[1] >= day:
            down = down * 7 + r[0] + 1
    if galaxy.owner_version != depot_version || down != depot_down_sig || day < depot_day:
        depot_dist = {}
        depot_version = galaxy.owner_version
        depot_down_sig = down
    depot_day = day
    if depot_dist.has(s):
        return depot_dist[s]
    []int src = []
    for i in galaxy.human:
        if galaxy.owner(i) == s && galaxy.inhabited(game, i) && !world.depot_down(i, day):
            src.append(i)
    []int d = galaxy.distances_from(src)
    depot_dist[s] = d
    return d

// Each flotilla's supply today: full within tune.supply_free jumps of a depot,
// less for each jump farther (pirates live off their raids).
void supply(es.Game game, int day):
    for x in world.fleets:
        if !x.alive() || x.side == factions.pirates():
            x.supply = 100
            continue
        int d = depots(game, x.side, day)[x.at]
        int v = 100
        if d < 0:
            v = tune.supply_floor
        else if d > tune.supply_free:
            v = 100 - (d - tune.supply_free) * tune.supply_per_jump
        x.supply = v if v > tune.supply_floor else tune.supply_floor

bool roll(float a, float b):
    if a + b <= 0.0:
        return rng.chance(50)
    return rng.range(0, 9999) < int(10000.0 * a / (a + b))

// A system's garrison at full strength now: rebels hold theirs at
// tune.rebel_garrison percent, and a fresh capture stands at tune.consolidation.
int full_strength(es.Game game, int i):
    int full = galaxy.full_garrison(game, i)
    if factions.is_rebel(galaxy.owner(i)):
        full = full * tune.rebel_garrison / 100
    int k = world.capture_index(i)
    if k >= 0 && world.day - world.captures[k][3] < tune.consolidation_days && world.captures[k][2] == galaxy.owner(i):
        full = full * tune.consolidation / 100
    // A side down to a fraction of its home rallies (Galaxy.rallying).
    if galaxy.rallying(galaxy.owner(i)):
        full = full * tune.rally_garrison / 100
    // Occupation unrest weakens it (Occupation).
    int o = world.occupation_index(i)
    if o >= 0:
        full = full * (100 - world.occupation[o][1] / 20) / 100
    return full if full > 1 else 1

// ---- The day ----

void day(es.Game game, int day):
    supply(game, day)
    // The wars take turns launching first, so a side's flotillas are shared
    // between its wars (see launch).
    int n = world.wars.len()
    for k in 0..<n:
        launch(game, day, world.wars[(k + day) % n])
    launch_raid(game, day)
    move(game, day)
    battles(game, day)
    sieges(game, day)
    raids(game, day)
    homecomings()
    recover(game, day)
    world.fleets = live()
    tidy()

// A chase whose quarry is gone, or no longer an enemy, is called off.
void tidy():
    for x in world.fleets:
        if x.target != 0:
            Flotilla y = by_id(x.target)
            if !y.alive() || !hostile(x.side, y.side):
                x.target = 0

// Launch for every war now (debug mode, a forced war).
void launch_now(es.Game game, int day):
    for w in world.wars:
        launch(game, day, w)

// ---- Launching war flotillas ----

int size_roll(int small_odds, int medium_odds):
    int roll = rng.range(0, 99)
    if roll < small_odds:
        return 1
    if roll < small_odds + medium_odds:
        return 2
    return 3

int strength_of(int size):
    if size == 1:
        return tune.small_strength
    if size == 2:
        return tune.medium_strength
    return tune.large_strength

// A new flotilla of side s: the usual strength for its size, scaled up for a
// faction whose ships are weaker (Quality.fleet_scale); rebels field less.
int flotilla_strength(es.Game game, int s, int size):
    int base = strength_of(size) * quality.fleet_scale(game, factions.stock(s)) / 100
    if factions.is_rebel(s):
        base = base * tune.rebel_strength / 100
    return base

int raid_strength(int size):
    if size == 1:
        return tune.raid_small
    if size == 2:
        return tune.raid_medium
    return tune.raid_large

// The systems side s may attack in war w.
[]int targets(War w, int s):
    []int out = []
    for m in w.goals:
        for i in galaxy.minor_systems[m]:
            if can_take(w, s, i):
                out.append(i)
    return out

// The system side s holds nearest `goal` (other than `except` if it can); -1 if none.
int nearest_owned(int s, int goal, int except):
    []int dist = galaxy.from(goal)
    int best = -1
    int bd = 1000000
    for i in galaxy.human:
        if dist[i] >= 0 && dist[i] < bd && galaxy.owner(i) == s && i != except:
            best = i
            bd = dist[i]
    if best < 0 && except >= 0 && galaxy.owner(except) == s:
        return except
    return best

// Jumps from side s's nearest system to i.
int reach(int s, int i):
    int o = nearest_owned(s, i, -1)
    return galaxy.jumps(o, i) if o >= 0 else 1000000

// How many flotillas side s may have in any one war: tune.per_war, and no
// more than its share of its cap among the wars it fights.
int war_cap(int s):
    int n = world.wars_of(s).len()
    int share = (cap(s) + n - 1) / n if n > 0 else cap(s)
    return share if share < tune.per_war else tune.per_war

void launch(es.Game game, int day, War w):
    for s in [w.a, w.b]:
        // A war the side has no flotilla in yet launches twice as readily.
        int chance = tune.launch_chance * 2 if count_war(s, w.id) == 0 else tune.launch_chance
        if count_war(s, w.id) >= war_cap(s) || !ai_room(s) || !rng.chance(chance):
            continue
        []int t = targets(w, s)
        int goal = -1
        if t.len() > 0:
            // Objectives nearest the side's present border are likelier.
            t.sort(bool(int x, int y): return reach(s, x) < reach(s, y))
            int choices = tune.objective_choices if tune.objective_choices < t.len() else t.len()
            goal = t[rng.range(0, choices - 1)]
        else:
            // Nothing to take: hold the side's goal system nearest the enemy, if the enemy has flotillas out.
            if count_war(w.other(s), w.id) == 0 || !rng.chance(50):
                continue
            goal = guard_post(w, s)
        if goal < 0:
            continue
        int start = nearest_owned(s, goal, -1)
        if start < 0 || galaxy.jumps(start, goal) < 0:
            continue
        int size = size_roll(tune.small_odds, tune.medium_odds)
        int strength = flotilla_strength(game, s, size)
        // A warship tender delivered to the government (Corporations): this
        // launch only, at tender_boost percent.
        if world.boost[s] != 0:
            strength = strength * tune.tender_boost / 100
            world.boost[s] = 0
            world.stat("tender boosts", 1)
        if world.penalty[s] != 0:
            strength = strength * tune.tender_penalty / 100
            world.penalty[s] = 0
            world.stat("tender penalties", 1)
        // Corporations' shortfall of warships on the side's military shelves.
        int short = world.shortfall[s] if s < world.shortfall.len() else 0
        if short > 0:
            strength = strength * (100 - short * tune.shortfall_weight / 100) / 100
        Flotilla x = commission(s, w.id, 0, size, strength, start, day)
        x.goal = goal
        world.stat("launches", 1)
        if tune.verbose:
            game.message("[Diplomacy debug] " + factions.adjective(s) + " " + factions.sizes[size] + " flotilla under " + led_by(x) + " launched from " + galaxy.name(start) + " toward " + galaxy.name(goal) + ".")

// The system of a war's goals side s holds that is nearest the enemy.
int guard_post(War w, int s):
    int best = -1
    int bd = 1000000
    int e = w.other(s)
    for m in w.goals:
        for i in galaxy.minor_systems[m]:
            if galaxy.owner(i) != s:
                continue
            int d = reach(e, i)
            if d < bd:
                bd = d
                best = i
    return best

// Test override "diplomacy: force flotilla" = f: launch a medium flotilla of
// faction f (which must be at war) in the system the player arrives in next.
void force_flotilla(es.Game game, int day):
    int f = game.condition("diplomacy: force flotilla")
    if f == 0:
        return
    []War ws = world.wars_of(f)
    if ws.len() == 0:
        return
    game.set_condition("diplomacy: force flotilla", 0)
    int here = galaxy.find(game.here())
    if here < 0:
        return
    War w = ws[0]
    []int t = targets(w, f)
    int goal = here
    if t.len() > 0:
        goal = t[0]
        for i in t:
            if galaxy.jumps(here, i) >= 0 && (galaxy.jumps(here, goal) < 0 || galaxy.jumps(here, i) < galaxy.jumps(here, goal)):
                goal = i
    Flotilla x = commission(f, w.id, 0, 2, flotilla_strength(game, f, 2), here, day)
    x.goal = goal
    world.stat("launches", 1)

// Test override "diplomacy: force raid" = 1: a medium pirate raid in the
// system the player arrives in next, staying there three days.
void force_raid(es.Game game, int day):
    if game.condition("diplomacy: force raid") == 0:
        return
    game.set_condition("diplomacy: force raid", 0)
    int here = galaxy.find(game.here())
    if here < 0:
        return
    int home = nearest_pirate_home(game, here)
    Flotilla x = commission(factions.pirates(), 0, 2, 2, tune.raid_medium, here, day)
    x.home = home if home >= 0 else here
    x.stops = [here, -1, -1]
    x.leg = 1
    x.goal = here
    x.plan = tune.raid_max_dwell
    world.stat("raids", 1)

int nearest_pirate_home(es.Game game, int here):
    []int dist = galaxy.from(here)
    int best = -1
    for h in galaxy.pirate_homes(game):
        if dist[h] >= 0 && (best < 0 || dist[h] < dist[best]):
            best = h
    return best

// ---- Raids setting out ----

// The systems a raid from `home` may visit: inhabited, held by a faction, within reach.
[]int raid_targets(es.Game game, int home):
    []int out = []
    []int dist = galaxy.from(home)
    for i in galaxy.human:
        int o = galaxy.owner(i)
        if dist[i] >= 1 && dist[i] <= tune.raid_range && o != 0 && o != factions.pirates() && galaxy.inhabited(game, i):
            out.append(i)
    return out

void launch_raid(es.Game game, int day):
    if !has_room(factions.pirates()) || !rng.chance(tune.raid_chance):
        return
    []int homes = galaxy.pirate_homes(game)
    if homes.len() == 0:
        return
    for attempt in 0..<5:
        int home = homes[rng.range(0, homes.len() - 1)]
        []int t = raid_targets(game, home)
        if t.len() < 2:
            continue
        int n = rng.range(2, 3)
        if n > t.len():
            n = t.len()
        []int picked = []
        for k in 0..<n:
            []int left = t.filter(bool(int v): return !picked.contains(v))
            picked.append(left[rng.range(0, left.len() - 1)])
        // Visit them nearest-first, each from the last.
        []int ordered = []
        int here = home
        for k in 0..<n:
            []int dist = galaxy.from(here)
            int best = -1
            for v in picked:
                if !ordered.contains(v) && (best < 0 || dist[v] < dist[best]):
                    best = v
            ordered.append(best)
            here = best
        int size = size_roll(tune.raid_small_odds, tune.raid_medium_odds)
        Flotilla x = commission(factions.pirates(), 0, 2, size, raid_strength(size), home, day)
        for k in 0..<ordered.len():
            x.stops[k] = ordered[k]
        x.leg = 1
        x.goal = ordered[0]
        world.stat("raids", 1)
        if tune.verbose:
            game.message("[Diplomacy debug] " + factions.sizes[size] + " pirate raid under " + led_by(x) + " set out from " + galaxy.name(home) + " for " + galaxy.name(ordered[0]) + ".")
        return

// ---- Moving ----

void move(es.Game game, int day):
    for x in world.fleets:
        if !x.alive():
            continue
        if x.squadron == 1:
            move_squadron(game, x)
            continue
        // A cautious commander, badly hurt, turns for home.
        if x.side != factions.pirates() && x.kind != 3 && admirals.personality(x.side, x.admiral) == 2 && x.strength * 100 < x.full * tune.cautious_retreat:
            if besieging(x):
                politics_siege_broken(game, x, day)
            go_home(x)
            world.stat("retreats", 1)
        if x.kind == 0:
            move_war(game, x)
        else if x.kind == 1:
            move_relief(day, x)
        else if x.kind == 2:
            move_raid(x)
        else:
            step_toward(x, x.home)

// A squadron follows the player's order; one carried out (the system taken,
// the siege lifted, the quarry gone) leaves it holding where it is.
void move_squadron(es.Game game, Flotilla x):
    War w = war_of(x)
    bool done = false
    if x.order == 1 && !can_take(w, x.side, x.goal):
        done = true
    else if x.order == 2:
        Flotilla y = by_id(x.target)
        if !y.alive() || !besieging(y) || y.goal != x.goal:
            if x.at == x.goal || !y.alive():
                done = true
    else if x.order == 3:
        // The quarry is followed while in sight; out of sight the squadron
        // makes for where it was last seen, and gives up there.
        Flotilla y = by_id(x.target)
        if !y.alive() || !hostile(x.side, y.side):
            done = true
        else if intel.sees_force(game, x.side, y, world.day):
            x.goal = y.at
        else if x.at == x.goal:
            done = true
    if done:
        x.order = 4
        x.target = 0
        x.goal = x.at
        if x.side == player:
            game.message("Your squadron under " + led_by(x) + " has carried out its orders at " + galaxy.name(x.at) + ", and awaits new ones (War Room, Command).")
    if x.order == 0 || x.order == 4:
        x.goal = x.goal if x.goal >= 0 else x.at
    if x.goal >= 0 && x.goal != x.at:
        x.at = galaxy.next_hop(x.at, x.goal)
        x.siege = 0

void step_toward(Flotilla x, int dest):
    if dest >= 0 && dest != x.at:
        x.at = galaxy.next_hop(x.at, dest)

void go_home(Flotilla x):
    x.kind = 3
    x.target = 0
    x.siege = 0
    x.war = 0
    if x.home < 0:
        x.home = nearest_owned(x.side, x.at, -1)
    if x.home < 0:
        x.home = x.at
    x.goal = x.home

void move_war(es.Game game, Flotilla x):
    War w = war_of(x)
    if w.id == 0:
        go_home(x)
        return
    int e = w.other(x.side)
    []int dist = galaxy.from(x.at)
    bool guarding = x.goal >= 0 && galaxy.owner(x.goal) == x.side
    // An objective that can no longer be taken is replaced by the nearest one that can.
    if !guarding && !can_take(w, x.side, x.goal):
        int best = -1
        int bd = 1000000
        for i in targets(w, x.side):
            if dist[i] >= 0 && dist[i] < bd:
                best = i
                bd = dist[i]
        if best < 0:
            best = guard_post(w, x.side)
        if best < 0:
            go_home(x)
            return
        x.goal = best
        x.siege = 0
    int d_goal = dist[x.goal]
    int p = admirals.personality(x.side, x.admiral)
    int reach_more = tune.bold_reach if p == 1 else 0
    if guarding:
        reach_more += 2
    int chase = 0
    int chase_at = -1
    int cd = 1000000
    float mine = score(game, x)
    for y in world.fleets:
        if !y.alive() || y.side != e || dist[y.at] < 0 || dist[y.at] >= cd:
            continue
        if p == 2 && score(game, y) > mine * 1.2:
            continue
        chase = y.id
        chase_at = y.at
        cd = dist[y.at]
    // A rival goes after the player's squadron, farther still if an ambusher.
    if admirals.is_rival(x.side, x.admiral):
        int far = tune.rival_reach + (tune.ambusher_reach if admirals.trait(x.side, x.admiral) == 5 else 0)
        for y in world.fleets:
            if y.alive() && y.squadron == 1 && y.side == e && dist[y.at] >= 0 && dist[y.at] <= far:
                chase = y.id
                chase_at = y.at
                cd = 0
                break
    int dest = x.goal
    if chase != 0 && (cd < d_goal + reach_more || d_goal < 0):
        if x.target != chase:
            world.stat("intercepts ordered", 1)
        x.target = chase
        dest = chase_at
    else:
        x.target = 0
    if dest != x.at:
        x.at = galaxy.next_hop(x.at, dest)
        if x.at != x.goal:
            x.siege = 0
        if x.target != 0 && by_id(x.target).at == x.at:
            world.stat("interceptions", 1)

void move_relief(int day, Flotilla x):
    Flotilla y = by_id(x.target)
    if !y.alive() || y.kind != 2 || day - x.launched > tune.relief_days || (y.leg > y.route().len() && y.at == y.home):
        go_home(x)
        step_toward(x, x.home)
        return
    x.goal = y.at
    if y.at != x.at:
        x.at = galaxy.next_hop(x.at, y.at)
        if x.at == y.at:
            world.stat("interceptions", 1)

void move_raid(Flotilla x):
    []int r = x.route()
    if x.leg <= r.len() && admirals.personality(x.side, x.admiral) == 2:
        for y in world.fleets:
            if y.alive() && y.at == x.at && y.side != x.side:
                x.leg = r.len() + 1
                x.dwell = 0
                x.plan = 0
                break
    if x.leg >= 1 && x.leg <= r.len() && x.at == r[x.leg - 1]:
        if x.plan == 0 || x.dwell < x.plan:
            return
        x.leg += 1
        x.dwell = 0
        x.plan = 0
    int dest = r[x.leg - 1] if x.leg >= 1 && x.leg <= r.len() else x.home
    x.goal = dest
    step_toward(x, dest)

// ---- Battles ----

void battles(es.Game game, int day):
    []int seen = []
    for x in world.fleets:
        if !x.alive() || seen.contains(x.at):
            continue
        int here = x.at
        seen.append(here)
        []int present = []
        for y in world.fleets:
            if y.alive() && y.at == here && !present.contains(y.side):
                present.append(y.side)
        for i in 0..<present.len():
            for j in (i + 1)..<present.len():
                if hostile(present[i], present[j]):
                    fight(game, day, here, present[i], present[j])

void fight(es.Game game, int day, int here, int a, int b):
    float sa = 0.0
    float sb = 0.0
    int pa = 0
    int pb = 0
    bool squad_a = false
    bool squad_b = false
    for y in world.fleets:
        if y.alive() && y.at == here && y.squadron == 1:
            squad_a = squad_a || y.side == a
            squad_b = squad_b || y.side == b
    bool player_here = galaxy.name(here) == game.here()
    for y in world.fleets:
        if y.alive() && y.at == here:
            // A rival with a grudge hits the player's squadron harder.
            float sc = score(game, y)
            bool facing = (y.side == a && squad_b) || (y.side == b && squad_a)
            if facing && admirals.is_rival(y.side, y.admiral) && admirals.trait(y.side, y.admiral) == 1:
                sc = sc * float(tune.grudge_bonus) / 100.0
            if y.side == a:
                sa += sc
                pa += y.strength
            else if y.side == b:
                sb += sc
                pb += y.strength
    if pa == 0 || pb == 0:
        return
    // Commanders who meet the player (their squadron, or the player there) remember it.
    for y in world.fleets:
        if y.alive() && y.at == here && ((y.side == a && (squad_b || (player_here && player == b))) || (y.side == b && (squad_a || (player_here && player == a)))):
            rivals.met(y)
    bool a_wins = roll(sa, sb)
    float loss_a = sb * float(tune.battle_rate) / 100.0 * float(tune.win_losses if a_wins else tune.lose_losses) / 100.0 * rng.factor(90, 110)
    float loss_b = sa * float(tune.battle_rate) / 100.0 * float(tune.lose_losses if a_wins else tune.win_losses) / 100.0 * rng.factor(90, 110)
    []Flotilla fallen = []
    for y in world.fleets:
        if !y.alive() || y.at != here || (y.side != a && y.side != b):
            continue
        float share = loss_a * float(y.strength) / float(pa) if y.side == a else loss_b * float(y.strength) / float(pb)
        bool sieging = besieging(y)
        int taken = admirals.damage_taken(y.side, y.admiral)
        // A rival who learned the player's tactics takes less from their squadron.
        if ((y.side == a && squad_b) || (y.side == b && squad_a)) && admirals.is_rival(y.side, y.admiral) && admirals.trait(y.side, y.admiral) == 2:
            taken = taken * tune.learned_tactics / 100
        damage(y, int(share * float(taken) / 100.0))
        if !y.alive():
            if sieging:
                politics_siege_broken(game, y, day)
            fallen.append(y)
    world.stat("battles", 1)
    chronicle.post(game, "diplomacy.battle", "{\"system\":" + politics.chronicle_json(galaxy.name(here)) + ",\"a\":" + string(a) + ",\"b\":" + string(b) + ",\"loss_a\":" + string(int(loss_a)) + ",\"loss_b\":" + string(int(loss_b)) + "}")
    if a == factions.pirates() || b == factions.pirates():
        world.stat("pirate battles", 1)
    for side in [a, b]:
        bool left = false
        for y in world.fleets:
            if y.alive() && y.at == here && y.side == side:
                left = true
        if !left:
            int winner = b if side == a else a
            for y in world.fleets:
                if y.alive() && y.at == here && y.side == winner:
                    admirals.add_win(y.side, y.admiral)
                    rivals.promoted(game, y.side, y.admiral, day)
    for y in fallen:
        lost(game, y, day, a if y.side == b else b)
    if galaxy.name(here) == game.here():
        game.message("Battle in this system: " + side_name(a) + " against " + side_name(b) + ".")

string side_name(int side):
    return "pirate raiders" if side == factions.pirates() else factions.adjective(side) + " flotillas"

void damage(Flotilla x, int amount):
    x.strength -= amount
    if x.strength < tune.destroy_below:
        x.strength = 0

// A besieging flotilla was destroyed or turned back: the defender scores.
void politics_siege_broken(es.Game game, Flotilla x, int day):
    War w = war_of(x)
    if w.id == 0:
        return
    int defender = w.other(x.side)
    w.add_score(defender, tune.score_relief)
    world.stat("sieges broken", 1)
    if politics.concerns(x.side, defender):
        chronicle.add(game, day, "Relief of " + galaxy.name(x.goal) + ": the siege by " + led_by(x) + " is broken.", false, false)

// A flotilla or raid was destroyed (by `by`, or 0): its commander may have
// fallen with it; in a war, the other side scores and its own side tires.
void lost(es.Game game, Flotilla x, int day, int by):
    string who = led_by(x)
    bool rival = x.admiral != 0 && admirals.is_rival(x.side, x.admiral)
    bool died = false
    if rival && in_person:
        // A rival destroyed in front of the player does not get away.
        admirals.kill(x.side, x.admiral)
        died = true
    else:
        died = x.admiral != 0 && admirals.fallen(x.side, x.admiral)
    if died:
        rivals.fell(game, who, x.side, rival, in_person, day)
    if x.squadron == 1:
        // The player's squadron: merit and standing lost.
        int merit = game.condition("diplomacy: merit") - tune.squadron_loss_merit
        game.set_condition("diplomacy: merit", merit if merit > 0 else 0)
        world.stat("squadrons lost", 1)
        world.squadron_lost = day
        string gov = factions.governments[x.side] if x.side <= 3 else ""
        if gov != "":
            game.set_reputation(gov, game.reputation(gov) - float(tune.squadron_loss_standing))
        chronicle.add(game, day, "Your squadron under " + who + " is destroyed at " + galaxy.name(x.at) + "; " + factions.name(x.side) + " hold you to account (" + string(tune.squadron_loss_merit) + " merit, and standing).", true, false)
    if x.side == factions.pirates():
        world.stat("raids destroyed", 1)
    else:
        world.stat("flotillas destroyed", 1)
    War w = war_of(x)
    if w.id != 0:
        w.add_score(w.other(x.side), tune.score_flotilla)
        w.add_exhaustion(x.side, tune.exhaustion_flotilla)
    bool mine = politics.concerns(x.side, w.other(x.side) if w.id != 0 else 0)
    if died && who != "an unnamed commander" && (mine || tune.verbose):
        chronicle.add(game, day, who + " (" + factions.name(x.side) + ") fell with " + ("their raiders" if x.side == factions.pirates() else "their flotilla") + " at " + galaxy.name(x.at) + ".", mine, false)

// ---- Sieges ----

void sieges(es.Game game, int day):
    for x in world.fleets:
        if !x.alive() || x.kind != 0 || x.target != 0 || x.at != x.goal:
            continue
        War w = war_of(x)
        if !can_take(w, x.side, x.goal):
            continue
        bool contested = false
        for y in world.fleets:
            if y.alive() && y.at == x.at && hostile(x.side, y.side):
                contested = true
        if contested:
            continue
        int owner = galaxy.owner(x.goal)
        int full = full_strength(game, x.goal)
        int hp = garrisons.hp(x.goal, full)
        if hp > full:
            hp = full
        if !garrisons.damaged(x.goal) || garrisons.last(x.goal) < day - 1:
            world.stat("sieges", 1)
            if tune.verbose:
                game.message("[Diplomacy debug] " + factions.adjective(x.side) + " flotilla under " + led_by(x) + " laying siege to " + galaxy.name(x.goal) + ".")
        float qg = quality.garrison_quality(game, galaxy.name(x.goal), factions.stock(owner))
        float sx = score(game, x)
        bool wins = roll(sx, float(hp) * qg)
        int hit = int(sx * float(tune.siege_attack) / 100.0 * float(admirals.siege(x.side, x.admiral)) / 100.0 * float(tune.lose_losses if wins else tune.win_losses) / 100.0 * rng.factor(90, 110))
        int back = int(float(hp) * qg * float(tune.siege_defense) / 100.0 * float(admirals.damage_taken(x.side, x.admiral)) / 100.0 * float(tune.win_losses if wins else tune.lose_losses) / 100.0 * rng.factor(90, 110))
        if hit > full * tune.siege_max_per_day / 100:
            hit = full * tune.siege_max_per_day / 100
        int start = garrisons.start(x.goal)
        hp -= hit
        x.siege += 1
        if hp <= 0 && x.siege < tune.min_siege_days:
            hp = 1
        damage(x, back)
        if !x.alive():
            politics_siege_broken(game, x, day)
            lost(game, x, day, owner)
            garrisons.set(x.goal, hp if hp > 0 else 1, day)
            continue
        if hp <= 0:
            int days = day - start + 1 if start >= 0 else x.siege
            capture(game, x, w, day, days)
        else:
            garrisons.set(x.goal, hp, day)

void capture(es.Game game, Flotilla x, War w, int day, int siege_days):
    int i = x.goal
    world.stat("timed sieges", 1)
    world.stat("siege days", siege_days)
    politics.capture(game, i, x.side, w, day, full_strength(game, i), siege_days)
    admirals.add_win(x.side, x.admiral)
    rivals.promoted(game, x.side, x.admiral, day)
    x.siege = 0

// ---- Raids at their stops ----

void raids(es.Game game, int day):
    for x in world.fleets:
        if !x.alive() || x.kind != 2:
            continue
        []int r = x.route()
        if x.leg < 1 || x.leg > r.len() || x.at != r[x.leg - 1]:
            continue
        int stop = x.at
        int owner = galaxy.owner(stop)
        if x.plan == 0:
            bool methodical = admirals.personality(x.side, x.admiral) == 3
            x.plan = tune.raid_max_dwell if methodical else rng.range(1, tune.raid_max_dwell)
            x.dwell = 0
            if factions.is_major(owner):
                alert(game, day, x, stop, owner)
        bool opposed = false
        for y in world.fleets:
            if y.alive() && y.at == stop && y.side != x.side:
                opposed = true
        x.dwell += 1
        if opposed || owner == 0 || owner == factions.pirates():
            continue
        int full = full_strength(game, stop)
        int hp = garrisons.hp(stop, full)
        int hit = int(score(game, x) * float(tune.plunder_rate) / 100.0 * float(admirals.siege(x.side, x.admiral)) / 100.0)
        hp -= hit
        if hp < 1:
            hp = 1
        garrisons.set(stop, hp, day)
        world.stat("plunder days", 1)
        int m = galaxy.minor(stop)
        if m >= 0:
            world.neglect[m] += tune.neglect_per_plunder * 10
        if galaxy.name(stop) == game.here():
            game.message("Pirates under " + led_by(x) + " are raiding this system.")

// The raid reached major f's system: f decides, once per raid, whether to send relief.
void alert(es.Game game, int day, Flotilla raid, int stop, int f):
    int bit = 1 << f
    if (raid.alerted / bit) % 2 == 1:
        return
    raid.alerted += bit
    if politics.player == f:
        game.message("Pirates under " + led_by(raid) + " are raiding " + galaxy.name(stop) + ", in " + factions.name(f) + "'s space.")
    for y in world.fleets:
        if y.alive() && y.side == f && y.kind == 1 && y.target == raid.id:
            return
    int chance = tune.relief_chance_war if world.at_war(f) else tune.relief_chance
    if !rng.chance(chance) || !ai_room(f):
        return
    int start = nearest_owned(f, stop, stop)
    if start < 0:
        return
    Flotilla x = commission(f, 0, 1, raid.size, flotilla_strength(game, f, raid.size), start, day)
    x.target = raid.id
    x.goal = stop
    world.stat("reliefs", 1)
    if politics.player == f || tune.verbose:
        game.message(factions.title(f) + " sends " + led_by(x) + " with a " + factions.sizes[x.size] + " flotilla from " + galaxy.name(start) + " to hunt the raiders.")

// ---- Homecomings and recovery ----

void homecomings():
    for x in world.fleets:
        if !x.alive():
            continue
        if x.kind == 3 && x.at == x.home:
            world.stat("returned home", 1)
            x.strength = 0
        else if x.kind == 2 && x.leg > x.route().len() && x.at == x.home:
            admirals.add_win(x.side, x.admiral)
            world.stat("raids completed", 1)
            x.strength = 0

// Garrisons not besieged today recover (faster while consolidating); whole ones are forgotten.
void recover(es.Game game, int day):
    for g in world.garrisons.copy():
        int i = g[0]
        if g[3] >= day:
            continue
        int full = full_strength(game, i)
        int k = world.capture_index(i)
        int rate = tune.fresh_recovery if k >= 0 && day - world.captures[k][3] < tune.consolidation_days else tune.garrison_recovery
        int value = g[1] + full * rate / 100
        if value >= full:
            garrisons.release(i)
        else:
            g[1] = value
