// The price, or 0 when the system has no market for it.
int base(string system, string commodity):
    if prices.len() == 0:
        for r in rows:
            []string f = r.split("|")
            prices[f[0] + "|" + f[1]] = f[2].to_int()
    return prices.get(system + "|" + commodity, 0)

