class Tuning

// Every number the diplomacy simulation is tuned by, in one place. Strengths
// are in "points": a small flotilla is about 70, a large one about 250. Days are
// game days. Chances are per day, in percent.
//
// DadoScript has no class constants yet, so these are fields of one shared
// instance (Diplomacy.tune).

// ---- Wars ----
// Several wars may run at once: at most max_wars, and a rebellion or a
// defection (which cannot wait) may take one more, up to hard_max_wars. A new
// war (other than those) is declared at most once every declare_gap_min..max days.
int max_wars = 3
int hard_max_wars = 4
int declare_gap_min = 8
int declare_gap_max = 20
// Days after activation before the first war, which always involves the
// player's faction (the Free Worlds for a campaign veteran): the border crisis.
int first_war_min = 10
int first_war_max = 20
// Each pair of factions has a war pressure: a chance per day, in hundredths of
// a percent, that it declares war if a slot is free. Each minor two majors
// both hold part of adds split_pressure, growing by half again for every
// split_growth_days the split has gone without a war, up to split_max_growth
// times; each minor a major claims (its own by default, held by the other, on
// its border) adds claim_pressure; each whole minor of the other's on its
// border adds whole_pressure. A rebel faction holding a minor a major claims
// adds reclaim_pressure for that major. A grudge raises it by grudge points / 20.
int split_pressure = 40
int split_growth_days = 120
int split_max_growth = 3
int claim_pressure = 12
// A side that lost systems of a minor claims it for this many days.
int claim_days = 1500
int whole_pressure = 4
// A major already at war and tiring (exhaustion over opportunity_exhaustion
// percent) invites its other neighbours: each whole minor of its on their
// border adds opportunity_pressure instead of whole_pressure.
int opportunity_pressure = 40
int opportunity_exhaustion = 20
int reclaim_pressure = 45
int opportunist_pressure = 3
// A faction whose member has seen no war of their own for this many days gets
// its pressures multiplied by peace_boost (so a player always has something
// going on), and none is declared against a faction already in
// faction_war_limit wars.
int quiet_days = 45
int peace_boost = 4
int faction_war_limit = 2
// After a peace, the pair keeps a truce of truce_min_days..truce_max_days.
int truce_min_days = 25
int truce_max_days = 70
// A rebel faction that held out gets a longer truce: its independence is recognised.
int independence_truce_min = 200
int independence_truce_max = 400
// A border crisis (a limited war: one goal, no counter-goal) lasts
// crisis_min..crisis_max days; a war war_min..war_max; a rebellion or a
// defection war rebellion_min..rebellion_max.
int crisis_min_days = 25
int crisis_max_days = 45
int war_min_days = 40
int war_max_days = 90
int rebellion_min_days = 60
int rebellion_max_days = 120
// While "free worlds reconciliation" is set, wars in the first
// reconciliation_days after activation are border crises.
int reconciliation_days = 300
// Score: per goal system taken, per core system taken, per flotilla destroyed,
// per siege broken. A side ends a war at once at exhaustion 100, or wins a
// crisis outright at a score of crisis_decisive.
int score_capture = 8
int score_core = 20
int score_flotilla = 4
int score_relief = 3
int crisis_decisive = 30
// Peace terms: a side whose score is at least win_score is the winner; one at
// overwhelming_score keeps even the core systems it took. A winner holding
// cession_share percent of a goal minor's systems (of those the two hold) is
// ceded the rest of it.
int win_score = 15
int overwhelming_score = 60
int cession_share = 60
// Exhaustion, in tenths: per day at war, per flotilla lost, per system lost,
// per core system lost.
int exhaustion_day = 6
int exhaustion_flotilla = 50
int exhaustion_system = 50
int exhaustion_core = 150
// Grudge points per system lost in a war; they decay by one every grudge_decay days.
int grudge_per_system = 6
int grudge_decay = 15
// A freshly captured system: its garrison starts at capture_hp percent and
// stands at consolidation percent of full for consolidation_days, recovering
// fresh_recovery percent a day. After swap_days without a siege its patrols
// become the new owner's (the old owner's patrol fleets are swapped out).
int capture_hp = 60
int consolidation = 150
int consolidation_days = 20
int fresh_recovery = 15
int swap_days = 10
// Patrol fleets put in a captured system, as "add fleet <name> <period>".
int small_patrol_period = 1800
int large_patrol_period = 4500
// Flotilla targets: systems in the war's goals first; an objective outside
// them counts this many jumps farther.
int off_goal_penalty = 4

// ---- Minors: unrest, rebellion and defection ----
// Unrest (0..100, kept in tenths) drifts each day toward a target, by
// unrest_drift percent of the gap. The target: unrest_base, plus
// unrest_per_jump per jump from the owner's capital past unrest_free_jumps,
// plus foreign_rule if the owner is not the minor's default parent, plus
// split_unrest if another side holds part of it, plus war_unrest per war the
// owner fights and its worst war's exhaustion / war_weariness, plus the
// owner's defeats and core shock, plus the minor's neglect (unopposed raids).
int unrest_drift = 3
int unrest_base = 8
int unrest_per_jump = 2
int unrest_free_jumps = 3
int foreign_rule = 22
int split_unrest = 8
int war_unrest = 4
int war_weariness = 50
// Defeat points per war lost and per system lost (decay 1 a day); core shock
// per core system lost (decays 1 every 2 days); neglect per plunder day (decays
// 1 a day, and never above neglect_cap).
int defeat_per_war = 20
int defeat_per_system = 5
int core_shock = 25
int neglect_per_plunder = 3
int neglect_cap = 20
// Above rebellion_unrest a minor may rebel: a chance per day of
// (unrest - rebellion_unrest)^2 / rebellion_divisor percent, at most once in
// rebellion_cooldown days per minor.
int rebellion_unrest = 40
int rebellion_divisor = 400
int rebellion_cooldown = 600
// And at most one rising against a side in rising_gap days (M2: no cascades).
int rising_gap = 240
// A major holding under rally_below percent of its default minors' systems
// rallies: garrisons at rally_garrison percent, no risings, no opportunist wars on it.
int rally_below = 60
int rally_garrison = 150
// A war on a side that rallies ends once it has run rally_peace_days, and its captures from that side count half.
int rally_peace_days = 30
// Weights (percent) for how a rebellion goes: separatist, or defection to a
// bordering major (more if it is the minor's default parent, or already holds
// part of it; less if it is at war twice already).
int separatist_weight = 100
int defect_weight = 40
int defect_home_bonus = 60
int defect_split_bonus = 30
// A separatist faction losing its war (exhaustion above protection_exhaustion)
// asks a bordering major for protection with this chance per day (percent x 10).
int protection_exhaustion = 60
int protection_chance = 15
// Rebels' flotillas: at most rebel_flotillas at once, at rebel_strength percent
// of their parent's sizes; a rebel system's garrison holds at rebel_garrison percent.
int rebel_flotillas = 2
int rebel_strength = 70
int rebel_garrison = 80

// ---- The chronicle and the War Room ----
int chronicle_cap = 60
int history_every = 10
int history_cap = 120
int medals_cap = 40

// ---- Operations (jobs from the live war) ----
int ops_per_landing = 3
int ops_tracked = 24
// An operation's job has ops_deadline days; its track is kept that long and
// ops_margin more after its last offer (always while the job is taken).
int ops_deadline = 20
int ops_margin = 25
int ops_range = 4

// ---- Flotillas ----
// Flotillas per faction: at most this many at once (all its wars together),
// and at most per_war in any one war.
int max_flotillas = 4
int per_war = 3
// Chance per day that a faction at war launches a flotilla into a free slot.
int launch_chance = 30
// Strength of a new flotilla of each size (1 small, 2 medium, 3 large).
int small_strength = 70
int medium_strength = 140
int large_strength = 250
// Chance (percent) of each size at launch: small, medium, else large.
int small_odds = 40
int medium_odds = 35
// Objectives are drawn from the nearest this many capturable systems.
int objective_choices = 4
// A flotilla weaker than this is destroyed (scattered).
int destroy_below = 20

// ---- Battles between flotillas ----
// Each side loses this percentage of the other side's strength per day,
// times a random factor of 75%..125%.
int battle_rate = 35

// ---- Sieges ----
// A garrison's full strength: base + defense fleet value / unit, capped.
int garrison_base = 140
int garrison_unit = 1000000
int garrison_cap = 260
// Per day, the garrison loses siege_attack% of the besiegers' strength and the
// besiegers lose siege_defense% of the garrison's, times a random factor.
int siege_attack = 18
int siege_defense = 6
// A garrison never loses more than this percent of its full strength in a day,
// so a siege always takes a few days, whoever brings how much.
int siege_max_per_day = 40
// And no system falls before its besiegers have spent this many days at it,
// even one whose garrison raids have already worn down.
int min_siege_days = 2
// A garrison not under siege recovers this percentage of its full strength per day.
int garrison_recovery = 10
// Damaged garrisons kept at once (the least recently besieged is forgotten).
int garrison_slots = 24

// ---- In person ----
// Points a spawned fleet stands for: a "Large <faction>" and a "Small <faction>".
int large_fleet_points = 100
int small_fleet_points = 40
// At most this many fleets per flotilla, and defense fleets per garrison.
int max_spawn_fleets = 6
int max_defense_fleets = 4
// Engine steps between syncs of what the player sees with the simulation.
int sync_steps = 60

// ---- The player ----
// Merit per enemy ship destroyed or disabled; merit lost per own ship.
int merit_per_kill = 1
int merit_per_friendly_kill = 3
// Daily salary by rank, Recruit to Admiral: a curve, not a straight line.
// Commodore matches the 8,900 a day the Free Worlds pay at the end of their
// campaign, the rank a campaign veteran joins them at.
[]int salaries = [200, 600, 1800, 3600, 6000, 8900, 12000, 15500, 19000]
// The rank (5 Commodore) a pilot who finished the Free Worlds campaign holds
// in the Free Worlds when they turn Diplomacy on.
int veteran_rank = 5
// Reputation with the flotilla governments.
float rep_own = 10.0
float rep_enemy = -10.0
float rep_neutral = 1.0
// A member's standing with its faction's own government (the one that owns its
// worlds, not its flotillas') is kept at least this high, so every world of the
// faction lets the member land: Earth asks for 2, Hermes 10, Arachne and Huginn
// Stations 20, Alexandria, Pilot and Carbuncle Station 100. What this adds is
// taken back on leaving (Service.keep_standing).
float rep_member = 100.0
// The colour ("r g b") a member's faction's worlds take on the map while a
// member: its government's colour. The faction's own comes back on leaving.
string member_color = "1 0.35 0.85"

// ---- Commanders ----
// Each side (the three factions and the pirates) keeps this many named
// commanders; a flotilla or raid is led by one who is free.
int admirals_per_side = 5
// Chance (percent) that a commander dies when their flotilla is destroyed.
int admiral_death_chance = 50
// Personalities (1 bold, 2 cautious, 3 methodical, 4 reckless), in percent:
// how hard their side hits, and how much damage it takes.
int bold_attack = 120
int reckless_attack = 135
int cautious_damage = 80
int reckless_damage = 125
// Methodical commanders press sieges (and pirate plunder) this much harder.
int methodical_siege = 130
// A cautious commander turns for home below this percent of their starting strength.
int cautious_retreat = 40
// A bold commander chases enemies up to this many jumps farther than its objective.
int bold_reach = 2

// ---- Sim score ----
// Battles and sieges roll a winner each day with odds score_a : score_b. A
// side's score is its strength times its quality (from its fleets' hull,
// shields, damage per second and speed; an average fleet is 1.0) times its
// commander's personality. The day's winner takes win_losses% of the usual
// losses and the loser lose_losses%.
int win_losses = 60
int lose_losses = 140
// Speed counts this much: quality is scaled by (speed / average speed) to this
// power, in percent (50 = the square root).
int speed_weight = 50
// Fleet sizes make up most of the factions' difference in ship quality: a
// faction whose fleets are weaker per strength point fields bigger flotillas,
// enough to reach this percent of the best faction's power, so the best (the
// Republic, with the base game's fleets) keeps an edge. Never more than
// max_fleet_scale percent of the usual size, and never smaller than usual.
int balance_target = 85
int max_fleet_scale = 250

// ---- Pirate raids ----
// Raids out at once, and the chance per day that a new one sets out.
int max_raids = 4
int raid_chance = 12
// A raid visits 2-3 inhabited faction systems within this many jumps of home,
// staying 1..raid_max_dwell days at each, then goes home.
int raid_range = 4
int raid_max_dwell = 3
// Days every flotilla (war, relief, raid, a squadron, one going home) stays in
// a system it has just jumped to before it moves on: time for the player to
// hear of it and get there.
int linger = 1
// Strength of a small, medium and large raid, and the odds of each (small, medium; else large).
int raid_small = 60
int raid_medium = 110
int raid_large = 180
int raid_small_odds = 50
int raid_medium_odds = 35
// Each day at a stop, the system's garrison loses this percent of the raid's score.
int plunder_rate = 8
// When a raid reaches a faction's system, the chance (percent) that the faction
// sends a relief flotilla after it: at peace, and while at war.
int relief_chance = 60
int relief_chance_war = 10
// A relief flotilla gives up the hunt after this many days.
int relief_days = 12
// Merit for each raider the player destroys (members only).
int merit_per_pirate_kill = 1

// ---- Debug mode ----
// Turned on by enabling the "Diplomacy Debug" plugin (tools/deploy-debug.mjs). The
// mod activates on any pilot from day 0, gives the Free Worlds their wartime
// territory if they hold none yet, keeps the Republic and the Free Worlds at
// war, launches a flotilla whenever a slot is free, and messages each launch
// and siege so there is always something to watch. Once per pilot it also
// reveals the whole map and adds debug_credits to the account.
string debug_plugin = "Diplomacy Debug"
int debug_launch_chance = 100
int debug_truce_days = 3
int debug_raid_chance = 60
// Credits given once per pilot in debug mode.
int debug_credits = 100000000
// Set while debug mode is on: message launches and sieges.
bool verbose = false

// ---- M2: command and consequence ----

// The player's squadrons: how many a member commands at each rank (Recruit
// to the highest), taken from their faction's flotilla places.
[]int squadrons_by_rank = [0, 0, 0, 0, 0, 1, 2, 2, 3]
// A squadron's strength: a medium flotilla's (scaled for ship quality), plus
// one point per squadron_credits credits of the player's own fleet's value, at
// most squadron_fleet_cap points; and squadron_presence percent while the
// player is in its system.
int squadron_credits = 50000
int squadron_fleet_cap = 200
int squadron_presence = 130
// Losing a squadron costs this much merit.
int squadron_loss_merit = 15
int squadron_loss_standing = 5
// No new squadron for squadron_cooldown days after one is lost.
int squadron_cooldown = 30
// A ship of the player's counts at squadron_value percent of a new one's price.
int squadron_value = 50

// Rivals: an enemy commander's history with the player grows by history_battle
// per day of battle with the player's squadron or with the player there, and
// by history_kill per ship of theirs the player destroys. Past rival_threshold
// they become the player's rival (one at a time per side, at most max_rivals).
int history_battle = 3
int history_kill = 1
int rival_threshold = 12
int max_rivals = 2
// Rival traits: grudge (attack on the player's squadron), learned tactics
// (damage taken from it), veteran (attack), siege engineer (sieges), ambusher
// (how much farther it chases the player's squadron).
int grudge_bonus = 125
int learned_tactics = 80
int veteran_bonus = 115
int siege_engineer_bonus = 135
int ambusher_reach = 4
int rival_reach = 6

// Fog of war: enemy forces show within visibility_range jumps of the player's
// faction's systems or flotillas (2 of the player's own system for a pilot
// serving no one), or in systems scouted in the last scout_days days; a last
// sighting is drawn as a faded label for sighting_days.
int visibility_range = 1
int scout_days = 10
int sighting_days = 20

// Supply: a flotilla within supply_free jumps of one of its side's depots (an
// inhabited system it holds whose depot is not raided) fights at full
// strength; each jump farther takes supply_per_jump percent, down to
// supply_floor. A raided depot is out for depot_raid_days.
int supply_free = 2
int supply_per_jump = 8
int supply_floor = 70
int depot_raid_days = 20

// Occupation: a capture adds capture_damage damage and occupation unrest
// (occupation_unrest, or occupation_unrest_home in a system of the occupier's
// own default minor). Unrest falls unrest_fall a day (tenths), damage
// damage_fall; a garrison stands at 100 - unrest / 2 percent. Damage tiers
// (every damage_tier points) raise the price of each damaged_goods commodity by
// damage_price percent a tier, and trim shipyard and outfitter stock.
int capture_damage = 30
int occupation_unrest = 60
int occupation_unrest_home = 25
int unrest_fall = 5
// A minor's unrest target rises by its systems' average occupation unrest / 10, at most this.
int occupation_minor_cap = 4
int damage_fall = 2
int damage_tier = 30
int damage_price = 12
// Prices held back (a Corporations crisis) or moved by others are checked every resync_days.
int resync_days = 5
// (Mod API 10.) Munitions a damaged outfitter runs short of: damaged_outfit_count at tier 1, none from tier 2.
[]string damaged_outfits = ["Meteor Missile", "Sidewinder Missile", "Javelin", "Heavy Rocket", "Torpedo"]
int damaged_outfit_count = 10
[]string damaged_goods = ["Food", "Medical", "Clothing"]
// Jobs: suppressing (or backing) resistance moves unrest by resistance_effect,
// refugees lower it by refugee_effect, reconstruction lowers damage by
// rebuild_effect.
int resistance_effect = 30
int refugee_effect = 10
int rebuild_effect = 25

// The Corporations link (mod API 10's bus): a warship tender delivered to a
// government sends its next flotilla out at tender_boost percent, at most once
// in tender_gap days; a failed one sends its next flotilla out at
// tender_penalty percent; a bankruptcy is a profiteering scandal
// (scandal_unrest defeat points for each major at war).
int tender_gap = 60
int tender_boost = 125
int tender_penalty = 75
int scandal_unrest = 6
// Corporations' crises: prices it raised stay its own this many days past the
// crisis's end; at most reserved_cap (system, commodity) entries.
int crisis_margin = 5
// Corporations M3's shortfall (the share of a side's military shelves left
// empty, 0-100) takes shortfall * shortfall_weight / 100 percent off the side's
// new flotillas.
int shortfall_weight = 40
int reserved_cap = 120
string corporations_plugin = "Corporations"

