[]string quirks = ["{F} collects antique flight manuals.", "{F} keeps a potted plant from {P} on every workbench.", "{F} sings, loudly and badly, at the pit-lane karaoke.", "{F} owns a lucky pair of socks, and several hundred unlucky ones.", "{F} once got lost in the {C} paddock for a whole day.", "{F} writes letters home every race week, on paper.", "{F} is learning to cook, and practises on the team.", "{F} plays a fierce game of chess and a terrible game of cards.", "{F} has a cat named after a bulk freighter.", "{F} reads old Earth poetry between sessions.", "{F} has strong opinions about spaceport coffee.", "{F} keeps a scrapbook of every news item that misspells {F}'s name.", "{F} swears that ships have moods.", "{F} spends the off-season fishing on a world nobody can pronounce.", "{F} is saving for a ship of {F}'s own: a small one, but fast.", "{F} has never been seen without a jacket from the {C}.", "{F} is an amateur astronomer, which in a racing paddock draws a lot of jokes.", "{F} talks to the ship before every race. The ship has not answered yet.", "{F} owes a great many people a drink, and knows exactly how many.", "{F} has a twin, also in racing, and they do not speak.", "{F} grows chili peppers in the hold and shares them as a test of character.", "{F} has read every rulebook the league has published, including the withdrawn ones.", "{F} still sends money home to {P} every month.", "{F} has a tattoo of the {C} track map, slightly out of date."]
