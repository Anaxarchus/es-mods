string person(Rng rng):
    return first_names[rng.range(0, first_names.len() - 1)] + " " + last_names[rng.range(0, last_names.len() - 1)]

string team(Rng rng, []string used):
    for attempt in 0..<80:
        string n = team_first[rng.range(0, team_first.len() - 1)] + " " + team_second[rng.range(0, team_second.len() - 1)]
        if !used.contains(n):
            return n
    int k = 2
    string base = team_first[rng.range(0, team_first.len() - 1)] + " Racing"
    for used.contains(base + " " + string(k)):
        k += 1
    return base + " " + string(k)

string ordinal_suffix(int n):
    int t = n % 100
    if t >= 11 && t <= 13:
        return "th"
    int u = n % 10
    if u == 1:
        return "st"
    if u == 2:
        return "nd"
    if u == 3:
        return "rd"
    return "th"

// Text safe in a saved line: no field or record separators.
string clean(string s):
    return s.replace_all("|", "/").replace_all("\n", " ").replace_all("\t", " ").replace_all("~", "-").replace_all(";", ",").replace_all("^", " ")
