class Tuning

// Every number and name The Shoal's run is tuned by, in one place (DESIGN.md,
// sections 9 and 22). DadoScript has no class constants, so these are fields
// of one shared instance (Shoal.tune). The Deep's map and what each depth
// tier holds are in Deep (generated by tools/deep/gen.py).

// ---- Places and materials ----
// Breakers' Rest, the entry system: its true name (kept from before 0.5.0);
// the map and the player see `system_name`. Runs happen past its black hole,
// in the Deep.
string system = "~The Shoal"
string system_name = "Breakers' Rest"
string outpost = "Breaker's Rest"
string glass = "Shoal Glass"
string cores = "Warden Core"
string lattice = "Deep Lattice"
// The materials as the run summary names them: one, and more than one.
[]string material_one = ["Shoal Glass", "Warden Core", "Deep Lattice"]
[]string material_many = ["Shoal Glass", "Warden Cores", "Deep Lattice"]
// The model whose sinking counts as an Undertow beaten.
string boss_model = "The Undertow"

// ---- Heat ----
// Per second: rate = current multiplier x (base + min(greed_cap, greed x greed_rate)),
// where greed = glass + core_weight x cores + lattice_weight x lattice in cargo.
float base_rate = 1.0 / 6.0
float greed_rate = 0.0015
float greed_cap = 0.5
int core_weight = 8
int lattice_weight = 40
// Heat for each guardian the player disables or destroys.
float kill_heat = 2.0
// Heat the Shoal forgets a day between runs: a run starts at the last run's
// heat less this a day since, never below 0.
float decay_per_day = 8.0

// ---- A deep system's wrecks: placed once a run, on its first second in flight ----
// (which fleets, by depth tier: Deep.seed_wrecks); their tags start with
// wreck_tag. Wardens that keep a system (Deep.residents) are placed on every
// arrival, tagged resident_tag + n + ".", and count as guardians.
string seed_tag = "shoal.wreck.seed."
string resident_tag = "shoal.resident."

// ---- Guards that outlast a landing or follow the player ----
string recall_text = "They were waiting for you."
string greet_text = "The Shoal remembers you."
string follow_text = "They follow you down."
// Landing at Breakers' Haven: the guards afloat lose the player's trail.
string haven_text = "You go to ground at Breakers' Haven. Out in the water, the wardens lose your trail."

// ---- Breakers' Rest, outside a run (DESIGN.md section 22) ----
// A few derelicts and many restless wrecks lie in the belt. They are placed on
// the first second in flight after arriving, from a stock that refills only
// while the player is away (days since last seen there), so landing and taking
// off again places nothing new.
string rest_wreck_fleet = "Shoal Rest Wrecks"
string rest_restless_fleet = "Shoal Rest Restless"
float rest_wreck_max = 3.0
float rest_wreck_regen = 0.4
float rest_restless_max = 4.0
float rest_restless_regen = 1.0
string rest_tag = "shoal.wreck.rest."
// Now and then (this chance on an arrival from elsewhere) a warden picket
// visits, between these many seconds after the player arrives.
float visit_chance = 0.12
int visit_after = 60
int visit_spread = 90
string visit_fleet = "Shoal Warden Pickets"
string visit_tag = "shoal.visit."
string visit_text = "A pale shape slips out of the Maw and turns towards you."

// ---- Waves (DESIGN.md, "Waves") ----
// Each fires once per run when heat first reaches its threshold, at most one a second.
[]int wave_heat = [10, 12, 25, 38, 50, 62, 72, 84, 92]
[][]string wave_guards = [[], ["Shoal Warden Pickets"], ["Shoal Warden Hunters"], ["Shoal Warden Pickets", "Shoal Warden Pickets"], ["Shoal Warden Phalanx"], ["Shoal Warden Hunters", "Shoal Warden Pickets"], ["Shoal Warden Phalanx"], ["Shoal Warden Hunters", "Shoal Warden Hunters"], ["Shoal Warden Phalanx", "Shoal Warden Hunters"]]
[][]string wave_wrecks = [[], [], [], [], ["Shoal Rich Wrecks"], [], ["Shoal Deep Wreck"], [], []]
[]string wave_text = ["The rocks of the Shoal tick and groan around you. Something has noticed.", "Pale shapes slip out from between the rocks.", "The belt's wardens are hunting.", "More of them now, quick and silent.", "The stirring cracks the ice: drowned hulls tumble free of the belt.", "The wardens come in packs.", "Something deep surfaces among the rocks.", "The belt itself seems to close in.", "Every rock in the Shoal is watching you. Leave while you can."]
// The deep wreck surfaces with this wave, once per run.
string deep_fleet = "Shoal Deep Wreck"

// Wave fleets are kinds: Deep.fleet(kind, tier) is the current system's tier's
// fleet of that kind. The hub (tier 0) sends only one tier-1 picket fleet per
// wave, and neither the Undertow nor the endless waves.
// The Undertow wakes at boss_heat (a current may lower it), once per run.
int boss_heat = 100
string boss_fleet = "Shoal Undertow"
string boss_tag = "shoal.undertow"
string boss_text = "The Shoal heaves. The Undertow wakes."
string sunk_text = "The Undertow breaks apart and sinks back into the deep."
// What comes back of the Undertow's spawn after it is beaten and the player lands.
string escort_fleet = "Shoal Warden Pickets"

// Past endless_heat, a wave every endless_period seconds, alternating these.
int endless_heat = 100
int endless_period = 40
[]string endless_fleets = ["Shoal Warden Phalanx", "Shoal Warden Hunters"]
string endless_text = "The Shoal will not let you go."

// Tags: guardians' kills are read by these prefixes; wrecks' and visitors'
// are discarded.
string wave_tag = "shoal.wave."
string endless_tag = "shoal.endless."
string wreck_tag = "shoal.wreck."
[]string kill_prefixes = ["shoal.wave", "shoal.endless", "shoal.undertow", "shoal.resident"]
// Restless wrecks' kills count only once they woke (per tag, restless_tag + n).

// ---- Currents (weekly) ----
[]string current_names = ["Slack Water", "Spring Tide", "Riptide", "Dead Calm"]
[]float current_mult = [0.8, 1.0, 1.2, 1.0]
[]string current_text = ["The Shoal lies slack this week: the wardens are slow to wake.", "A spring tide runs through the Shoal this week, and it turns up wrecks.", "A riptide runs through the Shoal this week: the wardens hunt in numbers.", "A dead calm lies over the Shoal this week. Something below is restless."]
// Spring Tide: an extra rich wreck field with this wave.
int spring_heat = 25
string spring_fleet = "Shoal Rich Wrecks"
// Riptide: every guardian wave brings one more of these.
string riptide_fleet = "Shoal Warden Pickets"
// Dead Calm: the Undertow wakes here instead.
int calm_boss_heat = 85

// ---- Restless wrecks (mod API 11: ship_reactivate, ship_distance) ----
// Placed with a deep system's wrecks (Deep.seed_restless) and at Breakers'
// Rest, and one more as heat first reaches each of these; each spawn is tagged
// restless_tag + n + "." (n counting from 1 on each arrival in a system).
string restless_fleet = "Shoal Restless Wrecks"
string restless_tag = "shoal.restless."
[]int restless_heat = [25, 50]
// A restless wreck within this distance of the flagship is rolled for, once
// per spawn (tag): this chance, plus the extra above restless_hot heat.
float restless_range = 700.0
float restless_chance = 0.55
float restless_hot_bonus = 0.15
float restless_hot = 50.0
string restless_government = "Shoal Warden"
string restless_personality = "heroic staying"
float restless_heat_gain = 3.0
string restless_text = "The drowned hull shudders. Its reactor lights."

// ---- The Breakers' Yard (DESIGN.md, v0.3) ----
string yard_label = "Breakers' Yard"
// The planets with the yard; the refinery is only at the outpost.
[]string yard_planets = ["Breaker's Rest", "Haven", "Farpoint"]
string welcomed = "shoal: welcomed"
// The refinery: raw material, how many make one refined, and the refined outfit.
[]string raw = ["Shoal Glass", "Warden Core"]
[]string raw_many = ["Shoal Glass", "Warden Cores"]
[]int refine_ratio = [10, 3]
[]string refined = ["Refined Shoal Glass", "Refined Warden Core"]
[]string refined_many = ["Refined Shoal Glass", "Refined Warden Cores"]
// Lamprey Launcher ammunition, cast at the refinery from one Shoal Glass each.
string lamprey = "Glass Lamprey"
string lamprey_many = "Glass Lampreys"

// Marks. A mark's variant of an outfit is named base + mark_suffix + roman and
// shown as the base's display name + " Mk " + roman. Each mark scales its
// kind's headline stats (and the outfit's cost) by mark_headline, and their
// energy, heat and fuel costs by mark_drawback, always from the original
// outfit. Another mark is another column in each list.
[]string mark_roman = ["I", "II", "III"]
[]float mark_headline = [1.10, 1.22, 1.35]
[]float mark_drawback = [1.04, 1.08, 1.12]
string mark_suffix = " (Breakers Mk "

// What a mark costs: per unit of size (one unit per size_unit outfit space,
// rounded up, at least one), per upgrade, and a share of the original
// outfit's cost in credits. Rows are marks, columns are price_items.
[]string price_items = ["Refined Shoal Glass", "Refined Warden Core", "Deep Lattice"]
[]string price_items_many = ["Refined Shoal Glass", "Refined Warden Cores", "Deep Lattice"]
[][]int price_per_unit = [[2, 0, 0], [3, 1, 0], [4, 2, 0]]
[][]int price_flat = [[0, 0, 0], [0, 0, 0], [0, 0, 1]]
[]float price_credit_share = [0.05, 0.10, 0.15]
float size_unit = 20.0

// The kinds the yard upgrades, in the order an outfit is classified: the
// first that fits. A weapon is a gun or a turret by its hardpoint, and its
// headline is its damage (every type) and anti-missile strength, its costs
// its firing energy, heat and fuel (read with outfit_weapon_attribute, mod
// API 12; on an older game, from Catalog). Any other kind is recognised by
// kind_test > 0, and scales kind_headline (headline) and kind_costs
// (drawback).
[]string kinds = ["gun", "turret", "shield", "reactor", "battery", "cooling", "thruster", "steering", "afterburner", "repair", "armor"]
[][]string kind_test = [[], [], ["shield generation"], ["energy generation"], ["energy capacity"], ["cooling", "heat dissipation", "active cooling"], ["thrust"], ["turn"], ["afterburner thrust"], ["hull repair rate"], ["hull"]]
[][]string kind_headline = [[], [], ["shield generation"], ["energy generation"], ["energy capacity"], ["cooling", "active cooling", "heat dissipation"], ["thrust"], ["turn"], ["afterburner thrust"], ["hull repair rate"], ["hull"]]
[][]string kind_costs = [[], [], ["shield energy", "shield heat", "shield fuel"], ["heat generation"], [], ["cooling energy"], ["thrusting energy", "thrusting heat", "thrusting fuel"], ["turning energy", "turning heat", "turning fuel"], ["afterburner energy", "afterburner heat", "afterburner fuel"], ["hull energy", "hull heat", "hull fuel"], []]
[]string weapon_costs = ["firing energy", "firing heat", "firing fuel"]
// The weapon stats the yard reads (mod API 12) and may change, in the order
// a mark's weapon block writes them: every damage type (each "<x> damage" is
// headline), anti-missile strength (headline) and weapon_costs.
[]string weapon_keys = ["anti-missile", "burn damage", "corrosion damage", "disabled damage", "discharge damage", "disruption damage", "energy damage", "firing energy", "firing fuel", "firing heat", "fuel damage", "heat damage", "hull damage", "ion damage", "leak damage", "minable damage", "relative disabled damage", "relative energy damage", "relative fuel damage", "relative heat damage", "relative hull damage", "relative minable damage", "relative shield damage", "scrambling damage", "shield damage", "slowing damage"]
// Never upgraded: these categories, and outfits with any of these attributes above 0 (expansions, maps).
[]string refused_categories = ["Ammunition", "Licenses", "Special", "Unique", "Map"]
[]string refused_attributes = ["cargo space", "outfit space", "weapon capacity", "engine capacity", "map"]

// The Shoal's own lines upgrade along their authored marks: line + " Mk " + roman.
[]string lines = ["Tidecutter", "Riptide Turret", "Glassweave Shield", "Abyssal Cell", "Undertow Thruster", "Coralgraft Mender", "Eddy Steering", "Brine Capacitor", "Coldwater Sink", "Glimmer Point Defense", "Coral Plating", "Siltwake Afterburner", "Driftnet Ramscoop", "Lamprey Launcher"]

// ---- Words for heat, in the summary and on the map ----
// (The Shoal is <word>.)
[]int heat_steps = [25, 50, 75, 100]
[]string heat_words = ["calm", "stirring", "roused", "furious", "abyssal"]

// ---- Map ----
float r = 0.62
float g = 0.9
float b = 0.95

// The words for a run's heat.
string heat_word(float heat):
    for k in 0..<heat_steps.len():
        if heat < float(heat_steps[k]):
            return heat_words[k]
    return heat_words[heat_words.len() - 1]
